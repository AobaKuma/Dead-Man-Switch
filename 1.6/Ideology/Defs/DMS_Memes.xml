<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       指揮鏈 / Chain of command
       DMS 唯一的 meme。刻意只做一個:這個模組是軍事寫實內容包,
       不是 Ideology 擴充,做太多 meme 會跟 VIE 之類的模組打架,
       也會逼玩家為了用 DMS 的內容換掉整套信仰。

       category 預設 Normal(0),impact 必須落在 1~3。
       descriptionMaker 只有 structure meme 才是必填,這裡刻意不做
       (那是幾百行的信仰起源敘述,翻譯成本遠大於效益)。
       ============================================================ -->
  <MemeDef>
    <defName>DMS_Meme_ChainOfCommand</defName>
    <label>chain of command</label>
    <description>The unit was never stood down. Rank is real and orders travel one way.</description>
    <iconPath>UI/Faction/ArmyFavor</iconPath>
    <groupDef>Misc</groupDef>
    <impact>2</impact>
    <renderOrder>950</renderOrder>
    <requireOne>
      <li>
        <li>DMS_Formality_Strict</li>
      </li>
      <li>
        <li>DMS_Operations_Venerated</li>
        <li>DMS_Operations_Necessary</li>
      </li>
    </requireOne>
    <thingStyleCategories>
      <li>
        <category>DMS_Industrial</category>
        <priority>1</priority>
      </li>
    </thingStyleCategories>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective-&gt;regimental</li>
        <li>memeAdjective-&gt;uniformed</li>
        <li>memeAdjective-&gt;disciplined</li>
        <li>memeCreed-&gt;command</li>
        <li>memeCreed-&gt;service</li>
        <li>memeCreed-&gt;regiment</li>
        <li>memeHyphenPrefix-&gt;rank</li>
        <li>memeHyphenPrefix-&gt;drill</li>
        <li>memeConcept-&gt;duty</li>
        <li>memeConcept-&gt;discipline</li>
        <li>memeConcept-&gt;command</li>
        <li>memeConcept-&gt;rank</li>
        <li>memeConcept-&gt;orders</li>
        <li>memeLeaderNoun-&gt;commander</li>
        <li>memeLeaderNoun-&gt;colonel</li>
        <li>memeLeaderNoun-&gt;marshal</li>
        <li>memeLeaderNoun-&gt;captain</li>
        <li>memeMoralist-&gt;adjutant</li>
        <li>memeMoralist-&gt;provost</li>
        <li>memeMoralist-&gt;inspector</li>
      </rulesStrings>
    </generalRules>
  </MemeDef>

</Defs>
