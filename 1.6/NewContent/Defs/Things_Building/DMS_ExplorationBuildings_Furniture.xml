<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 設施家具：置物櫃、飲水機、長椅、空氣清淨機、水耕花盆 -->
  <ThingDef ParentName="DMS_DecorationBuildingBase" Name="DMS_FurnitureBase" Abstract="True">
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.3</Flammability>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <paintable>true</paintable>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <!-- 個人置物櫃 -->
  <ThingDef ParentName="DMS_FurnitureBase">
    <defName>DMS_Personallocker</defName>
    <label>personal locker</label>
    <description>A tall steel locker for storing personal effects. Standard issue in facility changing rooms and dormitories.</description>
    <graphicData>
      <texPath>Things/Building/DMS_Personallocker/DMS_1X1_Personallocker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <drawOffset>(0,0,0.55)</drawOffset>
      <shadowData>
        <volume>(0.75, 0.6, 0.6)</volume>
      </shadowData>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <uiIconOffset>(0, 0.15)</uiIconOffset>
    <size>(1,1)</size>
    <fillPercent>0.6</fillPercent>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>35</Mass>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <Steel>45</Steel>
    </costList>
  </ThingDef>

  <!-- 三連置物櫃 -->
  <ThingDef ParentName="DMS_FurnitureBase">
    <defName>DMS_Personallocker_Large</defName>
    <label>locker bank</label>
    <description>A bank of three steel lockers bolted together. Standard issue in facility changing rooms and dormitories.</description>
    <graphicData>
      <texPath>Things/Building/DMS_Personallocker_Large/DMS_3X1_Personallocker</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.75,3.75)</drawSize>
      <drawOffsetNorth>(0,0,0.55)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.55)</drawOffsetSouth>
      <drawOffsetEast>(0,0,0.3)</drawOffsetEast>
      <drawOffsetWest>(0,0,0.3)</drawOffsetWest>
      <shadowData>
        <volume>(2.6, 0.6, 0.6)</volume>
      </shadowData>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <uiIconOffset>(0, 0.1)</uiIconOffset>
    <size>(3,1)</size>
    <fillPercent>0.6</fillPercent>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
      <Mass>100</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
    </costList>
  </ThingDef>

  <!-- 飲水機 -->
  <ThingDef ParentName="DMS_FurnitureBase">
    <defName>DMS_Waterdispenser</defName>
    <label>water dispenser</label>
    <description>A bottled water dispenser with hot and cold taps. A small comfort in an otherwise sterile facility.</description>
    <graphicData>
      <texPath>Things/Building/DMS_Waterdispenser/DMS_1X1_Waterdispenser</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.35, 0.4, 0.3)</volume>
        <offset>(0, 0, -0.2)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <fillPercent>0.3</fillPercent>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>15</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 長椅 -->
  <ThingDef ParentName="DMS_FurnitureBase">
    <defName>DMS_Benches</defName>
    <label>waiting bench</label>
    <description>A row of three padded seats on a steel frame, of the kind found in facility corridors and waiting areas. Somewhat comfortable to sit on.</description>
    <graphicData>
      <texPath>Things/Building/DMS_Benches/DMS_3X1_Benches</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
      <drawOffsetNorth>(0,0,0.25)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.25)</drawOffsetSouth>
      <shadowData>
        <volume>(2.4, 0.3, 0.7)</volume>
        <offset>(0, 0, -0.1)</offset>
      </shadowData>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <size>(3,1)</size>
    <fillPercent>0.35</fillPercent>
    <pathCost>30</pathCost>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>40</Mass>
      <Beauty>2</Beauty>
      <Comfort>0.6</Comfort>
    </statBases>
    <costList>
      <Steel>60</Steel>
    </costList>
    <building>
      <isSittable>true</isSittable>
      <multiSittable>true</multiSittable>
    </building>
  </ThingDef>

  <!-- 空氣清淨機 -->
  <ThingDef ParentName="DMS_FurnitureBase">
    <defName>DMS_Airpurifier</defName>
    <label>air purifier</label>
    <description>A free-standing air purification unit. Its filters strip dust and contaminants out of the air, keeping the facility's rooms clean.</description>
    <graphicData>
      <texPath>Things/Building/DMS_Airpurifier/DMS_Airpurifier</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.45, 0.4, 0.35)</volume>
        <offset>(0, 0, -0.15)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <fillPercent>0.35</fillPercent>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1400</WorkToBuild>
      <Mass>18</Mass>
      <Beauty>1</Beauty>
      <Cleanliness>1</Cleanliness>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 水耕花盆 -->
  <ThingDef ParentName="DMS_FurnitureBase">
    <defName>DMS_Hydroponics_Flowerpot</defName>
    <label>hydroponic planter</label>
    <description>A self-contained hydroponic planter with its own nutrient reservoir. Grow decorative flowers here to improve the mood of people nearby.</description>
    <thingClass>Building_PlantGrower</thingClass>
    <graphicData>
      <texPath>Things/Building/DMS_Hydroponics_Flowerpot/DMS_Hydroponics_Flowerpot</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.45, 0.35, 0.3)</volume>
        <offset>(0, 0, -0.2)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <fillPercent>0.2</fillPercent>
    <fertility>1.5</fertility>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>12</Mass>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <Steel>30</Steel>
    </costList>
    <building>
      <defaultPlantToGrow>Plant_Daylily</defaultPlantToGrow>
      <sowTag>Decorative</sowTag>
    </building>
  </ThingDef>

  <!-- ==================== 家具殘骸（Ruin_Building/Furniture，Graphic_Random 隨機 A/B/C 外觀） ==================== -->

  <ThingDef ParentName="DMS_DecorationBuildingBase" Name="DMS_FurnitureDestroyedBase" Abstract="True">
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>true</rotatable>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.15</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <costList>
      <ChunkSlagSteel>1</ChunkSlagSteel>
    </costList>
  </ThingDef>

  <!-- 個人置物櫃殘骸 -->
  <ThingDef ParentName="DMS_FurnitureDestroyedBase">
    <defName>DMS_PersonallockerDestroyed</defName>
    <label>ruined personal locker</label>
    <description>A rusted-out steel locker. Its door has been forced and whatever was inside is long gone. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/Furniture/DMS_Personallocker</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(3,3)</drawSize>
      <drawOffset>(0,0,0.55)</drawOffset>
      <shadowData>
        <volume>(0.75, 0.6, 0.6)</volume>
      </shadowData>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <uiIconOffset>(0, 0.15)</uiIconOffset>
    <size>(1,1)</size>
    <fillPercent>0.6</fillPercent>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>35</Mass>
    </statBases>
  </ThingDef>

  <!-- 三連置物櫃殘骸 -->
  <ThingDef ParentName="DMS_FurnitureDestroyedBase">
    <defName>DMS_Personallocker_LargeDestroyed</defName>
    <label>ruined locker bank</label>
    <description>A bank of three rusted-out steel lockers. The doors hang open or are missing entirely, and whatever was inside is long gone. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/Furniture/DMS_Personallocker_Large</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(3.75,3.75)</drawSize>
      <drawOffsetNorth>(0,0,0.55)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.55)</drawOffsetSouth>
      <drawOffsetEast>(0,0,0.3)</drawOffsetEast>
      <drawOffsetWest>(0,0,0.3)</drawOffsetWest>
      <shadowData>
        <volume>(2.6, 0.6, 0.6)</volume>
      </shadowData>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <uiIconOffset>(0, 0.1)</uiIconOffset>
    <size>(3,1)</size>
    <fillPercent>0.6</fillPercent>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>100</Mass>
    </statBases>
    <costList>
      <ChunkSlagSteel>3</ChunkSlagSteel>
    </costList>
  </ThingDef>

  <!-- 飲水機殘骸 -->
  <ThingDef ParentName="DMS_FurnitureDestroyedBase">
    <defName>DMS_WaterdispenserDestroyed</defName>
    <label>ruined water dispenser</label>
    <description>The wreck of a water dispenser. The bottle is cracked and empty, and the taps have corroded solid. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/Furniture/DMS_Waterdispenser</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.35, 0.4, 0.3)</volume>
        <offset>(0, 0, -0.2)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <fillPercent>0.3</fillPercent>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>15</Mass>
    </statBases>
  </ThingDef>

  <!-- 長椅殘骸 -->
  <ThingDef ParentName="DMS_FurnitureDestroyedBase">
    <defName>DMS_BenchesDestroyed</defName>
    <label>ruined waiting bench</label>
    <description>A row of seats on a rusted steel frame. The padding has rotted away and the frame is bent, so nobody will be sitting here again. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/Furniture/DMS_Benches</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(4,4)</drawSize>
      <drawOffsetNorth>(0,0,0.25)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.25)</drawOffsetSouth>
      <shadowData>
        <volume>(2.4, 0.3, 0.7)</volume>
        <offset>(0, 0, -0.1)</offset>
      </shadowData>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <size>(3,1)</size>
    <fillPercent>0.35</fillPercent>
    <pathCost>30</pathCost>
    <statBases>
      <MaxHitPoints>110</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>40</Mass>
    </statBases>
    <costList>
      <ChunkSlagSteel>2</ChunkSlagSteel>
    </costList>
  </ThingDef>

  <!-- 空氣清淨機殘骸 -->
  <ThingDef ParentName="DMS_FurnitureDestroyedBase">
    <defName>DMS_AirpurifierDestroyed</defName>
    <label>ruined air purifier</label>
    <description>The wreck of an air purification unit. Its filters are clogged solid and the housing has rusted through. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/Furniture/DMS_Airpurifier</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.45, 0.4, 0.35)</volume>
        <offset>(0, 0, -0.15)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <fillPercent>0.35</fillPercent>
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <Mass>18</Mass>
    </statBases>
  </ThingDef>

  <!-- 水耕花盆殘骸 -->
  <ThingDef ParentName="DMS_FurnitureDestroyedBase">
    <defName>DMS_Hydroponics_FlowerpotDestroyed</defName>
    <label>ruined hydroponic planter</label>
    <description>A dead hydroponic planter. The nutrient reservoir dried out long ago, leaving only a crust of withered roots. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/Furniture/DMS_Hydroponics_Flowerpot</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.45, 0.35, 0.3)</volume>
        <offset>(0, 0, -0.2)</offset>
      </shadowData>
    </graphicData>
    <size>(1,1)</size>
    <fillPercent>0.2</fillPercent>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>12</Mass>
    </statBases>
  </ThingDef>

</Defs>
