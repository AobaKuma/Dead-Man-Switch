  <!-- 後勤貨櫃殘骸（DMS_LogisticContainer） -->
  <ThingDef ParentName="DMS_DecorationBuildingBase">
    <defName>DMS_LogisticContainerDestroyed</defName>
    <label>ruined logistic container</label>
    <description>A breached military cargo container. Whatever supplies it once held were looted or destroyed long ago, leaving only the torn shell. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/DMS_LogisticContainer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.5,2.5)</drawSize>
      <shadowData>
        <volume>(1.8, 0.6, 1.8)</volume>
      </shadowData>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <uiIconScale>0.75</uiIconScale>
    <pathCost>90</pathCost>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
    </statBases>
    <costList>
      <ChunkSlagSteel>3</ChunkSlagSteel>
    </costList>
  </ThingDef>

  <!-- (Shield generator) -->
  <ThingDef ParentName="DMS_DecorationBuildingBase">
    <defName>DMS_LargeShieldGeneratorDestroyed</defName>
    <label>ruined heavy shield generator</label>
    <description>A ruined ultra-class energy shield generator. It's energy coils and projection circuits have corroded beyond repair. Breaking it down yields some metal scrap.</description>
    <graphicData>
      <texPath>Things/Building/Ruin_Building/DMS_LargeShieldGenerator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(10,10)</drawSize>
      <shadowData>
        <volume>(5, 1, 5)</volume>
      </shadowData>
    </graphicData>
    <passability>Impassable</passability>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <size>(5,5)</size>
    <rotatable>false</rotatable>
    <uiIconScale>0.75</uiIconScale>
    <pathCost>90</pathCost>
    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <ChunkSlagSteel>11</ChunkSlagSteel>
    </costList>
  </ThingDef>

