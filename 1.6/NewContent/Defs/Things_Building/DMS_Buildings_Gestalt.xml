<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>DMS_GestaltEngine</defName>
		<label>central command core</label>
		<description>A command core used to coordinate large-scaled automatroid squads, it have the ability to independently command and support an entire combined combat brigade without any further assist.</description>
		<thingClass>Fortified.Building_Overseer</thingClass>
		<graphicData>
			<texPath>Things/Building/CentralCommandCore</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(5,5)</drawSize>
			<shadowData>
				<volume>(5.03,1.0,4.25)</volume>
				<offset>(0,0,-0.25)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<drawOffscreen>true</drawOffscreen><!-- To ensure command radius is always drawn -->
		<uiIconPath>Things/Building/CentralCommandCore</uiIconPath>
		<size>(5,5)</size>
		<tickerType>Normal</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<blockWind>true</blockWind>
		<castEdgeShadows>true</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<fillPercent>1</fillPercent>
		<rotatable>false</rotatable>
		<statBases>
			<MaxHitPoints>2500</MaxHitPoints>
			<WorkToBuild>80000</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Beauty>10</Beauty>
			<MechBandwidth>40</MechBandwidth>
      		<MechControlGroups>4</MechControlGroups>
      		<FFF_MechCommandRange>34.9</FFF_MechCommandRange>
		</statBases>
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>
		<costList>
			<Steel>800</Steel>
			<ComponentStamped>40</ComponentStamped>
			<ComponentTransmitter>8</ComponentTransmitter>
			<ComponentControlChip>3</ComponentControlChip>
		</costList>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>DMS_Category</designationCategory>
		<building>
			<artificialForMeditationPurposes>true</artificialForMeditationPurposes>
			<ai_chillDestination>false</ai_chillDestination>
			<destroySound>BuildingDestroyed_Metal_Big</destroySound>
			<buildingTags>
				<li>Mechanitor</li>
			</buildingTags>
		</building>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>DMS_Mechlink</li>
			<li>DMS_Occultech_GestaltEngine</li>
		</researchPrerequisites>
		<comps>
			<li Class="Fortified.CompProperties_Overseer">
				<selectOverseerIconPath>UI/Icons/DMS_SelectGestalt</selectOverseerIconPath>
			</li>
			<li Class="CompProperties_AmbientSound">
				<sound>GeothermalPlant_Ambience</sound>
				<disabledOnUnpowered>true</disabledOnUnpowered>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
          			<li>DMS_Gestalt_CommandArray</li>
          			<li>DMS_Gestalt_Transmitter</li>
        		</linkableFacilities>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>5000</basePowerConsumption>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable" />
		</comps>
	</ThingDef>

	<!-- Facilities -->

  <ThingDef ParentName="BuildingBase" Name="DMS_GestaltFacilityBase" Abstract="True">
    <fillPercent>0.5</fillPercent>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <passability>PassThroughOnly</passability>
    <designationCategory>DMS_Category</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <uiOrder>2000</uiOrder>
    <drawerType>MapMeshAndRealTime</drawerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories Inherit="False">
      <li>BuildingsMisc</li>
    </thingCategories>
    <researchPrerequisites>
      <li>DMS_Occultech_GestaltEngine</li>
    </researchPrerequisites>
    <descriptionHyperlinks>
      <ThingDef>DMS_GestaltEngine</ThingDef>
    </descriptionHyperlinks>
    <building>
      <relatedBuildCommands>
        <li>DMS_GestaltEngine</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Mechanitor</li>
      </buildingTags>
    </building>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="DMS_GestaltFacilityBase">
    <defName>DMS_Gestalt_CommandArray</defName>
    <label>command array</label>
    <description>Increases research speed when placed near hi-tech research bench and unlocks new research projects. Each research bench can only use one multi-analyzer.</description>
    <graphicData>
      <texPath>Things/Building/Misc/MultiAnalyzer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>3</drawSize>
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <Plasteel>50</Plasteel>
      <Gold>20</Gold>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Fortified.CompProperties_OverseerFacility">
        <statOffsets>
          <MechBandwidth>5</MechBandwidth>
          <MechControlGroups>1</MechControlGroups>
        </statOffsets>
        <maxSimultaneous>4</maxSimultaneous>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="DMS_GestaltFacilityBase">
    <defName>DMS_Gestalt_Transmitter</defName>
    <label>command transmitter</label>
    <description>Increases research speed when placed near hi-tech research bench and unlocks new research projects. Each research bench can only use one multi-analyzer.</description>
    <graphicData>
      <texPath>Things/Building/Misc/MultiAnalyzer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>3</drawSize>
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <Plasteel>50</Plasteel>
      <Gold>20</Gold>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Fortified.CompProperties_OverseerFacility">
        <statOffsets>
          <FFF_MechCommandRange>10</FFF_MechCommandRange>
        </statOffsets>
        <maxSimultaneous>4</maxSimultaneous>
      </li>
    </comps>
  </ThingDef>
	
</Defs>
