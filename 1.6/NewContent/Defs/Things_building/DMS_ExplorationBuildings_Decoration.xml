  <DesignatorDropdownGroupDef>
    <defName>DMS_Wreckages</defName>
    <label>Wreckages</label>
  </DesignatorDropdownGroupDef>

  <ThingDef ParentName="DMS_DecorationBuildingBase">
    <defName>DMS_Wreckage_Chunk</defName>
    <label>wreckage chunk</label>
    <description>A chunk of wreckage mangled beyond recognition. Strictly speaking, it makes decent cover. Tearing it down completely takes a while, but yields a small amount of metal scrap.</description>
    <graphicData>
      <texPath>Things/Wreckages/DerelictChunk</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(2.2,2.2)</drawSize>
      <shadowData>
        <volume>(1.7, 0.6, 1.7)</volume>
      </shadowData>
    </graphicData>
    <designatorDropdown>DMS_Wreckages</designatorDropdown>
    <uiIconScale>0.9</uiIconScale>
    <size>(2,2)</size>
    <costList>
      <Steel>50</Steel>
    </costList>
  </ThingDef>

  <ThingDef ParentName="DMS_DecorationBuildingBase">
    <defName>DMS_Wreckage_SentryGun</defName>
