<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase" Name="DMS_HoleBase" Abstract="True">
    <label>facility dormer</label>
    <description>A structure flooring with a opened hole, commonly found in underground facilities.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(7,7)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <size>(5,5)</size>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <holdsRoof>true</holdsRoof>
    <building>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <neverBuildable>true</neverBuildable>
      <isTargetable>false</isTargetable>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <deconstructible>false</deconstructible>
      <alwaysDeconstructible>false</alwaysDeconstructible>
      <isInert>false</isInert>
      <quickTargetable>false</quickTargetable>
      <ai_neverTrashThis>true</ai_neverTrashThis>
    </building>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <!-- 警報反應：收到設施警報後，機械體像原版巨坑那樣從洞裡跳出來（DMS.CompAlertEffector_HoleEmerge）。
         兵力由派系的 pawnGroupMakers 生成，點數依地圖警戒值在 pointsRange 內縮放（0% → 下限，100% → 上限）；
         派系用建築自己的，沒有就退回 DMS_Legacy。
         落地後走警報回應（DMS.LordJob_AlarmResponse）：當下走得到警報位置就前往，走不到就原地待命，
         之後每次警報重新判定；只打看得到的敵人。assaultOnEmerge 設 true 可改回直接進攻殖民地。
         Alert response: on a facility alarm, mechs leap out of the hole the way vanilla's pit gate
         works (DMS.CompAlertEffector_HoleEmerge). The squad comes from the faction's pawnGroupMakers,
         with points scaled across pointsRange by the map's alert level (0% → min, 100% → max);
         faction is the building's own, else DMS_Legacy.
         Once down they run an alarm response (DMS.LordJob_AlarmResponse): head for the alarm if it can be
         reached right then, otherwise hold in place, and re-judge on every later alarm; they only fight
         what they can see. Set assaultOnEmerge to true for the old straight assault on the colony. -->
    <receivesSignals>true</receivesSignals>
    <comps>
      <li Class="DMS.CompProperties_AlertEffector_HoleEmerge">
        <listenSignal>FFF_AlertScanner_Triggered</listenSignal>
        <triggerChance>0.3</triggerChance>
        <oneShot>false</oneShot>
        <pointsRange>150~600</pointsRange>
        <emergeDurationTicks>300</emergeDurationTicks>
        <landingRadius>2</landingRadius>
      </li>
    </comps>
  </ThingDef>

