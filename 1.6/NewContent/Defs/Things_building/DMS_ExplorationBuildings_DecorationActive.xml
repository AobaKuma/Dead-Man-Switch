<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="DMS_BuildingBase" Name="DMS_DecorationBuildingBase" Abstract="True">
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <designationCategory>FFF_DevCategory</designationCategory>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>100</Mass>
      <Flammability>0.15</Flammability>
    </statBases>
    <killedLeavings>
      <ChunkSlagSteel>1</ChunkSlagSteel>
    </killedLeavings>
    <tickerType>Never</tickerType>
    <filthLeaving>Filth_MachineBits</filthLeaving>
  </ThingDef>

  
  <!-- 小型通風裝置 -->
  <ThingDef ParentName="DMS_DecorationBuildingBase">
    <defName>DMS_Building_VentSmall</defName>
    <label>Active vent</label>
    <description>一種用於設施內通風與核生化氣體過濾的主動式通風口，透過將設施保持為正壓狀態來避免有害氣體透過氣流在設施內擴散。</description>
    <graphicData>
      <texPath>Things/Building/ActiveVent_S/building</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.75,2.25)</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <tickerType>Normal</tickerType>
    <size>(3,1)</size>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Fortified.CompProperties_EffectorRotational">
        <effecterDef>DMS_AirExhaust_Rotational</effecterDef>
        <offsetPerRotation>
          <li>(1, 0, 1.3)</li>   <!-- North -->
          <li>(1.3, 0, -1)</li>   <!-- East -->
          <li>(-1, 0, -1.3)</li>  <!-- South -->
          <li>(-1.3, 0, 0.7)</li>  <!-- West -->
        </offsetPerRotation>
      </li>
    </comps>
  </ThingDef>

  <!-- 中型通風裝置 -->
  <ThingDef ParentName="DMS_DecorationBuildingBase">
    <defName>DMS_Building_VentMedium</defName>
    <label>Active vent</label>
    <description>一種用於設施內通風與核生化氣體過濾的主動式通風口，透過將設施保持為正壓狀態來避免有害氣體透過氣流在設施內擴散。</description>
    <graphicData>
      <texPath>Things/Building/ActiveVent_M/building</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.75,2.25)</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <tickerType>Normal</tickerType>
    <size>(3,1)</size>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Fortified.CompProperties_Effector">
        <effecter>DMS_AirExhaust</effecter>
        <offset>(0,0,0.5)</offset>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusher</compClass>
        <heatPerSecond>40</heatPerSecond>
        <heatPushMaxTemperature>80</heatPushMaxTemperature>
      </li>
    </comps>
  </ThingDef>

  <EffecterDef>
    <defName>DMS_AirExhaust</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>AirPuff</fleckDef>
        <ticksBetweenMotes>30</ticksBetweenMotes>
        <spawnLocType>OnSource</spawnLocType>
        <scale>0.5~2</scale>
        <angle>30~70</angle>
        <speed>0.09~0.15</speed>
        <airTime>0.1</airTime>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>AirPuff</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <rotationRate>-10~10</rotationRate>
        <speed>0.1~0.35</speed>
        <scale>0.8~2</scale>
        <chancePerTick>0.08</chancePerTick>
        <positionOffset>(0,0,0.5)</positionOffset>
        <airTime>0.1</airTime>
      </li>
    </children>
  </EffecterDef>

  <!-- 大型通風裝置 -->
  <ThingDef ParentName="DMS_DecorationBuildingBase">
    <defName>DMS_Building_VentLarge</defName>
    <label>Active vent</label>
    <description>一種用於設施內通風與核生化氣體過濾的主動式通風口，透過將設施保持為正壓狀態來避免有害氣體透過氣流在設施內擴散。</description>
    <graphicData>
      <texPath>Things/Building/ActiveVent_L/building</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.75,2.25)</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <tickerType>Normal</tickerType>
    <size>(3,2)</size>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Fortified.CompProperties_EffectorRotational">
        <effecterDef>DMS_AirExhaust_Rotational</effecterDef>
        <offsetPerRotation>
          <li>(1, 0, 1.3)</li>   <!-- North -->
          <li>(1.3, 0, -1)</li>   <!-- East -->
          <li>(-1, 0, -1.3)</li>  <!-- South -->
          <li>(-1.3, 0, 0.7)</li>  <!-- West -->
        </offsetPerRotation>
      </li>
    </comps>
  </ThingDef>

  <EffecterDef>
    <defName>DMS_AirExhaust_Rotational</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>AirPuff</fleckDef>
        <ticksBetweenMotes>30</ticksBetweenMotes>
        <spawnLocType>OnSource</spawnLocType>
        <scale>0.5~2</scale>
        <angle>0~0</angle>
        <speed>0.09~1</speed>
        <airTime>0.5</airTime>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>AirPuff</fleckDef>
        <spawnLocType>OnSource</spawnLocType>
        <rotationRate>-10~10</rotationRate>
        <speed>0.09~1</speed>
        <scale>0.8~2</scale>
        <chancePerTick>0.08</chancePerTick>
        <positionOffset>(0,0,0.5)</positionOffset>
        <airTime>0.1</airTime>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
      </li>
    </children>
  </EffecterDef>

  <DesignatorDropdownGroupDef>
    <defName>DMS_RollingDoors</defName>
    <label>rolling doors</label>
  </DesignatorDropdownGroupDef>

  <ThingDef Name="DMS_BaseRollingDoor" ParentName="BuildingBase">
    <defName>DMS_RollingDoor_Single</defName>
    <label>rolling door</label>
    <description>a locked rolling door.</description>
    <thingClass>Fortified.Building_RollingDoor</thingClass>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/Door/RollingDoor</texPath>
      <drawOffset>(0,0,0)</drawOffset>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <uiIconPath>Things/Building/Door/RollingDoor_south</uiIconPath>
    <category>Building</category>
    <altitudeLayer>DoorMoveable</altitudeLayer>
    <designationCategory>FFF_DevCategory</designationCategory>
    <designatorDropdown>DMS_RollingDoors</designatorDropdown>
    <fillPercent>1</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <DoorOpenSpeed>0.3</DoorOpenSpeed>
    </statBases>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <rotatable>true</rotatable>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <drawerType>RealtimeOnly</drawerType>
    <building>
      <isInert>true</isInert>
      <canPlaceOverWall>true</canPlaceOverWall>
      <soundDoorOpenPowered>Door_OpenPowered</soundDoorOpenPowered>
      <soundDoorClosePowered>Door_ClosePowered</soundDoorClosePowered>
      <soundDoorOpenManual>Door_OpenManual</soundDoorOpenManual>
      <soundDoorCloseManual>Door_CloseManual</soundDoorCloseManual>
      <ai_chillDestination>false</ai_chillDestination>
      <unpoweredDoorCloseSpeedFactor>0.2</unpoweredDoorCloseSpeedFactor>
      <poweredDoorCloseSpeedFactor>0.2</poweredDoorCloseSpeedFactor>
      <paintable>true</paintable>
      <neverBuildable>true</neverBuildable>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable">
        <allowNonPlayer>true</allowNonPlayer>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_DoorLearnOpeningSpeed</li>
    </placeWorkers>
    <uiOrder>1</uiOrder>
  </ThingDef>

  <ThingDef ParentName="DMS_BaseRollingDoor">
    <defName>DMS_RollingDoor_Double</defName>
    <graphicData>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <size>(2,1)</size>
    <uiOrder>2</uiOrder>
  </ThingDef>

  <ThingDef ParentName="DMS_BaseRollingDoor">
    <defName>DMS_RollingDoor_Triple</defName>
    <graphicData>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <uiOrder>3</uiOrder>
  </ThingDef>

  <ThingDef ParentName="DMS_BaseRollingDoor">
    <defName>DMS_RollingDoor_Quadruple</defName>
    <graphicData>
      <drawSize>(4,1)</drawSize>
    </graphicData>
    <size>(4,1)</size>
    <uiOrder>4</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>DMS_LogisticContainer</defName>
    <label>logistic container</label>
    <thingClass>Fortified.Building_ListedContainer</thingClass>
    <description>A Standard issue cargo container containing supplies for military logistics.</description>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/DMS_LogisticContainer</texPath>
      <drawSize>(2.5,2.5)</drawSize>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <costList>
      <Tungsteel>40</Tungsteel>
    </costList>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
    </statBases>
    <building>
      <expandHomeArea>false</expandHomeArea>
      <claimable>true</claimable>
      <deconstructible>false</deconstructible>
      <paintable>false</paintable>
      <neverBuildable>true</neverBuildable>
    </building>
    <pathCost>90</pathCost>
    <size>(2,2)</size>
    <defaultPlacingRot>0</defaultPlacingRot>
    <designationCategory>FFF_DevCategory</designationCategory>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <inspectorTabs>
      <li>Fortified.ITab_Contents</li>
    </inspectorTabs>
    <comps>
      <li Class="Fortified.CompProperties_ListedContainer">
        <lootMaker>DMS_LogisticTerminal</lootMaker>
        <!-- Interactable -->
        <activeTicks>1</activeTicks>
        <ticksToActivate>180</ticksToActivate>
        <jobString>unlock container</jobString>
        <activateLabelString>Unlock container...</activateLabelString>
        <activateDescString>Unlock container.</activateDescString>
        <activateTexPath>UI/Commands/DMS_UnlockContainer</activateTexPath>
        <activatingString>unlocking {0}: {1}s</activatingString>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase" Name="DMS_LogisticTerminalBuildingBase">
    <defName>DMS_LogisticTerminal</defName>
    <label>logistic terminal</label>
    <description>Logistic terminal linked to cargo line below.</description>
    <thingClass>Fortified.Building_LogisticTerminal</thingClass>
    <uiIconPath>Things/Building/DMS_LogisticTerminal/DMS_LogisticTerminal_Icon</uiIconPath>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/DMS_LogisticTerminal/DMS_LogisticTerminal</texPath>
      <drawOffset>(0,0,0)</drawOffset>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <size>(4,4)</size>
    <category>Building</category>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <fillPercent>0.1</fillPercent>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <blockLight>false</blockLight>
    <drawerType>RealtimeOnly</drawerType>
    <passability>Impassable</passability>
    <designationCategory>FFF_DevCategory</designationCategory>
    <building>
      <isInert>true</isInert>
      <canPlaceOverWall>true</canPlaceOverWall>
      <ai_chillDestination>true</ai_chillDestination>
      <paintable>false</paintable>
      <!-- <targetable>false</targetable> -->
      <neverBuildable>true</neverBuildable>
    </building>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <inspectorTabs>
      <li>Fortified.ITab_Contents</li>
    </inspectorTabs>
    <comps>
      <li Class="Fortified.CompProperties_LogisticTerminal">
        <lootMaker>DMS_LogisticTerminal</lootMaker>
        <ticksTillArrivalRange>5000~10000</ticksTillArrivalRange>
        <lootPortionsRange>2~4</lootPortionsRange>
        <noLootLeftReport>No supply left</noLootLeftReport>
        <noLootLeftMessage>Logistic terminal has no supply left!</noLootLeftMessage>
        <cartArrivedMessage>Logistic terminal cart arrived!</cartArrivedMessage>
        <!-- Interactable -->
        <activeTicks>1</activeTicks>
        <ticksToActivate>180</ticksToActivate>
        <jobString>activate terminal</jobString>
        <activateLabelString>Activate terminal...</activateLabelString>
        <activateDescString>Activate terminal.</activateDescString>
        <activateTexPath>UI/Commands/DMS_ActivateLogisticTerminal</activateTexPath>
        <activatingString>activating {0}: {1}s</activatingString>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
  </ThingDef>

</Defs>