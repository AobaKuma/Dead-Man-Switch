<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 作戰管制員格蕾西亞。曲線與威脅節奏完全沿用 Cassandra，差別只在她會把
       DMS 系列的任務、事件與敵對派系往自己的頻道上挑。加權本身由
       DMS.ModExtension_StorytellerBias 提供，見下方 modExtensions。
       Operator Greysia. Her curves and threat pacing are Cassandra's; the only
       difference is that she favours DMS quests, incidents and factions. The
       weighting itself comes from DMS.ModExtension_StorytellerBias below. -->
  <StorytellerDef ParentName="BaseStoryteller">
    <defName>OperatorGreysia</defName>
    <label>Operator Greysia</label>
    <description>Greysia is the switchboard operator, the clerk and the chief secretary of a Colonial Army office, and to her your colony looks like some sort of field unit, which makes it a good place to send things. She routes every contract, supply run and security alert onto your frequency. The Colonization Forces will always be on the line, and their enemies with them.</description>
    <portraitLarge>UI/HeroArt/Storytellers/OperatorGreysia</portraitLarge>
    <portraitTiny>UI/HeroArt/Storytellers/OperatorGreysiaTiny</portraitTiny>
    <listOrder>200</listOrder>
    <modExtensions>
      <li Class="DMS.ModExtension_StorytellerBias">
        <!-- 加權來源，填 About.xml 的 packageId，Steam 版的 _steam 後綴自動處理。
             Content sources to favour, by packageId; the _steam suffix is handled. -->
        <packageIds>
          <li>Aoba.DeadManSwitch.Core</li>
          <li>Aoba.DeadManSwitch.Expedition</li>
          <li>Aoba.DeadManSwitch.AncientCorps</li>
        </packageIds>
        <!-- 隨機任務池的權重倍率。DMS 現有四個可隨機發布的任務合計 3.2 權重，
             ×3 之後大約會佔到隨機任務的兩成。
             Random quest weight multiplier. DMS currently contributes 3.2 of
             root selection weight; x3 puts it at roughly a fifth of the pool. -->
        <questSelectionWeightFactor>3</questSelectionWeightFactor>
        <!-- 隨機事件（IncidentDef）的最終挑選權重倍率。
             Multiplier on the final selection weight of DMS incidents. -->
        <incidentChanceFactor>2</incidentChanceFactor>
        <!-- 突襲派系挑選權重倍率，只作用於 favoredFactions 列出的派系。
             Raid faction weight multiplier, applied only to favoredFactions. -->
        <raidCommonalityFactor>2</raidCommonalityFactor>
        <favoredFactions>
          <li>DMS_Legacy</li>
          <li MayRequire="aoba.deadmanswitch.ancientcorps">DMS_AncientCorps</li>
        </favoredFactions>
      </li>
    </modExtensions>
    <comps>

      <!-- ==== Cassandra 的節奏 / Cassandra's pacing ==== -->

      <!-- Intro -->
      <li Class="StorytellerCompProperties_ClassicIntro"/>
      <!-- Home threats -->
      <li Class="StorytellerCompProperties_OnOffCycle">
        <category>ThreatBig</category>
        <minDaysPassed>11</minDaysPassed>
        <onDays>4.6</onDays>
        <offDays>6</offDays>
        <minSpacingDays>1.9</minSpacingDays>
        <numIncidentsRange>1~2</numIncidentsRange>
        <forceRaidEnemyBeforeDaysPassed>20</forceRaidEnemyBeforeDaysPassed>
        <disallowedTargetTags>
          <li>Map_RaidBeacon</li>
        </disallowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_ThreatsGenerator">
        <allowedTargetTags>
          <li>Map_RaidBeacon</li>
        </allowedTargetTags>
        <parms>
          <allowedThreats>Raids</allowedThreats>
          <onDays>1</onDays>
          <offDays>0.5</offDays>
          <minSpacingDays>0.04</minSpacingDays>
          <numIncidentsRange>1~2</numIncidentsRange>
          <minThreatPoints>500</minThreatPoints>
        </parms>
      </li>
      <li Class="StorytellerCompProperties_OnOffCycle">
        <category>ThreatSmall</category>
        <minDaysPassed>11</minDaysPassed>
        <onDays>4.6</onDays>
        <offDays>6</offDays>
        <numIncidentsRange>0.2~1</numIncidentsRange>
        <acceptPercentFactorPerThreatPointsCurve>
          <points>
            <li>(800, 1)</li>
            <li>(2800, 0)</li>
          </points>
        </acceptPercentFactorPerThreatPointsCurve>
      </li>
      <!-- Home misc -->
      <li Class="StorytellerCompProperties_CategoryMTB">
        <category>Misc</category>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
        <minDaysPassed>5</minDaysPassed>
        <mtbDays>4.8</mtbDays>
      </li>
      <li Class="StorytellerCompProperties_ShipChunkDrop"/>
      <li Class="StorytellerCompProperties_Disease">
        <category>DiseaseHuman</category>
        <minDaysPassed>9</minDaysPassed>
      </li>
      <li Class="StorytellerCompProperties_Disease">
        <category>DiseaseAnimal</category>
        <minDaysPassed>9</minDaysPassed>
      </li>
      <!-- Faction interaction -->
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>RaidFriendly</incident>
        <baseIncidentsPerYear>15</baseIncidentsPerYear>
        <minSpacingDays>0.4</minSpacingDays>
        <fullAlliesOnly>true</fullAlliesOnly>
        <minDanger>High</minDanger>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>TraderCaravanArrival</incident>
        <minDaysPassed>5</minDaysPassed>
        <baseIncidentsPerYear>5</baseIncidentsPerYear>
        <minSpacingDays>6</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>VisitorGroup</incident>
        <minDaysPassed>3</minDaysPassed>
        <baseIncidentsPerYear>4</baseIncidentsPerYear>
        <minSpacingDays>5</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>TravelerGroup</incident>
        <minDaysPassed>1</minDaysPassed>
        <baseIncidentsPerYear>6</baseIncidentsPerYear>
        <minSpacingDays>1</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>
      <!-- Caravan and temp map incidents -->
      <li Class="StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>Misc</category>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>ThreatSmall</category>
        <applyCaravanVisibility>true</applyCaravanVisibility>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>ThreatBig</category>
        <applyCaravanVisibility>true</applyCaravanVisibility>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>
      <!-- World quests -->
      <li Class="StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>10</onDays>
        <numIncidentsRange>1</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>3</minSpacingDays>
        <disableIfAnyModActive>
          <li>Ludeon.RimWorld.Royalty</li>
        </disableIfAnyModActive>
      </li>
      <li Class="StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>12</onDays>
        <numIncidentsRange>2</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>3</minSpacingDays>
        <enableIfAnyModActive>
          <li>Ludeon.RimWorld.Royalty</li>
        </enableIfAnyModActive>
      </li>
      <!-- World misc -->
      <li Class="StorytellerCompProperties_CategoryMTB">
        <category>Misc</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <minDaysPassed>15</minDaysPassed>
        <mtbDays>15</mtbDays>
      </li>
      <li Class="StorytellerCompProperties_OnOffCycle">
        <incident>OrbitalTraderArrival</incident>
        <onDays>7</onDays>
        <offDays>8</offDays>
        <numIncidentsRange>1</numIncidentsRange>
      </li>
      <li Class="StorytellerCompProperties_Triggered">
        <incident>StrangerInBlackJoin</incident>
        <delayTicks>180</delayTicks>
      </li>

      <!-- ==== 格蕾西亞的專屬頻道 / Greysia's own channels ==== -->

      <!-- 她自己的頻道：每個週期固定發一份 DMS 系列的任務，從上面 packageIds
           列出的模組裡按權重挑。挑不到（點數不夠、冷卻中、任務跑不動）就整個
           週期跳過，不會退回去發原版任務。這條與原版的隨機任務管道並存，所以
           DMS 任務在隨機池裡的權重加成仍然照常生效。
           Her own channel: one DMS quest per cycle, weighted among the quests
           from the packageIds listed above. If nothing is eligible the cycle is
           skipped rather than falling back to a vanilla quest. This runs
           alongside the normal random quest comps, so the random-pool weighting
           still applies on top. -->
      <li Class="DMS.StorytellerCompProperties_FavoredQuest">
        <incident>DMS_GiveQuest_Favored</incident>
        <minDaysPassed>5</minDaysPassed>
        <onDays>12</onDays>
        <offDays>0</offDays>
        <minSpacingDays>9</minSpacingDays>
        <numIncidentsRange>1</numIncidentsRange>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
      </li>

    </comps>
  </StorytellerDef>

</Defs>
