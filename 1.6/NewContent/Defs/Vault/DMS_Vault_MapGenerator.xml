<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 口袋地圖本體。只用 Core 的地形產生步驟，建築佈局由 DMS_VaultElevator 追加的
       DMS_VaultStructure 負責（見 DMS.Building_VaultElevator.GetExtraGenSteps）。
       Core-only terrain steps; the structure comes from the gen step the portal injects. -->
  <MapGeneratorDef>
    <defName>DMS_MilitaryVault</defName>
    <label>military storage vault</label>
    <isUnderground>true</isUnderground>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <!-- Underground 生物群系與 Underground_RocksFromGrid 都在 Core，不需要任何 DLC。
           Both the Underground biome and the rock grid step live in Core. -->
      <biome>Underground</biome>
      <!-- 深層恆溫機房，比地面冷得多。 -->
      <temperature>12</temperature>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
    <genSteps>
      <li>ElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>RockChunks</li>
      <!-- DMS_VaultStructure 由 DMS_VaultElevator 動態插入 / injected by the portal -->
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <!-- 取代原版 GenStep_AncientStockpile：同樣的流程，但沒有 OdysseyActive 閘門。
       Same pipeline as vanilla's, minus the Odyssey gate. -->
  <GenStepDef>
    <defName>DMS_VaultStructure</defName>
    <order>551</order>
    <genStep Class="DMS.DMS_GenStep_Vault">
      <layoutDef>DMS_MilitaryVault</layoutDef>
      <!-- 比原版儲藏庫（40~50）大一圈，才塞得下長廊、中庭與車輛庫；分區之間還要留 6 格岩層，再加大一圈。
           口袋地圖 130 見方，四周仍留得下檢修通道。
           A size up from vanilla's stockpile (40~50) so the hall, atrium and vehicle bay fit, and another size up
           for the 6-cell rock gap between sectors. The pocket map is 130 square, still leaving rock for the tunnels. -->
      <sizeRange>70~80</sizeRange>
    </genStep>
  </GenStepDef>

  <!-- ============================================================
       手工版面的地下地圖：三張「單體大空間 + 小房間」FFF_StructureDef（見 DMS_Vault_UnderMaps.xml）。
       結構步驟直接寫在 genSteps 裡，傳送門只要把 pocketMapGenerator 指到 DMS_UndergroundHall，
       不需要 ModExtension_PortalLayout。
       Hand-authored underground maps: three "one big hall + small rooms" FFF_StructureDefs
       (DMS_Vault_UnderMaps.xml). The structure step is baked into genSteps, so a portal only has to
       point pocketMapGenerator at DMS_UndergroundHall; no ModExtension_PortalLayout needed.
       ============================================================ -->
  <MapGeneratorDef>
    <defName>DMS_UndergroundHall</defName>
    <label>underground facility</label>
    <isUnderground>true</isUnderground>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <biome>Underground</biome>
      <temperature>12</temperature>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
    <genSteps>
      <li>ElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>RockChunks</li>
      <li>DMS_UndergroundHallStructure</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>DMS_UndergroundHallStructure</defName>
    <order>551</order>
    <genStep Class="DMS.DMS_GenStep_UndergroundStructure">
      <structureDefs>
        <li>DMS_UnderMap_Warehouse</li>
        <li>DMS_UnderMap_VehicleBay</li>
        <li>DMS_UnderMap_ReactorHall</li>
      </structureDefs>
      <!-- 只有這些會掛防務陣營；門、家具、貨架保持無陣營讓玩家能直接用。
           Only these get the defender faction; doors, furniture and shelving stay factionless so the player can use them. -->
      <defenderDefs>
        <li>DMS_Building_Camera</li>
        <li>DMS_Building_Scanner_Small</li>
        <li>DMS_Building_Scanner_Large</li>
        <li>DMS_Building_FPVNest</li>
        <li>DMS_MechCapsule_VaultInfantry</li>
        <li>DMS_MechCapsule_VaultAssault</li>
        <li>DMS_MechCapsule_VaultFrame</li>
        <li>DMS_MechCapsule_VaultKennel</li>
        <!-- 砲塔掛上陣營後會依自身 CompCanBeDormant_NPCChance.npcDormantChance 決定要不要休眠。
             Once it has a faction the turret rolls its own CompCanBeDormant_NPCChance.npcDormantChance. -->
        <li>DMS_Turret_Sentry</li>
      </defenderDefs>
      <initialBatteryPct>1</initialBatteryPct>
    </genStep>
  </GenStepDef>

</Defs>
