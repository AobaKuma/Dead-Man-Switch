        <pos>(5, 0, 20)</pos>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_Building_FPVHanger</def>
        <pos>(23, 0, 20)</pos>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
