<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       SAGE 節點站（DMS_SageNode）：29x23 的手工版面，由 DMS_SageNodeStructure（GenStep_FFFGarrisonedStructure）
       依 useTag 選用。主建築是一座機櫃大廳：SAGE 在正中央，兩側是成排的數據輔機，核心兩旁各一個毒氣釋放口；
       北側兩間小房放站點伺服主機、戰鬥群呼叫器與配電櫃；前院是大型哨塔、FPV 機庫與砲擊呼叫器。
       守軍由 GenStep 的 spawnDefenders 依威脅點數生成，版面不放 PawnGroup。
       電力：所有牆下鋪隱藏導線，北側配電櫃貼著北牆接入；前院的設施各自靠旁邊的配電櫃供電。

       SAGE node: a 29x23 hand-authored layout picked by DMS_SageNodeStructure (GenStep_FFFGarrisonedStructure)
       through its useTag. The main building is a rack hall: SAGE in the middle, rows of data racks on either
       side and a gas vent flanking the core; two small rooms to the north hold a site server, the battle-group
       callers and a substation; the forecourt has a large sentry tower, an FPV hangar and a fire-support uplink.
       The garrison comes from the GenStep's spawnDefenders, so there is no PawnGroup here.
       Power: hidden conduit runs under every wall and the northern substation sits against the north wall;
       the forecourt fixtures each draw from a substation beside them.

       座標慣例 / Coordinates: Rect 的 pos 是左下角；Thing 的 pos 是物件位置（3x1 的 SAGE 以中間格為準；
       2x1 的輔機朝南佔 pos-x 與 pos，朝東佔 pos-z 與 pos，朝西佔 pos 與 pos+z）。門：東西向牆用 rot 0，南北向牆用 rot 1。
       Rect pos is the lower-left corner; Thing pos is the thing's position (the 3x1 SAGE is centred on it; a 2x1
       rack covers pos-x and pos facing south, pos-z and pos facing east, pos and pos+z facing west).
       Doors: rot 0 in east-west walls, rot 1 in north-south walls.
       ============================================================ -->
  <Fortified.Structures.FFF_StructureDef>
    <defName>DMS_SageNode</defName>
    <label>SAGE node</label>
    <size>(29, 23)</size>
    <disableSuggestedRoof>True</disableSuggestedRoof>
    <elements>

      <!-- 地面 / Floors -->
      <li Class="Fortified.Structures.FFF_Element_TerrainRect">
        <def>Concrete</def>
        <pos>(0, 0, 0)</pos>
        <size>(29, 23)</size>
      </li>
      <li Class="Fortified.Structures.FFF_Element_TerrainRect">
        <def>MetalTile</def>
        <pos>(3, 0, 3)</pos>
        <size>(23, 13)</size>
      </li>

      <!-- 隱藏導線：所有牆與門的下方 / Hidden conduit under every wall and door -->
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>HiddenConduit</def>
        <pos>(2, 0, 2)</pos>
        <size>(25, 1)</size>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>HiddenConduit</def>
        <pos>(2, 0, 16)</pos>
        <size>(25, 1)</size>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>HiddenConduit</def>
        <pos>(2, 0, 3)</pos>
        <size>(1, 13)</size>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>HiddenConduit</def>
        <pos>(26, 0, 3)</pos>
        <size>(1, 13)</size>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>HiddenConduit</def>
        <pos>(3, 0, 12)</pos>
        <size>(23, 1)</size>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>HiddenConduit</def>
        <pos>(14, 0, 13)</pos>
        <size>(1, 3)</size>
      </li>

      <!-- 外牆 / Outer walls -->
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(2, 0, 2)</pos>
        <size>(12, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(15, 0, 2)</pos>
        <size>(12, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(2, 0, 16)</pos>
        <size>(6, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(9, 0, 16)</pos>
        <size>(18, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(2, 0, 3)</pos>
        <size>(1, 13)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(26, 0, 3)</pos>
        <size>(1, 13)</size>
        <stuff>Steel</stuff>
      </li>

      <!-- 大廳北牆與北側隔間 / Hall's north wall and the north partition -->
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(3, 0, 12)</pos>
        <size>(5, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(9, 0, 12)</pos>
        <size>(11, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(21, 0, 12)</pos>
        <size>(5, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(14, 0, 13)</pos>
        <size>(1, 1)</size>
        <stuff>Steel</stuff>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingRect">
        <def>Wall</def>
        <pos>(14, 0, 15)</pos>
        <size>(1, 1)</size>
        <stuff>Steel</stuff>
      </li>

      <!-- 門 / Doors -->
      <li Class="Fortified.Structures.FFF_Element_ThingScatter">
        <def>Door</def>
        <rot>0</rot>
        <stuff>Steel</stuff>
        <posList>
          <li>(14, 0, 2)</li>
          <li>(8, 0, 16)</li>
          <li>(8, 0, 12)</li>
          <li>(20, 0, 12)</li>
        </posList>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>Door</def>
        <pos>(14, 0, 14)</pos>
        <rot>1</rot>
        <stuff>Steel</stuff>
      </li>

      <!-- 屋頂 / Roof -->
      <li Class="Fortified.Structures.FFF_Element_RoofRect">
        <def>RoofConstructed</def>
        <pos>(3, 0, 3)</pos>
        <size>(23, 13)</size>
      </li>

      <!-- 機櫃大廳：SAGE 與數據輔機陣列 / Rack hall: SAGE and the data rack array -->
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_SageCore</def>
        <pos>(14, 0, 7)</pos>
        <rot>2</rot>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingScatter">
        <def>DMS_FacilityDataRack</def>
        <rot>2</rot>
        <posList>
          <!-- 北側機櫃區（兩排）/ North rack block (two rows) -->
          <li>(5, 0, 9)</li>
          <li>(7, 0, 9)</li>
          <li>(10, 0, 9)</li>
          <li>(19, 0, 9)</li>
          <li>(22, 0, 9)</li>
          <li>(24, 0, 9)</li>
          <li>(5, 0, 8)</li>
          <li>(7, 0, 8)</li>
          <li>(10, 0, 8)</li>
          <li>(19, 0, 8)</li>
          <li>(22, 0, 8)</li>
          <li>(24, 0, 8)</li>
          <!-- 南側機櫃區（兩排）/ South rack block (two rows) -->
          <li>(5, 0, 4)</li>
          <li>(7, 0, 4)</li>
          <li>(10, 0, 4)</li>
          <li>(19, 0, 4)</li>
          <li>(22, 0, 4)</li>
          <li>(24, 0, 4)</li>
          <li>(5, 0, 3)</li>
          <li>(7, 0, 3)</li>
          <li>(10, 0, 3)</li>
          <li>(19, 0, 3)</li>
          <li>(22, 0, 3)</li>
          <li>(24, 0, 3)</li>
        </posList>
      </li>
      <!-- 核心兩側的輔機，側身朝向 SAGE / Racks flanking the core, turned to face SAGE -->
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_FacilityDataRack</def>
        <pos>(12, 0, 7)</pos>
        <rot>1</rot>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_FacilityDataRack</def>
        <pos>(16, 0, 6)</pos>
        <rot>3</rot>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingScatter">
        <def>DMS_Building_GasVent</def>
        <posList>
          <li>(12, 0, 4)</li>
          <li>(16, 0, 4)</li>
        </posList>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_Building_Sensor</def>
        <pos>(14, 0, 10)</pos>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_Building_FPVNest</def>
        <pos>(3, 0, 11)</pos>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_Building_FPVNest</def>
        <pos>(25, 0, 3)</pos>
      </li>

      <!-- 北側辦公室：站點伺服主機、戰鬥群呼叫器 / North office: site server, battle-group caller -->
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_SiteServerCore</def>
        <pos>(5, 0, 14)</pos>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_Building_AlertCaller_BattleGroup</def>
        <pos>(12, 0, 15)</pos>
      </li>

      <!-- 北側警衛室：第二座戰鬥群呼叫器與配電櫃（貼著北牆接入隱藏導線）
           North guard room: the second battle-group caller and the substation (against the north wall, on the conduit) -->
      <li Class="Fortified.Structures.FFF_Element_Thing">
        <def>DMS_Building_AlertCaller_BattleGroup</def>
        <pos>(16, 0, 15)</pos>
      </li>
      <li Class="Fortified.Structures.FFF_Element_Thing">
