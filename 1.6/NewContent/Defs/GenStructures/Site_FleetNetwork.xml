          <li>(27, 0, 1)</li>
        </posList>
      </li>
      <li Class="Fortified.Structures.FFF_Element_ThingScatter">
        <def>Sandbags</def>
        <posList>
          <li>(12, 0, 0)</li>
          <li>(13, 0, 0)</li>
          <li>(15, 0, 0)</li>
          <li>(16, 0, 0)</li>
        </posList>
      </li>
    </elements>
    <tags>
      <li>DMS_SageNode</li>
    </tags>
  </Fortified.Structures.FFF_StructureDef>

</Defs>
