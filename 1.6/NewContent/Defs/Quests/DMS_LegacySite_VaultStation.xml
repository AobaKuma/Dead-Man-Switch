<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       儲存庫地面站：軍事儲存庫（DMS_MilitaryVault 口袋地圖）的地表入口。
       版面（DMS_VaultStation）放的是封板狀態的貨運電梯 DMS_VaultElevator_Sealed，
       以 FFF_Element_LinkAccessKeyWanter 連到控制室的 DMS_VaultConsole：
       駭入控制台 → 封板退開 → 換成可進入的 DMS_VaultElevator（已視為駭入）。
       這是目前唯一會在世界上放置儲存庫入口的流程。

       Vault access station: the surface entrance to the military storage vault
       (the DMS_MilitaryVault pocket map). The layout (DMS_VaultStation) places
       the sealed pad DMS_VaultElevator_Sealed, linked to the DMS_VaultConsole in
       the control room: hack the console → cover retracts → swaps to an enterable,
       pre-hacked DMS_VaultElevator. This is currently the only worldgen path that
       places a vault entrance.
       ============================================================ -->

  <SitePartDef>
    <defName>DMS_VaultStationSite</defName>
    <label>vault access station</label>
    <description>A Legacy remnant surface station built over a buried military storage vault. The freight elevator is locked under an armored cover plate; the station's security console is the only thing that can raise it.</description>
    <workerClass>Fortified.SitePartWorker_FFF_TimedHostileSite</workerClass>
    <modExtensions>
      <li Class="Fortified.FFF_TimedSiteExtension">
        <baseEntryHours>36</baseEntryHours>
        <minEntryHours>8</minEntryHours>
        <maxEntryHours>72</maxEntryHours>
        <entryLetterLabelKey>DMS_VaultStation_EntryCountdownLabel</entryLetterLabelKey>
        <entryLetterTextKey>DMS_VaultStation_EntryCountdownText</entryLetterTextKey>
      </li>
    </modExtensions>
    <!-- 世界地圖上用先鋒殘餘的陣營圖標，套陣營色。The Legacy faction icon on the world map, tinted with the faction colour. -->
    <siteTexture>UI/Faction/LegacyIcon</siteTexture>
    <expandingIconTexture>UI/Faction/LegacyIcon</expandingIconTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
    <requiresFaction>true</requiresFaction>
    <wantsThreatPoints>true</wantsThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <minThreatPoints>600</minThreatPoints>
    <considerEnteringAsAttack>true</considerEnteringAsAttack>
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <approachOrderString>Assault {0}</approachOrderString>
    <approachingReportString>Assaulting {0}.</approachingReportString>
    <arrivedLetter>You have arrived at the vault access station. A remnant garrison holds the compound.\n\nThe freight elevator is sealed under its cover plate. Hack the security console in the control room to raise it.</arrivedLetter>
    <arrivedLetterDef>NegativeEvent</arrivedLetterDef>
    <tags>
      <li>DMS_VaultStationSite</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>DMS_VaultStationStructure</defName>
    <linkWithSite>DMS_VaultStationSite</linkWithSite>
    <order>400</order>
    <genStep Class="Fortified.Structures.GenStep_FFFGarrisonedStructure">
      <useTag>DMS_VaultStation</useTag>
      <randomOffset>0~3</randomOffset>
      <filthTypes>
        <li>Filth_RubbleBuilding</li>
        <li>Filth_MachineBits</li>
        <li>Filth_Ash</li>
      </filthTypes>
      <!-- 不設 centerpiece：保底生成的封板電梯不會連到任何控制台，永遠打不開；
           版面 47x51 在站點地圖上不會被裁切。
           No centerpiece: a fallback sealed pad would have no console link and could never open;
           the 47x51 layout never gets clipped on a site map anyway. -->
      <debrisDef>ChunkSlagSteel</debrisDef>
      <debrisCount>6~12</debrisCount>
      <scatterRadius>26</scatterRadius>
      <lootMaker>MapGen_DefaultStockpile</lootMaker>
      <!-- 版面自帶的 PawnGroup 之外，再依站點威脅點數生成一支守軍（LordJob_DefendPoint），
           讓兵力隨難度縮放；[enemiesCount] 對應的就是這一支。
           On top of the layout's own PawnGroup, spawn a garrison from the site's threat points
           (LordJob_DefendPoint) so strength scales with difficulty; [enemiesCount] describes this group. -->
      <spawnDefenders>true</spawnDefenders>
      <defendRadius>20</defendRadius>
      <satelliteScatter>
        <li>
          <tag>DMS_DecoySiteEdgeRuin</tag>
          <count>1~2</count>
          <radiusPct>0.22</radiusPct>
          <minRadius>38</minRadius>
          <minSpacing>6</minSpacing>
        </li>
        <li>
          <tag>DMS_RuinSatellite</tag>
          <count>4~6</count>
          <radiusPct>0.18</radiusPct>
          <minRadius>34</minRadius>
          <minSpacing>5</minSpacing>
        </li>
        <li>
          <tag>DMS_RuinScattered</tag>
          <count>2</count>
          <radiusPct>0.32</radiusPct>
          <minRadius>46</minRadius>
          <minSpacing>6</minSpacing>
        </li>
      </satelliteScatter>
    </genStep>
  </GenStepDef>

  <!-- 任務腳本在 DMS_LegacyInstallationQuest.xml：五座設施共用一個 QuestScriptDef，隨機抽一座。
       The quest script lives in DMS_LegacyInstallationQuest.xml: one QuestScriptDef rolls one of the five installations. -->

</Defs>
