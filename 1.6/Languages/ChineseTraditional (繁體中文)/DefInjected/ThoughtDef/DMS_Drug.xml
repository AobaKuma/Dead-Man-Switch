<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: overeat -->
  <DMS_OverEat.stages.overeat.label>過食</DMS_OverEat.stages.overeat.label>
  <!-- EN: This ration tastes horrible and is making my stomach turn. I don't like it. -->
  <DMS_OverEat.stages.overeat.description>這份口糧的量對我的胃而言可能太多了...</DMS_OverEat.stages.overeat.description>
  

  <!-- EN: regrowing flesh -->
  <DMS_CombatRegenPain.stages.regrowing_flesh.label>血肉增生</DMS_CombatRegenPain.stages.regrowing_flesh.label>
  <!-- EN: Something is growing inside me. It itches, it aches, and it doesn't feel like mine. -->
  <DMS_CombatRegenPain.stages.regrowing_flesh.description>有東西正在我體內生長。又癢又痛，而且感覺不像是我自己的。</DMS_CombatRegenPain.stages.regrowing_flesh.description>
  
  <!-- EN: hollow memories -->
  <DMS_SensibilityBlockerAftermath.stages.hollow_memories.label>空洞的記憶</DMS_SensibilityBlockerAftermath.stages.hollow_memories.label>
  <!-- EN: I remember every moment of it. I just can't remember feeling anything. -->
  <DMS_SensibilityBlockerAftermath.stages.hollow_memories.description>那段時間的每一刻我都記得，只是想不起自己有過任何感受。</DMS_SensibilityBlockerAftermath.stages.hollow_memories.description>
  
</LanguageData>