          <li>DMS_Mech_FieldCommand</li>
          <li>DMS_Mech_Iguana</li>
        </supportRaceDefs>
        <targetBodyPartDefs>
          <li>MechanicalThorax</li>
          <li>DMS_HeavyChassis</li>
