  <HediffDef>
    <defName>DMS_BF_RecoillessRifle</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>Recoilless Rifle Rack</label>
    <description>A pair of 65mm recoilless tubes mounted on the side pylons and tied into the frame's fire control chain, reloaded from the frame's carried stores between engagements.\n\nThe shaped-charge warhead punches through armor and fortification that the frame's own weapon cannot touch, though the jet goes into a single narrow channel and anything standing beside the point of impact walks away. The mass hanging on the pylons costs the frame walking pace, dodging room and cargo allowance.</description>
    <descriptionHyperlinks>
      <ThingDef>DMS_BF_RecoillessRifle</ThingDef>
      <AbilityDef>DMS_BF_RecoillessShot</AbilityDef>
      <ThingDef>DMS_Mech_BattleFrame</ThingDef>
      <ThingDef>DMS_Mech_EscortLifter</ThingDef>
      <ThingDef>DMS_Mech_FieldCommand</ThingDef>
      <ThingDef>DMS_Mech_Iguana</ThingDef>
    </descriptionHyperlinks>
    <defaultLabelColor>(1, 1, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <!-- 修正: 原本寫成 DMS_BF_ExtendCargo，拆下無後座力砲掛架會退回一個加掛貨箱 -->
    <spawnThingOnRemoved>DMS_BF_RecoillessRifle</spawnThingOnRemoved>
    <stages>
      <li>
        <!-- 修正: statFactors 是乘算係數，原本的 -0.3 / -0.2 會把移速與閃避乘成負值。
             改為與其他掛架模組同級的乘算值（加掛貨箱 0.8 / 0.9、附加裝甲 0.9 / 0.9），
             本模組 10kg 且重心偏側，故兩項都取 0.8。 -->
        <statFactors>
          <MoveSpeed>0.8</MoveSpeed>
          <MeleeDodgeChance>0.8</MeleeDodgeChance>
        </statFactors>
        <statOffsets>
          <Mass>10</Mass>
          <FFF_MassCarryCapacity>-10</FFF_MassCarryCapacity>
          <CarryBulk MayRequire="ceteam.combatextended">-5</CarryBulk>
          <CarryWeight MayRequire="ceteam.combatextended">-10</CarryWeight>
          <CarryingCapacity>-10</CarryingCapacity>
          <!-- 射控單元的待機耗能 -->
          <MechEnergyUsageFactor>0.05</MechEnergyUsageFactor>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="Fortified.HediffCompProperties_Modification">
        <applyJob>FFF_ModificationRemove</applyJob>
      </li>
    </comps>
    <!-- 掛載後取得的開火能力，定義見 Abilities/Common.xml -->
    <abilities>
      <li>DMS_BF_RecoillessShot</li>
    </abilities>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode</nodeClass>
        <workerClass>PawnRenderNodeWorker</workerClass>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>20</baseLayer>
        <drawSize>1.75</drawSize>
        <pawnType>Any</pawnType>
        <useGraphic>true</useGraphic>
        <texPath>Things/Modifications/RecoillessRifle/render</texPath>
        <drawData>
          <defaultData>
            <layer>20</layer>
          </defaultData>
          <dataEast>
            <offset>(0,0,0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0,-0.5,0)</offset>
          </dataWest>
          <dataNorth>
            <offset>(0,0,0)</offset>
          </dataNorth>
          <dataSouth>
            <offset>(0,0,0)</offset>
          </dataSouth>
        </drawData>
      </li>
    </renderNodeProperties>
