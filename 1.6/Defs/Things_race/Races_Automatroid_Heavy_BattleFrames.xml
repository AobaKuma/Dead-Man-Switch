        <bodyGraphicData>
          <texPath>Things/Automatroid/OldTexture/FieldCommand</texPath>
          <shaderType>CutoutComplex</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.75</drawSize>
          <color>(104, 94, 94)</color>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponTags>
      <li>DMS_MechWeaponLight</li>
      <li>Autopistol</li>
    </weaponTags>
  </PawnKindDef>

  <ThingDef ParentName="BaseBattleFrame">
    <defName>DMS_Mech_EscortLifter</defName>
    <label>Escort Lifter</label>
    <description>An early stage mass-production automatroid. It's no longer in regular service, but plenty were refitted with external cargo boxes and handling arms for logistics duty - it carries more than anything else in the battle frame line. The military hardware that came off in the conversion means it can only carry a light arm for self-defence.</description>
    <statBases>
      <MoveSpeed>4.2</MoveSpeed>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp><!--銳抗-->
      <ArmorRating_Blunt>0.18</ArmorRating_Blunt><!--鈍抗-->
      <ArmorRating_Heat>0.58</ArmorRating_Heat>  <!--能抗-->
      <AimingDelayFactor>1.3</AimingDelayFactor>
      <BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">2</BandwidthCost>
      <!-- 二線後勤機：耗損不該高於戰鬥型母體(2) -->
      <WastepacksPerRecharge MayRequire="Ludeon.Rimworld.Biotech">2</WastepacksPerRecharge>
      <!-- 外掛貨箱與搬運工具：系列中最高的載重 -->
      <CarryingCapacity>190</CarryingCapacity>
      <!-- 商隊速度加成。原版 HasCaravanBonus() 只認 Humanlike，由 Fortified 框架的
           Patch_CaravanBonusUtility_HasCaravanBonus 放寬給機體。
           小猛瑪(1.5)是專職運輸車，運輸框架定位在其之下。 -->
      <CaravanBonusSpeedFactor>1.25</CaravanBonusSpeedFactor>
    </statBases>
    <race>
      <mechEnabledWorkTypes>
        <li>Hauling</li>
        <li MayRequire="frozensnowfox.complexjobs">FSFDeliver</li>
        <li MayRequire="frozensnowfox.complexjobs">FSFCremating</li>
        <li MayRequire="frozensnowfox.complexjobs">FSFRearming</li>
      </mechEnabledWorkTypes>
      <packAnimal>true</packAnimal>
    </race>
    <modExtensions>
      <li Class="Fortified.MechWeaponExtension">
        <EnableWeaponFilter>true</EnableWeaponFilter>
        <UsableWeaponTags>
          <li>DMS_MechWeaponLight</li>
          <li>Autopistol</li>
          <li>Revolver</li>
        </UsableWeaponTags>
        <EnableTechLevelFilter>true</EnableTechLevelFilter>
        <UsableTechLevels>
          <li>Industrial</li>
        </UsableTechLevels>
        <BypassUsableWeapons />
      </li>
    </modExtensions>
    <butcherProducts>
      <Steel>26</Steel>
    </butcherProducts>
  </ThingDef>


