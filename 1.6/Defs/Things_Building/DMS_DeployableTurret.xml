	<!--
		HMG 架設後的槍身。彈種切換沿用手持版：CompAmmoSwitch 掛在槍身 Thing 上，
		FFF 的 Patch_BuildingTurretGun_GetGizmos 會把切換按鈕補到砲塔的 gizmo 列，
		因此架設後仍可切標準彈／空尖彈。
	-->
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>DMS_Gun_HeavyMachineGun</defName>
		<label>mech HMG</label>
		<description>A heavy machine gun mounted on a tripod.</description>
		<graphicData>
			<texPath>Things/Turrets/DMS_HeavyMachineGun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.75</drawSize>
		</graphicData>
		<statBases>
			<Mass>14.50</Mass>
			<Flammability>0</Flammability>
			<AccuracyTouch>0.70</AccuracyTouch>
			<AccuracyShort>0.75</AccuracyShort>
			<AccuracyMedium>0.90</AccuracyMedium>
			<AccuracyLong>0.80</AccuracyLong>
			<RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
		</statBases>
		<!-- 彈種切換: 標準機槍彈(預設) / 空尖彈(短射程高射速壓制) -->
		<comps>
			<li Class="Fortified.CompProperties_AmmoSwitch">
				<defaultIndex>0</defaultIndex>
				<switchCooldown>240</switchCooldown>
				<soundSwitch>Artillery_ShellLoaded</soundSwitch>
				<ammos>
					<li>
						<projectileDef>Bullet_DMS_HeavyMachineGun</projectileDef>
					</li>
					<li>
						<projectileDef>DMS_Bullet_HMG_HollowPoint</projectileDef>
						<rangeFactor>0.7</rangeFactor>
						<accuracyFactor>0.9</accuracyFactor>
						<burstShotCountOverride>10</burstShotCountOverride>
					</li>
				</ammos>
			</li>
		</comps>
		<verbs>
			<li>
				<verbClass>Fortified.Verb_LaunchProjectile_AmmoSwitch</verbClass>
				<defaultProjectile>Bullet_DMS_HeavyMachineGun</defaultProjectile>
				<requireLineOfSight>true</requireLineOfSight>
				<warmupTime>2.4</warmupTime>          <!--架設 2.4 / 手持 3.0-->
				<range>47.9</range>                   <!--架設 47.9 / 手持 39.9-->
				<minRange>0</minRange>
				<ai_AvoidFriendlyFireRadius>5.9</ai_AvoidFriendlyFireRadius>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<burstShotCount>6</burstShotCount>    <!--架設 6 / 手持 4-->
				<soundCast>DMS_MachineGunHeavy_Shot</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.75,0.75)</drawSize>
				<offsets>
					<li>(0.75,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
		</modExtensions>
	</ThingDef>

	<!--
		HMG 手持型態。原本定義於 Defs/Things_Weapon/MilitaryGun_Heavy.xml，
		改繼承 FFF_MinifiedTurretEquippable 後不再是 DMS_AutomatroidHeavyGun 的子代，
		因此 MaxHitPoints / tools / storedConceptLearnOpportunity 都必須在此補回。
		AmmoSwitch 的 comp 以「附加」方式寫入（不要 Inherit="false"），
		否則會蓋掉父代的 CompEquippable 與拾起用的 CompProperties_Usable。
	-->
