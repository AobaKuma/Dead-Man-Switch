		<storedConceptLearnOpportunity>DMS_HeavyWeapon</storedConceptLearnOpportunity>
		<uiIconScale>0.6</uiIconScale>
		<graphicData>
			<texPath>Things/Weapons/DMS_HeavyMachineGun</texPath>
