			<li>A_MG_Heavy</li>
		</weaponTags>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<Mass>14.50</Mass>
			<Flammability>0</Flammability>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.70</AccuracyShort>
			<AccuracyMedium>0.85</AccuracyMedium>
			<AccuracyLong>0.75</AccuracyLong>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.15</MoveSpeed>
		</equippedStatOffsets>
		<!-- 彈種切換: 標準機槍彈(預設) / 空尖彈(短射程高射速壓制) -->
		<comps>
			<li Class="Fortified.CompProperties_AmmoSwitch">
				<defaultIndex>0</defaultIndex>
				<switchCooldown>240</switchCooldown>
				<soundSwitch>Artillery_ShellLoaded</soundSwitch>
				<ammos>
					<li>
						<projectileDef>Bullet_DMS_HeavyMachineGun</projectileDef>
					</li>
					<li>
						<projectileDef>DMS_Bullet_HMG_HollowPoint</projectileDef>
						<rangeFactor>0.7</rangeFactor>
						<accuracyFactor>0.9</accuracyFactor>
						<burstShotCountOverride>7</burstShotCountOverride>
					</li>
				</ammos>
			</li>
		</comps>
		<verbs>
			<li>
				<verbClass>Fortified.Verb_LaunchProjectile_AmmoSwitch</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_DMS_HeavyMachineGun</defaultProjectile>
				<warmupTime>3</warmupTime>
				<range>39.9</range>
				<minRange>0</minRange>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<burstShotCount>4</burstShotCount>
				<soundCast>DMS_MachineGunHeavy_Shot</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
