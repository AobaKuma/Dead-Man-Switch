<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 口袋手槍 -->
	<ThingDef ParentName="DMS_BaseMakeableGun">
		<defName>DMS_KnuckledusterRevolver</defName>
		<!-- 取得方式: 自產 / 交易 / 探索(低烈度) / 任務獎勵 -->
		<thingSetMakerTags>
			<li>RewardStandardHighFreq</li>
		</thingSetMakerTags>
		<label>Knuckleduster Revolver</label>
		<description>A miniature self-defense weapon commonly found on midworld, it barely takes up any space when folded. Knuckleduster accept multiple calibers and may also be used as brass-knuckles in a pinch.</description>
		<weaponClasses>
			<li>Ranged</li>
			<li>RangedLight</li>
			<li>ShortShots</li>
		</weaponClasses>	
		<weaponTags>
			<li>SimpleGun</li>
			<li>Revolver</li>
			<li>DMS_MechWeaponUltraLight</li>
			<li>CivilianGun</li>
		</weaponTags>
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<uiIconScale>1.8</uiIconScale>
		<graphicData>
			<texPath>Things/Weapons/HumanWeapon/KnuckledusterRevolver</texPath>
			<drawSize>(0.7,0.7)</drawSize>
		</graphicData>
		<soundInteract>Interact_Revolver</soundInteract>		
		<statBases>
			<Mass>0.5</Mass>
			<AccuracyTouch>0.95</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.15</AccuracyLong>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			<WorkToMake>2000</WorkToMake>
		</statBases>
		<!-- 解鎖: 槍械工藝 + 警用裝備 -->
		<recipeMaker>
			<researchPrerequisites>
				<li>Gunsmithing</li>
				<li>DMS_EquipmentBasis</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Steel>20</Steel>
		</costList>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Revolver</defaultProjectile>
				<warmupTime>0.3</warmupTime>
				<range>10.9</range>
				<soundCast>DMS_KnuckledusterRevolver_Shot</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>6</muzzleFlashScale>
			</li>
		</verbs>
		<tools Inherit="False">
			<li>
				<label>grip</label>
				<capacities>
				<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>blade</label>
				<capacities>
				  <li>Cut</li>
				</capacities>
				<power>12</power>
				<cooldownTime>1.5</cooldownTime>
			  </li>
			  <li>
				<label>point</label>
				<capacities>
				  <li>Stab</li>
				</capacities>
				<power>13</power>
				<cooldownTime>2</cooldownTime>
			  </li>
		</tools>
		<modExtensions>
			<li MayRequire="IssacZhuang.MuzzleFlash" Class="MuzzleFlash.MuzzleFlashProps">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>0.5</drawSize>
				<offsets>
				  <li>(0.1,0)</li>
				</offsets>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- 鎮暴機槍 -->
	<ThingDef ParentName="DMS_BaseMakeableGun">
		<defName>DMS_MiniMachineGun</defName>
		<!-- 取得方式: 自產 / 交易 / 任務獎勵 -->
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<thingSetMakerTags>
			<li>RewardStandardHighFreq</li>
		</thingSetMakerTags>
		<label>Riot LMG</label>
		<description>Pistol caliber machinegun designed for colony defense. The Riot LMG can cut down unarmored enemy hordes and prisoner riots with ease.</description>
	    <uiIconScale>1.4</uiIconScale>
		<graphicData>
			<texPath>Things/Weapons/DMS_MiniMachineGun</texPath>
			<drawSize>(1.3,1.3)</drawSize>
		</graphicData>
		<weaponTags>
			<li>A_RC</li>
			<li>A_RC_LongRifle</li>
			<li>IndustrialGun</li>
			<li>RiotLMG</li>
	  	</weaponTags>
		<soundInteract>Interact_Rifle</soundInteract>	
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>3.5</Mass>
			<RangedWeapon_Cooldown>1.56</RangedWeapon_Cooldown>
			<AccuracyTouch>0.95</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.16</AccuracyLong>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>DMS_Bullet_MiniMachineGun</defaultProjectile>
				<warmupTime>1.5</warmupTime>
				<range>19.9</range>
				<burstShotCount>8</burstShotCount>
				<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
				<soundCast>DMS_Pistol_Shot</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<!-- 解鎖: 反衝式槍機 + 警用裝備 -->
		<recipeMaker>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
			<researchPrerequisites>
				<li>BlowbackOperation</li>
				<li>DMS_EquipmentBasis</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Steel>70</Steel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.4,0.4)</drawSize>
				<offsets>
					<li>(0.4,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="BaseBullet">
		<defName>DMS_Bullet_MiniMachineGun</defName>
		<label>Riot machinegun bullet</label>
		<graphicData>
		  <texPath>Things/Projectile/Bullet_Small</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <damageDef>Bullet</damageDef>
		  <damageAmountBase>4</damageAmountBase>
		  <stoppingPower>1</stoppingPower>
		  <speed>50</speed>
		</projectile>
	  </ThingDef>

	<!-- 生存步槍 -->
	<ThingDef ParentName="DMS_BaseMakeableGun">
		<defName>DMS_SurvivalRifle</defName>
		<!-- 取得方式: 自產 / 交易 / 探索(低烈度) / 任務獎勵 -->
		<thingSetMakerTags>
			<li>RewardStandardHighFreq</li>
		</thingSetMakerTags>
		<label>Survival rifle</label>
		<description>Foldable rifle issued to war machine crew members in case of emergency. Accepts multiple common calibers.</description>
		<weaponClasses>
		  <li>LongShots</li>
		</weaponClasses>
		<weaponTags>
			<li>CivilianGun</li>
			<li>Simple_LongRange</li>
			<li>IndustrialGun</li>
			<li>SurvivalRifle</li>
		</weaponTags>
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<graphicData>
			<texPath>Things/Weapons/HumanWeapon/SurvivalRifle</texPath>
			<drawSize>(1.3,1.3)</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>	
		<statBases>
			<Mass>1.75</Mass>
			<RangedWeapon_Cooldown>1.17</RangedWeapon_Cooldown>
			<AccuracyTouch>0.75</AccuracyTouch>
			<AccuracyShort>0.90</AccuracyShort>
			<AccuracyMedium>0.80</AccuracyMedium>
			<AccuracyLong>0.65</AccuracyLong>
			<WorkToMake>11500</WorkToMake>
		</statBases>
		<equippedStatOffsets>
		  <HuntingStealth>0.5</HuntingStealth>
		</equippedStatOffsets>	
		<!-- 解鎖: 槍械工藝 + 警用裝備 -->
		<recipeMaker>
			<researchPrerequisites>
				<li>Gunsmithing</li>
				<li>DMS_EquipmentBasis</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Steel>35</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<tools Inherit="False">
			<li>
				<label>stock</label>
				<capacities>
				  <li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
				  <li>Blunt</li>
				  <li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_BoltActionRifle</defaultProjectile>
				<warmupTime>1.7</warmupTime>
				<range>31.9</range>
				<soundCast>DMS_SurvivalRifle_Shot</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(0.5,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
		</modExtensions>
	</ThingDef>
	
	<!-- 鎮暴手槍 -->
	<ThingDef ParentName="DMS_BaseMakeableGun">
		<defName>DMS_Revolver</defName>
		<!-- 取得方式: 自產 / 交易 / 任務獎勵 -->
		<tradeTags>
			<li>WeaponRanged</li>
		</tradeTags>
		<thingSetMakerTags>
			<li>RewardStandardHighFreq</li>
		</thingSetMakerTags>
		<label>Riot Revolver</label>
		<description>A double-action revolver designed to load shotgun ammo. It was designed for personal defense purposes but soon became a favored sidearm for mech solders because it can be used against most enemy types at the same time.</description>
		<graphicData>
			<texPath>Things/Weapons/HumanWeapon/RiotRevolver</texPath>
		</graphicData>
		<uiIconScale>1.5</uiIconScale>
		<weaponTags>
			<li>A_RC</li>
			<li>A_RC_Pistol</li>
			<li>A_Pistol</li>
			<li>A_SG_Pistol</li>
			<li>DMS_MechWeaponLight</li>
			<li>CivilianGun</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedLight</li>
			<li>ShortShots</li>
			<li>Ranged</li>
		</weaponClasses>
		<soundInteract>Interact_Autopistol</soundInteract>
		<!-- 解鎖: 槍械工藝 + 警用裝備 -->
		<recipeMaker>
			<researchPrerequisites>
				<li>Gunsmithing</li>
				<li>DMS_EquipmentBasis</li>
			</researchPrerequisites>
		</recipeMaker>
		<statBases>
			<WorkToMake>5000</WorkToMake>
			<Mass>2.1</Mass>
			<AccuracyTouch>0.95</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.15</AccuracyLong>
			<RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>45</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<!-- 彈種切換: 橡膠獨頭彈(預設) / 鹿彈 / 獨頭彈 -->
		<comps>
			<li Class="Fortified.CompProperties_AmmoSwitch">
				<defaultIndex>0</defaultIndex>
				<includeDefaultAmmo>false</includeDefaultAmmo>
				<switchCooldown>90</switchCooldown>
				<soundSwitch>Interact_Autopistol</soundSwitch>
				<ammos>
					<li>
						<label>rubber slug</label>
						<description>A less-lethal slug that bruises and knocks down instead of killing. What the revolver was sold with, and what most of its owners never bother to change.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Rubber</iconPath>
						<projectileDef>DMS_Bullet_RiotRevolver</projectileDef>
					</li>
					<li>
						<label>buckshot</label>
						<description>A lethal spread of pellets for when the situation stops being a disturbance and starts being a fight. Slightly harder to place than a rubber slug.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Pellet</iconPath>
						<projectileDef>DMS_Bullet_RiotRevolver_Buck</projectileDef>
						<accuracyFactor>0.9</accuracyFactor>
					</li>
					<li>
						<label>slug</label>
						<description>A single lead slug that carries much further than shot and punches through light plating. The heavier charge makes the revolver slower to bring on target.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Slug</iconPath>
						<projectileDef>DMS_Bullet_RiotRevolver_Slug</projectileDef>
						<rangeFactor>1.25</rangeFactor>
						<accuracyFactor>1.1</accuracyFactor>
						<warmUpFactor>1.15</warmUpFactor>
					</li>
				</ammos>
			</li>
		</comps>
		<verbs>
			<li>
				<!-- 人類可用武器一律用 Verb_Shoot_AmmoSwitch, Verb_LaunchProjectile_AmmoSwitch 不會給射擊經驗 -->
				<verbClass>Fortified.Verb_Shoot_AmmoSwitch</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>DMS_Bullet_RiotRevolver</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<range>12.9</range>
				<soundCast>Shot_Shotgun</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools Inherit="False">
			<li>
				<label>grip</label>
				<capacities>
				<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
				<li>Blunt</li>
				<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(0.25,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
			<li Class="Fortified.HeavyEquippableExtension">
				<EquippableDef>AverageHumanCanUse</EquippableDef>
			</li>
		</modExtensions>
	</ThingDef>
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_RiotRevolver</defName>
		<label>20 gauge rubber slug</label>
		<description>A 20 gauge rubber slug. It arrives as one heavy impact rather than a spread, which puts someone on the ground and rarely does worse than that. Armor plating shrugs it off entirely.</description>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Shotgun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Blunt</damageDef>
			<damageAmountBase>16</damageAmountBase>
			<stoppingPower>3</stoppingPower>
			<armorPenetrationBase>0.2</armorPenetrationBase>
			<speed>55</speed>
		</projectile>
	</ThingDef>

	<!-- 鹿彈: 鎮暴左輪的殺傷型彈種 -->
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_RiotRevolver_Buck</defName>
		<label>20 gauge buckshot</label>
		<description>A lethal 20 gauge pellet load. The revolver was never meant to be a fighting weapon, but nobody told the cylinder that.</description>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Shotgun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>18</damageAmountBase>
			<stoppingPower>2</stoppingPower>
			<armorPenetrationBase>0.15</armorPenetrationBase>
			<speed>55</speed>
		</projectile>
	</ThingDef>

	<!-- 獨頭彈: 鎮暴左輪的遠距/穿甲彈種 -->
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_RiotRevolver_Slug</defName>
		<label>20 gauge slug</label>
		<description>A single lead slug loaded to a heavier charge than the cylinder was designed around. It carries much further than shot and will crack a light mech shell, at the price of a wrist that regrets every round.</description>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>22</damageAmountBase>
			<stoppingPower>3</stoppingPower>
			<armorPenetrationBase>0.35</armorPenetrationBase>
			<speed>65</speed>
		</projectile>
	</ThingDef>

	<!-- 鎮暴霰彈槍 -->
	<ThingDef ParentName="DMS_BaseMakeableGun">
		<defName>DMS_RiotShotgun</defName>
		<label>Rifled slug gun</label>
		<description>A high caliber rifled shotgun manufactured with stamped components designed for riot operations and disabling hostile mechs.</description>
		<graphicData>
			<texPath>Things/Weapons/DMS_RiotShogun</texPath>
			<drawSize>(1.3,1.3)</drawSize>
		</graphicData>
		<weaponTags>
			<li>A_RC</li>
			<li>A_RC_LongRifle</li>
			<li>A_SG_LongRifle</li>
			<li>DMS_MechWeaponShotgun</li>
		</weaponTags>
		<weaponClasses>
			<li>Ranged</li>
			<li>ShortShots</li>
		</weaponClasses>	
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>20000</WorkToMake>
			<Mass>4</Mass>
			<AccuracyTouch>0.95</AccuracyTouch> 	
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.15</AccuracyLong>
			<RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
			<!-- 解鎖: 機甲齒輪 -->
			<researchPrerequisites Inherit="False">
				<li>DMS_MechBasis</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Steel>75</Steel>
			<ComponentStamped>1</ComponentStamped>
		</costList>
		<!-- 彈種切換: 橡膠獨頭彈(預設) / 鹿彈 / EMP散彈 / 破門彈 -->
		<comps>
			<li Class="Fortified.CompProperties_AmmoSwitch">
				<defaultIndex>0</defaultIndex>
				<includeDefaultAmmo>false</includeDefaultAmmo>
				<switchCooldown>120</switchCooldown>
				<soundSwitch>Interact_Rifle</soundSwitch>
				<ammos>
					<li>
						<label>rubber slug</label>
						<description>A single rubber slug that knocks a target down instead of killing it. The standard round for riot work and for taking prisoners alive.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Rubber</iconPath>
						<projectileDef>DMS_Bullet_RiotShotgun</projectileDef>
					</li>
					<li>
						<label>buckshot</label>
						<description>A lethal spread of pellets for close work against unarmored flesh. Marginally harder to place than a rubber slug.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Pellet</iconPath>
						<projectileDef>DMS_Bullet_RiotShotgun_Buck</projectileDef>
						<accuracyFactor>0.95</accuracyFactor>
					</li>
					<li>
						<label>EMP shot</label>
						<description>A capacitor slug that discharges on impact, shorting out mechanoid systems instead of destroying them. It does nothing at all to flesh, and the heavy payload cuts the effective range short.</description>
						<iconPath>UI/Ammoswitch/Shotgun_EMP</iconPath>
						<projectileDef>DMS_Bullet_RiotShotgun_EMP</projectileDef>
						<rangeFactor>0.75</rangeFactor>
						<accuracyFactor>0.9</accuracyFactor>
					</li>
					<li>
						<label>breaching round</label>
						<description>A solid slug meant to be fired into a door or a thin wall from arm's length. It will open a way in where nothing else will, and it is close to useless at any other distance.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Breach</iconPath>
						<projectileDef>DMS_Bullet_RiotShotgun_Breach</projectileDef>
						<rangeFactor>0.4</rangeFactor>
						<warmUpFactor>1.2</warmUpFactor>
					</li>
				</ammos>
			</li>
		</comps>
		<verbs>
			<li>
				<!-- 人類可用武器一律用 Verb_Shoot_AmmoSwitch, Verb_LaunchProjectile_AmmoSwitch 不會給射擊經驗 -->
				<verbClass>Fortified.Verb_Shoot_AmmoSwitch</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>DMS_Bullet_RiotShotgun</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>19.9</range>
