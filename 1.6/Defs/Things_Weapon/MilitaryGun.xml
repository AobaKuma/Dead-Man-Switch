	<!--AMR-->
	<ThingDef ParentName="DMS_AutomatroidGun">
		<defName>DMS_AntiMaterialRifle</defName>
		<!-- 取得方式: 交易 / 探索(中烈度) / 任務獎勵 -->
		<tradeTags>
			<li>DMS_WeaponUncraftable</li>
			<li>WeaponRanged</li>
		</tradeTags>
		<thingSetMakerTags>
			<li>RewardStandardCore</li>
		</thingSetMakerTags>
		<label>anti-material rifle</label>
		<description>A high caliber sniper rifle made to be used by MS-4E Jadger automatroids to destroy armored target at long ranges.\n\nThis weapon is specially designed for automatroid use, normal humans will struggle to use it without external equipment or augmentations.</description>
		<weaponClasses>
			<li>RangedHeavy</li>
			<li>LongShots</li>
			<li>Ranged</li>
		</weaponClasses>
		<weaponTags>
			<li>DMS_MechWeaponLongRifle</li>
			<li>A_SR_LongRifle</li>
		</weaponTags>
		<graphicData>
			<texPath>Things/Weapons/DMS_AntiMaterialRifle</texPath>
			<drawSize>1.5</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>60000</WorkToMake>
			<AccuracyTouch>0.50</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.90</AccuracyMedium>
			<AccuracyLong>0.88</AccuracyLong>
			<Mass>13.00</Mass>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.15</MoveSpeed>
		</equippedStatOffsets>
		<!-- 取得方式: 交易 / 探索獎勵(中烈度) - 不可製造 -->
		<recipeMaker IsNull="True" />
		<costList>
			<Tungsteel>20</Tungsteel>
			<ComponentStamped>6</ComponentStamped>
		</costList>
		<smeltProducts>
			<Tungsteel>12</Tungsteel>
		</smeltProducts>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_DMS_AMR</defaultProjectile>
				<warmupTime>3.0</warmupTime>
				<burstShotCount>1</burstShotCount>
				<range>47.9</range>
				<soundCast>Shot_TurretSniper</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(1,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
			<li Class="Fortified.HeavyEquippableExtension">
				<EquippableDef>StandardAutomatroid</EquippableDef>
			</li>
		</modExtensions>
	</ThingDef>

