<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 軍用武器為機兵範疇，在原版情況下相同定位的武器傷害都x1.5,重量x1.75，穿甲與鈍傷能力都有額外的0.5 -->

	<!-- weaponTags -->
	<!-- 機兵用輕型武器 DMS_MechWeaponLight //狗狗與部分非戰鬥單位使用，霰彈手槍與衝鋒槍範疇-->

	<!-- 機兵用副武器 DMS_Sub_Weapon //霰彈手槍與單手衝鋒槍,戰術手槍等-->

	<!-- 機兵用霰彈武器 DMS_MechWeaponShotgun //鎮暴霰彈槍,霰彈手槍等-->

	<!-- 中等體型機兵用武器 DMS_MechWeaponMedium //中等體型機兵使用的武器，精確射手步槍與半自動步槍，突擊步槍與重型衝鋒槍等-->
	<!-- 中等體型機兵用長身管武器 DMS_MechWeaponLongRifle//中等體型機兵使用的長身管武器，輕機槍，反器材步槍與狙擊槍-->

	<!-- 機兵用反坦克武器 DMS_MechWeaponAntiTank //反器材步槍,反坦克火箭砲，自動榴彈發射器與狙擊榴彈發射器-->

	<!-- 大约2.0體型重型機兵用武器 DMS_MechWeaponTransHeavy //猿人使用的槍型重武器裝備-->
	<!-- 大约2.5體型重型機兵用武器 DMS_MechWeaponHeavy //鬣蜥級別的機兵使用的槍型重武器裝備-->
	<!-- 載具型機兵用重型武器 DMS_VehicleWeapon //象龜使用的砲塔型重武器裝備，復仇者機砲與無後座力炮，2A38M等-->

	<!-- DMS_AssaultShotgun -->
	<ThingDef ParentName="DMS_AutomatroidGun">
		<defName>DMS_AssaultShotgun</defName>
		<label>Mech Assault Shotgun</label>
		<description>A fully automatic shotgun able to be mass produced with stamped components.\n\nThis weapon is specially designed for automatroid use, normal humans will struggle to use it without external equipment or augmentations.</description>
		<weaponClasses>
			<li>ShortShots</li>
			<li>RangedHeavy</li>
			<li>Ranged</li>
		</weaponClasses>
		<weaponTags>
			<li>DMS_MechWeaponMedium</li>
			<li>DMS_MechWeaponShotgun</li>
			<li>A_RC</li>
			<li>A_RC_LongRifle</li>
			<li>A_SG_LongRifle</li>
		</weaponTags>
		<graphicData>
			<texPath>Things/Weapons/DMS_AssaultShotgun</texPath>
			<drawSize>1.3</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>41000</WorkToMake>
			<Mass>6.75</Mass>
			<AccuracyTouch>0.70</AccuracyTouch>
			<AccuracyShort>0.64</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>1.35</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker>
			<!-- 解鎖: 失能機關 -->
			<researchPrerequisites Inherit="False">
				<li>DMS_DeadMansSwitch</li>
			</researchPrerequisites>
		</recipeMaker>
		<costList>
			<Tungsteel>20</Tungsteel>
			<ComponentStamped>6</ComponentStamped>
		</costList>
		<smeltProducts>
			<Tungsteel>12</Tungsteel>
		</smeltProducts>
		<!-- 彈種切換: 鹿彈(預設) / 獨頭彈 / 鎢芯飛鏢彈 / 龍息彈 -->
		<comps>
			<li Class="Fortified.CompProperties_AmmoSwitch">
				<defaultIndex>0</defaultIndex>
				<includeDefaultAmmo>false</includeDefaultAmmo>
				<switchCooldown>120</switchCooldown>
				<soundSwitch>Interact_Rifle</soundSwitch>
				<ammos>
					<li>
						<label>buckshot</label>
						<description>The standard three round burst of pellets. Nothing clever about it, and nothing unarmored enjoys standing in front of it.</description>
						<iconPath>UI/Ammoswitch/12Gauge_Normal</iconPath>
						<useDefaultProjectile>true</useDefaultProjectile>
					</li>
					<li>
						<label>slug</label>
						<description>A single rifled slug in place of the pellet spread. It reaches far further and punches through light plating, at the cost of one projectile per trigger pull.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Slug</iconPath>
						<projectileDef>DMS_Bullet_AssaultShotgun_Slug</projectileDef>
						<rangeFactor>1.6</rangeFactor>
						<accuracyFactor>1.1</accuracyFactor>
						<warmUpFactor>1.15</warmUpFactor>
						<burstShotCountOverride>1</burstShotCountOverride>
					</li>
					<li>
						<label>tungsten flechette</label>
						<description>A sabot load of tungsten-cored darts. Each one carries almost no mass, so flesh barely notices them, but five of them per pull will find their way through plating that shrugs off buckshot outright.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Darts</iconPath>
						<projectileDef>DMS_Bullet_AssaultShotgun_Flechette</projectileDef>
						<burstShotCountOverride>5</burstShotCountOverride>
						<rangeFactor>0.9</rangeFactor>
						<accuracyFactor>0.85</accuracyFactor>
					</li>
					<li>
						<label>dragon's breath</label>
						<description>Zirconium pellets that ignite as they leave the barrel. The burning cloud carries only a few paces and does little damage by itself, but four shells of it will set a corridor alight and keep anything from walking down it.</description>
						<iconPath>UI/Ammoswitch/Shotgun_Dragon</iconPath>
						<projectileDef>DMS_Bullet_AssaultShotgun_Dragon</projectileDef>
						<rangeFactor>0.55</rangeFactor>
						<accuracyFactor>0.9</accuracyFactor>
						<burstShotCountOverride>4</burstShotCountOverride>
					</li>
				</ammos>
			</li>
		</comps>
		<verbs>
			<li>
				<verbClass>Fortified.Verb_LaunchProjectile_AmmoSwitch</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Shotgun</defaultProjectile>
				<warmupTime>1.2</warmupTime>
				<range>14.9</range>
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
				<soundCast>Shot_Shotgun</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(0.75,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
			<li Class="Fortified.HeavyEquippableExtension">
				<EquippableDef>LightAutomatroid</EquippableDef>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- 獨頭彈: 突擊霰彈槍的遠距/穿甲替代彈種 -->
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_AssaultShotgun_Slug</defName>
		<label>12 gauge slug</label>
		<description>A single rifled lead slug instead of a spread of pellets. It reaches much further and punches through light plating, but only one projectile leaves the barrel per trigger pull.</description>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>30</damageAmountBase>
			<stoppingPower>4</stoppingPower>
			<speed>65</speed>
			<armorPenetrationBase>0.35</armorPenetrationBase>
		</projectile>
	</ThingDef>

	<!-- 鎢芯飛鏢彈: 突擊霰彈槍的近距離穿甲彈種 -->
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_AssaultShotgun_Flechette</defName>
		<label>12 gauge tungsten flechette</label>
		<description>A sabot shell holding a bundle of tungsten-cored darts. Each dart carries almost no mass and does little to soft tissue, but the cores hold together against plating that stops a lead pellet cold.</description>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<color>(200,210,225)</color>
			<drawSize>0.8</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>10</damageAmountBase>
			<stoppingPower>0.5</stoppingPower>
			<speed>90</speed>
			<armorPenetrationBase>0.55</armorPenetrationBase>
		</projectile>
	</ThingDef>

	<!-- 龍息彈: 突擊霰彈槍的近距離縱火拒止彈種 -->
	<ThingDef ParentName="DMS_BaseSwitchableBullet">
		<defName>DMS_Bullet_AssaultShotgun_Dragon</defName>
		<label>12 gauge dragon's breath</label>
		<description>A shell packed with zirconium pellets that ignite the moment they clear the muzzle. The burning cloud spends itself within a few paces, which is exactly the distance the loader cares about.</description>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<color>(255,150,60)</color>
		</graphicData>
		<projectile>
			<damageDef>Flame</damageDef>
			<damageAmountBase>10</damageAmountBase>
			<stoppingPower>1</stoppingPower>
			<speed>50</speed>
			<armorPenetrationBase>0.10</armorPenetrationBase>
			<ai_IsIncendiary>true</ai_IsIncendiary>
		</projectile>
	</ThingDef>

