	<!-- ===== DMS_Gun_Kord_Vehicle ===== -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="DMS_Gun_Kord_Vehicle"]/comps</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DMS_Gun_Kord_Vehicle"]/comps</xpath>
			<value>
				<li Class="FortifiedCE.CompProperties_TurretProjectileCE">
						<ammoSet>AmmoSet_127x108mm</ammoSet>
						<defaultAmmoPickUp>120</defaultAmmoPickUp>
						<startingAmmoRange>60~120</startingAmmoRange>
					</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DMS_Gun_Kord_Vehicle"]</xpath>
			<value>
				<comps>
					<li Class="FortifiedCE.CompProperties_TurretProjectileCE">
