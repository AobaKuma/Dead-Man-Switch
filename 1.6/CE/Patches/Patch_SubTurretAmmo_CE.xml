			</value>
		</nomatch>
	</Operation>

	<!-- ===== 機兵自動補彈：在「充電中」判斷之後插入撿彈 JobGiver ===== -->
	<Operation Class="PatchOperationInsert">
		<xpath>Defs/ThinkTreeDef[defName="DMS_Mechanoid"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalPlayerControlledMech"]/subNodes/li[@Class="ThinkNode_ConditionalNotFormingCaravan"]/subNodes/li[@Class="ThinkNode_ConditionalRecharging"]</xpath>
		<order>Append</order>
		<value>
			<li Class="Fortified.JobGiver_PickUpTurretAmmo" />
		</value>
	</Operation>

	<Operation Class="PatchOperationInsert">
		<xpath>Defs/ThinkTreeDef[defName="DMS_HumanlikeMech"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalPlayerControlledMech"]/subNodes/li[@Class="ThinkNode_ConditionalNotFormingCaravan"]/subNodes/li[@Class="ThinkNode_ConditionalRecharging"]</xpath>
		<order>Append</order>
		<value>
			<li Class="Fortified.JobGiver_PickUpTurretAmmo" />
		</value>
	</Operation>

</Patch>
