<?xml version="1.0" encoding="utf-8"?>

<!--
	子砲塔（Fortified.CompPropertiesMultipleTurretGun）的 CE 彈藥消耗補丁。

	運作方式：
	  FortifiedCE.CompProperties_TurretProjectileCE 掛在「子砲塔武器」的 ThingDef 上，
	  射擊時由 Verb.TryCastNextBurstShot -> EquipmentSource.Notify_UsedWeapon(pawn)
	  從機兵自身 inventory 扣除對應 AmmoSet 的彈藥；沒彈就停火（RunOutOfAmmo）。

	  defaultAmmoPickUp = 自動補給時的目標攜行量（約 10 個爆發量）
	  startingAmmoRange = 生成（含敵對）機兵時隨機給予的初始彈量

	本檔處理在 CE 下被當作子砲塔使用的武器（原版 Def，CE 屬性見 Patches/Weapons/MiliGuns*_CE.xml）。
-->
<Patch>

	<!-- ===== 鬣蜥 (Iguana) 通用機槍：CE 下使用 DMS_LightMachineGunMounted，.338 Lapua，爆發 15 發 ===== -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="DMS_LightMachineGunMounted"]/comps</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DMS_LightMachineGunMounted"]/comps</xpath>
			<value>
				<li Class="FortifiedCE.CompProperties_TurretProjectileCE">
					<ammoSet>AmmoSet_338Lapua</ammoSet>
					<defaultAmmoPickUp>150</defaultAmmoPickUp>
					<startingAmmoRange>75~150</startingAmmoRange>
				</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DMS_LightMachineGunMounted"]</xpath>
			<value>
				<comps>
					<li Class="FortifiedCE.CompProperties_TurretProjectileCE">
						<ammoSet>AmmoSet_338Lapua</ammoSet>
						<defaultAmmoPickUp>150</defaultAmmoPickUp>
						<startingAmmoRange>75~150</startingAmmoRange>
					</li>
				</comps>
			</value>
		</nomatch>
	</Operation>

	<!-- ===== 下掛武器：原版 Def 在 CE 下共用，補上由機兵 inventory 供彈的 comp（取代已移除的 CE 專用下掛砲塔 Def） =====
	     Sub-turret weapons: the vanilla-side defs are CE-patched in MiliGuns*_CE.xml and reused as-is; add the inventory-fed ammo comp here. -->

	<!-- ===== DMS_Flameblaster ===== -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="DMS_Flameblaster"]/comps</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DMS_Flameblaster"]/comps</xpath>
			<value>
				<li Class="FortifiedCE.CompProperties_TurretProjectileCE">
						<ammoSet>AmmoSet_DMS_Flamethrower</ammoSet>
						<defaultAmmoPickUp>100</defaultAmmoPickUp>
						<startingAmmoRange>50~100</startingAmmoRange>
					</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DMS_Flameblaster"]</xpath>
			<value>
				<comps>
					<li Class="FortifiedCE.CompProperties_TurretProjectileCE">
						<ammoSet>AmmoSet_DMS_Flamethrower</ammoSet>
						<defaultAmmoPickUp>100</defaultAmmoPickUp>
						<startingAmmoRange>50~100</startingAmmoRange>
					</li>
				</comps>
			</value>
		</nomatch>
	</Operation>

