<?xml version="1.0" encoding="utf-8"?>

<Patch>

	<!-- 蹄兔在 CE 下沿用 DMS_SubMachineGunMounted（於 MiliGunsMounted_CE.xml 取得 CE 屬性與 .22LR AmmoUser），
	     所以這裡不需要替換武器。原本有一條把它換成自己的空操作，已移除。 -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Mammoth"]/comps/li[@Class="Fortified.CompProperties_VehicleWeapon"]/defaultWeapon</xpath>
		<value>
			<defaultWeapon>DMS_HeavyMachineGunMounted</defaultWeapon>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Gecko"]/comps/li[@Class="Fortified.CompPropertiesMultipleTurretGun"]/subTurrets/li[ID="flame thrower"]/turret</xpath>
			<value>
				<turret>DMS_Gecko_FlameTurret</turret>
		     </value>
    </Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Gecko"]/comps/li[@Class="Fortified.CompPropertiesMultipleTurretGun"]/subTurrets/li[ID="close inbound system"]/turret</xpath>
		<value>
			<turret>DMS_Tarbosaurus_ShotgunGun</turret>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Geochelone"]/comps/li[@Class="Fortified.CompPropertiesMultipleTurretGun"]/subTurrets/li[ID="defense machinegun"]/turret</xpath>
		<value>
			<turret>DMS_Iguana_SubMachineGun</turret>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Dogge"]/comps/li[@Class="Fortified.CompPropertiesMultipleTurretGun"]/subTurrets/li[ID="machine gun"]/turret</xpath>
		<value>
			<turret>DMS_Iguana_SubMachineGun</turret>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Iguana"]/comps/li[@Class="Fortified.CompPropertiesMultipleTurretGun"]/subTurrets/li[ID="General-purpose machine gun"]/turret</xpath>
		<value>
			<turret>DMS_LightMachineGunMounted</turret>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Tarbosaurus"]/comps/li[@Class="Fortified.CompPropertiesMultipleTurretGun"]/subTurrets/li[ID="General-purpose machine gun"]/turret</xpath>
		<value>
			<turret>DMS_Tarbosaurus_SubMachineGun</turret>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Tarbosaurus"]/comps/li[@Class="Fortified.CompPropertiesMultipleTurretGun"]/subTurrets/li[ID="close inbound system"]/turret</xpath>
		<value>
			<turret>DMS_Tarbosaurus_ShotgunGun</turret>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DMS_Mech_Killdozer"]/comps/li[@Class="Fortified.CompProperties_VehicleWeapon"]/defaultWeapon</xpath>
		<value>
			<defaultWeapon>DMS_Dozer_KordMG</defaultWeapon>
		</value>
	</Operation>
	
</Patch>			