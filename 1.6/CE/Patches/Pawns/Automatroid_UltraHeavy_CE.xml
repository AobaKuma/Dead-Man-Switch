<?xml version="1.0" encoding="utf-8"?>

<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- ========== Cluster Weaver ========== -->
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]</xpath>
				<value>
					<li Class="CombatExtended.RacePropertiesExtensionCE">
						<bodyShape>Vehicle</bodyShape>
					</li>
				</value>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]/statBases</xpath>
				<value>
					<CarryWeight>120</CarryWeight>
					<CarryBulk>100</CarryBulk>
					<AimingAccuracy>1.1</AimingAccuracy>
					<ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
					<MeleeCritChance>0.05</MeleeCritChance>
					<MeleeParryChance>0</MeleeParryChance>
					<MaxHitPoints>400</MaxHitPoints>
					<NightVisionEfficiency>0.9</NightVisionEfficiency>
					<ReloadSpeed>0.9</ReloadSpeed>
				</value>
			</li>

			<!-- Carbon-fibre airframe: agile, but almost no armour for its weight class -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]/statBases/MeleeDodgeChance</xpath>
				<value>
					<MeleeDodgeChance>12</MeleeDodgeChance>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]/statBases/ArmorRating_Sharp</xpath>
				<value>
					<ArmorRating_Sharp>5</ArmorRating_Sharp>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]/statBases/ArmorRating_Blunt</xpath>
				<value>
					<ArmorRating_Blunt>6</ArmorRating_Blunt>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]/statBases/ArmorRating_Heat</xpath>
				<value>
					<ArmorRating_Heat>0.2</ArmorRating_Heat>
				</value>
			</li>

			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]/comps</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]</xpath>
					<value>
						<comps />
					</value>
				</nomatch>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]/comps</xpath>
				<value>
					<li Class="CombatExtended.CompProperties_ArmorDurability">
						<Durability>1150</Durability>
						<Regenerates>true</Regenerates>
						<RegenInterval>1250</RegenInterval>
						<RegenValue>5</RegenValue>
						<Repairable>true</Repairable>
						<RepairIngredients>
							<Steel>8</Steel>
							<Tungsteel>4</Tungsteel>
						</RepairIngredients>
						<RepairTime>300</RepairTime>
						<RepairValue>200</RepairValue>
						<CanOverHeal>true</CanOverHeal>
						<MaxOverHeal>115</MaxOverHeal>
						<MinArmorPct>0.75</MinArmorPct>
					</li>
				</value>
			</li>

			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="DMS_Mech_ClusterWeaver"]</xpath>
				<value>
					<li Class="CombatExtended.PartialArmorExt">
						<stats>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Sharp>0.15</ArmorRating_Sharp>
								<parts>
									<li>DMS_CompactSenser</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Blunt>0.15</ArmorRating_Blunt>
								<parts>
									<li>DMS_CompactSenser</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Sharp>0.3</ArmorRating_Sharp>
								<parts>
									<li>DMS_HoverRotor</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Blunt>0.3</ArmorRating_Blunt>
								<parts>
									<li>DMS_HoverRotor</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Sharp>0.9</ArmorRating_Sharp>
								<parts>
									<li>DMS_ChestBrain</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Blunt>0.9</ArmorRating_Blunt>
								<parts>
									<li>DMS_ChestBrain</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Sharp>0.7</ArmorRating_Sharp>
								<parts>
									<li>MechanicalArm</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Blunt>0.7</ArmorRating_Blunt>
								<parts>
									<li>MechanicalArm</li>
								</parts>
							</li>
						</stats>
					</li>
				</value>
			</li>

			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/PawnKindDef[defName="DMS_Mech_ClusterWeaver"]</xpath>
				<value>
					<li Class="CombatExtended.LoadoutPropertiesExtension">
						<primaryMagazineCount>
							<min>5</min>
							<max>8</max>
						</primaryMagazineCount>
					</li>
				</value>
			</li>


			<!-- ========== Wildfowl (FPV suicide drone) ========== -->
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="DMS_Drone_Wildfowl"]</xpath>
				<value>
					<li Class="CombatExtended.RacePropertiesExtensionCE">
						<bodyShape>Vehicle</bodyShape>
					</li>
				</value>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="DMS_Drone_Wildfowl"]/statBases</xpath>
				<value>
					<CarryWeight>5</CarryWeight>
					<CarryBulk>5</CarryBulk>
					<SmokeSensitivity>0</SmokeSensitivity>
					<NightVisionEfficiency>0.25</NightVisionEfficiency>
					<MeleeDodgeChance>20</MeleeDodgeChance>
					<MeleeCritChance>0</MeleeCritChance>
					<MeleeParryChance>0</MeleeParryChance>
					<ArmorRating_Sharp>0.3</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.3</ArmorRating_Blunt>
					<ArmorRating_Heat>0.1</ArmorRating_Heat>
					<MaxHitPoints>25</MaxHitPoints>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="DMS_Drone_Wildfowl"]/tools</xpath>
				<value>
					<tools Inherit="false">
						<li Class="CombatExtended.ToolCE">
							<label>flabellum</label>
							<capacities>
								<li>Cut</li>
							</capacities>
							<power>5</power>
							<cooldownTime>1.6</cooldownTime>
							<armorPenetrationBlunt>0.5</armorPenetrationBlunt>
							<armorPenetrationSharp>1</armorPenetrationSharp>
							<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
							<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
						</li>
					</tools>
				</value>
			</li>

			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[defName="DMS_Drone_Wildfowl"]</xpath>
				<value>
					<li Class="CombatExtended.PartialArmorExt">
						<stats>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Sharp>0.1</ArmorRating_Sharp>
								<parts>
									<li>DMS_CompactSenser</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Blunt>0.1</ArmorRating_Blunt>
								<parts>
									<li>DMS_CompactSenser</li>
								</parts>
							</li>
						</stats>
					</li>
				</value>
			</li>

		</operations>
	</Operation>
</Patch>
