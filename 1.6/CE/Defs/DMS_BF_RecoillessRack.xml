<?xml version="1.0" encoding="utf-8"?>

<!--
	CE: 戰鬥框架無後座力砲掛架 (DMS_BF_RecoillessRifle) 的彈道。

	原版能力打的是 DMS_Bullet_LRR_HEAT（vanilla Projectile，armorPenetrationBase 2.2）。
	CE 的裝甲換算完全不同尺度，vanilla 彈丸在 CE 底下等同無效，因此另外定義一顆
	ProjectileCE。CE 的 Harmony_CompAbilityEffect_LaunchProjectile 會在 projectileDef
	的 thingClass 繼承自 ProjectileCE 時攔截 CompAbilityEffect_LaunchProjectile，
	改用 CE_Utility.LaunchProjectileCE 發射，所以能力不需要改 verbClass。

	數值取向: 66mm 級一次性反裝甲火箭 (M72 LAW 同級)，破甲深度換算成 CE 的
	armorPenetrationSharp。若與所用 CE 版本的同級火箭有出入，直接調本檔即可，
	不會動到原版分支。
-->
<Defs>

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>DMS_Bullet_LRR_HEAT_CE</defName>
		<label>65mm shaped-charge rocket</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Things/Projectile/DMS_ShellRecoillessLight</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>1.15</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>75</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>60</damageAmountBase>
			<!-- 聚能裝藥: 高穿甲、小爆幅 -->
			<armorPenetrationSharp>300</armorPenetrationSharp>
			<armorPenetrationBlunt>25</armorPenetrationBlunt>
			<explosionRadius>1.2</explosionRadius>
			<soundExplode>Explosion_Rocket</soundExplode>
			<ai_IsIncendiary>false</ai_IsIncendiary>
			<dropsCasings>false</dropsCasings>
			<gravityFactor>2.5</gravityFactor>
			<shadowSize>0.4</shadowSize>
		</projectile>
		<!-- 不掛 Fortified.CompProperties_AfterBurner / CompProperties_ProjectileEffecter：
		     那兩個 comp 內部都做 parent as Projectile，而 CombatExtended.ProjectileCE
		     直接繼承 ThingWithComps、不是 vanilla Projectile，掛上去會 NRE。
		     CE 版的尾焰／煙跡交給 CE 自己的彈道效果。 -->
	</ThingDef>

</Defs>