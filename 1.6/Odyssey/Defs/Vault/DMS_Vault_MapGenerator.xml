<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 口袋地圖本體。實際的建築佈局是由 DMS_VaultElevator 追加的 AncientStockpile GenStep
       負責（見 DMS.Building_VaultElevator.GetExtraGenSteps），這裡只鋪地形與岩層。
       The pocket map itself; the structure is added by the portal's extra GenStep. -->
  <MapGeneratorDef>
    <defName>DMS_MilitaryVault</defName>
    <label>military archive vault</label>
    <isUnderground>true</isUnderground>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <biome>Underground</biome>
      <!-- 深層恆溫機房，比原版倉儲再冷一點。 -->
      <temperature>12</temperature>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
    <genSteps>
      <li>ElevationFertility</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>RockChunks</li>
      <!-- AncientStockpile 由 DMS_VaultElevator 動態插入 / injected by the portal -->
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>
