@@ -0,0 +1,263 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ══════════════════════════════════════════════════════════
+       電晶體電腦：設施伺服核心、設施數據輔機、站點伺服主機、賢者 SAGE。
+       可駭入的三台用 DMS.CompProperties_ServerHackable（多階段駭入、每次開工都拉設施警報、每階段掉一件獎勵）；
+       SAGE 另掛 DMS.CompProperties_HuntBreaker，打爛時暫停殖民艦隊的隱匿級追殺。
+       Transistor computers: facility server core, facility data rack, site server and SAGE.
+       The three hackable ones use DMS.CompProperties_ServerHackable (multi-stage hacking, every session trips
+       the facility alarm, one reward per stage); SAGE also carries DMS.CompProperties_HuntBreaker, which
+       suspends the colony fleet's Occulted-tier hunt when it is destroyed.
+       ══════════════════════════════════════════════════════════ -->
+
+  <DesignatorDropdownGroupDef>
+    <defName>DMS_ServerRacks</defName>
+    <label>server racks</label>
+  </DesignatorDropdownGroupDef>
+
+  <!-- 共用父類：不可建造、不可認領、不可拆除（只能打爛）；tick Normal 是偵測駭入作業所需。
+       Shared base: not buildable, not claimable, not deconstructible (destroy only); ticks Normal for session detection. -->
+  <ThingDef ParentName="DMS_BuildingBase" Name="DMS_ServerBuildingBase" Abstract="True">
+    <category>Building</category>
+    <designatorDropdown>DMS_ServerRacks</designatorDropdown>
+    <selectable>true</selectable>
+    <useHitPoints>true</useHitPoints>
+    <pathCost>50</pathCost>
+    <fillPercent>0.9</fillPercent>
+    <blockLight>true</blockLight>
+    <tickerType>Normal</tickerType>
+    <receivesSignals>true</receivesSignals>
+    <hasInteractionCell>true</hasInteractionCell>
+    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
+    <statBases>
+      <Flammability>0.3</Flammability>
+    </statBases>
+    <building>
+      <claimable>false</claimable>
+      <deconstructible>false</deconstructible>
+      <ai_chillDestination>false</ai_chillDestination>
+    </building>
+    <killedLeavings>
+      <ChunkSlagSteel>2</ChunkSlagSteel>
+      <ComponentIndustrial>2</ComponentIndustrial>
+    </killedLeavings>
+    <comps>
+      <!-- 放射性電池的微光；駭乾後由 CompHackable.glowIfHacked=false 熄滅。
+           The radioisotope cell's faint glow; goes dark once drained (CompHackable.glowIfHacked=false). -->
+      <li Class="CompProperties_Glower">
+        <glowRadius>3</glowRadius>
+        <glowColor>(90,200,160,0)</glowColor>
+      </li>
+    </comps>
+  </ThingDef>
+
+  <!-- 設施伺服核心：3~4 次駭入，獎勵為科技藍圖／封存技術匣／訪問密鑰。只出現在地下的設施檔案庫，
+       空投穿不過岩頂，所以不設保底援軍，警報交給地板開口、FPV 巢與毒氣釋放口。
+       Facility server core: 3~4 hacks for techprints / sealed data caches / access keys. Only in the
+       underground data archive; drop pods can't get through the rock, so no fallback wave: the floor
+       openings, FPV nests and gas vents answer the alarm. -->
+  <ThingDef ParentName="DMS_ServerBuildingBase">
+    <defName>DMS_FacilityServerCore</defName>
+    <label>facility server core</label>
+    <description>A sizable transistor computer. Old but extremely reliable, machines like this serve as paperless office and records hosts throughout the colony fleet's facilities. A special radioisotope cell inside keeps it running for years without anyone tending it.\n\nThe lower data layers of these server cores usually hold backups of important technical blueprints and access key records. Breaking into it will inevitably set off the whole facility's alarm response, so it is best to prepare your defenses before you start hacking.</description>
+    <graphicData>
+      <texPath>Things/Building/AlertCaller/FacilityServerCore</texPath>
+      <graphicClass>Graphic_Single</graphicClass>
+      <drawSize>(4,4)</drawSize>
+      <shadowData>
+        <volume>(1.8, 0.8, 1.6)</volume>
+      </shadowData>
+    </graphicData>
+    <uiIconScale>0.8</uiIconScale>
+    <size>(2,2)</size>
+    <rotatable>false</rotatable>
+    <statBases>
+      <MaxHitPoints>900</MaxHitPoints>
+      <Mass>120</Mass>
+    </statBases>
+    <comps>
+      <li Class="DMS.CompProperties_ServerHackable">
+        <defence>1800</defence>
+        <defencePerStage>600</defencePerStage>
+        <stageCount>3~4</stageCount>
+        <effectHacking>HackingTerminal</effectHacking>
+        <intellectualSkillPrerequisite>6</intellectualSkillPrerequisite>
+        <lockoutDurationHoursRange>6~12</lockoutDurationHoursRange>
+        <glowIfHacked>false</glowIfHacked>
+        <alertIncrement>35</alertIncrement>
+        <alarmSound>FlickSwitch</alarmSound>
+        <fallbackThing>DMS_DataCache_Restricted</fallbackThing>
+        <rewards>
+          <li>
+            <kind>Techprint</kind>
+            <weight>5</weight>
+          </li>
+          <li>
+            <kind>Thing</kind>
+            <thingDef>DMS_DataCache_Sealed</thingDef>
+            <weight>3</weight>
+            <maxPerBuilding>2</maxPerBuilding>
+          </li>
+          <li>
+            <kind>AccessKey</kind>
+            <weight>4</weight>
+            <maxPerBuilding>2</maxPerBuilding>
+            <keyWeights>
+              <DMS_AccessKey_Nara>1</DMS_AccessKey_Nara>
+              <DMS_AccessKey_Neutrals>1</DMS_AccessKey_Neutrals>
+            </keyWeights>
+          </li>
+        </rewards>
+      </li>
+    </comps>
+  </ThingDef>
+
+  <!-- 設施數據輔機：純裝飾。南北向貼圖是橫的，所以佔地 2x1（轉東西向變 1x2）。貼圖缺 east，Graphic_Multi 會用 west 翻轉。
+       Facility data rack: dressing only. The north/south art is landscape, so the footprint is 2x1 (1x2 when turned
+       east/west). No east texture; Graphic_Multi mirrors west. -->
+  <ThingDef ParentName="DMS_ServerBuildingBase">
+    <defName>DMS_FacilityDataRack</defName>
+    <label>facility data rack</label>
+    <description>A cabinet of tape drives and core memory wired in parallel with a facility server core, holding the archives the host rarely calls up. It has no processing or access interface of its own; everything on it has to be read out through the host.</description>
+    <tickerType>Never</tickerType>
+    <hasInteractionCell>false</hasInteractionCell>
+    <graphicData>
+      <texPath>Things/Building/AlertCaller/FacilityDataRack</texPath>
+      <graphicClass>Graphic_Multi</graphicClass>
+      <drawSize>(3,3)</drawSize>
+    </graphicData>
+    <size>(2,1)</size>
+    <rotatable>true</rotatable>
+    <statBases>
+      <MaxHitPoints>400</MaxHitPoints>
+      <Mass>60</Mass>
+    </statBases>
+    <comps Inherit="False" />
+    <killedLeavings>
+      <ChunkSlagSteel>1</ChunkSlagSteel>
+      <ComponentIndustrial>1</ComponentIndustrial>
+    </killedLeavings>
+  </ThingDef>
+
+  <!-- 站點伺服主機：單次駭入，獎勵只有科技藍圖／訪問密鑰（不含技術匣）。放在地表設施，地圖上沒有警報反應建築時直接叫援軍。
+       摧毀不影響追殺。
+       Site server: one hack, techprint or access key only (no data cache). Surface facilities; with nothing on the map
+       answering the alarm it calls the QRF directly. Destroying it doesn't affect the hunt. -->
+  <ThingDef ParentName="DMS_ServerBuildingBase">
+    <defName>DMS_SiteServerCore</defName>
+    <label>site server</label>
+    <description>A compact transistor computer. Old but extremely reliable, machines like this serve as paperless office and records hosts throughout the colony fleet's facilities. A special radioisotope cell inside keeps it running for years without anyone tending it.\n\nThe hosts used at small sites like this rarely hold anything truly classified, but valuable intelligence can still be pulled from them. Hacking it will trip the host's security alarm response, so it is best to prepare your defenses before you start.</description>
+    <graphicData>
+      <texPath>Things/Building/AlertCaller/SiteServerCore</texPath>
+      <graphicClass>Graphic_Single</graphicClass>
+      <drawSize>(2,2)</drawSize>
+    </graphicData>
+    <size>(1,1)</size>
+    <rotatable>false</rotatable>
+    <statBases>
+      <MaxHitPoints>350</MaxHitPoints>
+      <Mass>40</Mass>
+    </statBases>
+    <comps>
+      <li Class="DMS.CompProperties_ServerHackable">
+        <defence>1200</defence>
+        <stageCount>1</stageCount>
+        <effectHacking>HackingTerminal</effectHacking>
+        <intellectualSkillPrerequisite>4</intellectualSkillPrerequisite>
+        <lockoutDurationHoursRange>4~8</lockoutDurationHoursRange>
+        <glowIfHacked>false</glowIfHacked>
+        <alertIncrement>40</alertIncrement>
+        <fallbackRaidWave>DMS_RaidWave_FacilityQRF</fallbackRaidWave>
+        <alarmSound>FlickSwitch</alarmSound>
+        <!-- 無 Royalty 時退回密鑰，遵守「不含技術匣」。Without Royalty, fall back to a key: still no data cache. -->
+        <fallbackThing>DMS_AccessKey_Neutrals</fallbackThing>
+        <rewards>
+          <li>
+            <kind>Techprint</kind>
+            <weight>5</weight>
+          </li>
+          <li>
+            <kind>AccessKey</kind>
+            <weight>5</weight>
+            <keyWeights>
+              <DMS_AccessKey_Nara>1</DMS_AccessKey_Nara>
+              <DMS_AccessKey_Neutrals>1</DMS_AccessKey_Neutrals>
+            </keyWeights>
+          </li>
+        </rewards>
+      </li>
+    </comps>
+  </ThingDef>
+
+  <!-- 賢者 SAGE：2~3 次駭入，獎勵同設施伺服核心，另有低權重的禁忌級技術匣。打爛時暫停追殺：首次 1~2 年，
+       已在暫停中則每座再加 15 天。南北向貼圖是橫的，所以佔地 3x1（轉東西向變 1x3，drawSize 也會跟著對調）。
+       貼圖缺 west，Graphic_Multi 會用 east 翻轉。
+       SAGE: 2~3 hacks, the core's reward pool plus a rare occulted data cache. Destroying it suspends the hunt:
+       1~2 years the first time, +15 days per further node while already suspended. The north/south art is
+       landscape, so the footprint is 3x1 (1x3 east/west; drawSize swaps with it). No west texture; east is mirrored. -->
+  <ThingDef ParentName="DMS_ServerBuildingBase">
+    <defName>DMS_SageCore</defName>
+    <label>SAGE</label>
+    <description>A distributed strategic command computer that can take on auxiliary racks without limit, adding computing power as demand grows. The colony fleet uses it for planetary strategic air defense and to link the countless radar tracking and navigation networks spread across several continents. Destroying it is certain to cripple the fleet's hunting operations on the planet, though within a year or two another computer in the SAGE network will be promoted to host and carry on the task.\n\nIts lower storage still keeps copies of parts of the strategic database. Hacking it will bring the whole facility's alarm system down on you.</description>
+    <graphicData>
+      <texPath>Things/Building/AlertCaller/Sage</texPath>
+      <graphicClass>Graphic_Multi</graphicClass>
+      <drawSize>(5,3)</drawSize>
+    </graphicData>
+    <uiIconScale>0.7</uiIconScale>
+    <size>(3,1)</size>
+    <rotatable>true</rotatable>
+    <staticSunShadowHeight>0.8</staticSunShadowHeight>
+    <statBases>
+      <MaxHitPoints>1600</MaxHitPoints>
+      <Mass>300</Mass>
+    </statBases>
+    <comps>
+      <li Class="DMS.CompProperties_ServerHackable">
+        <defence>2500</defence>
+        <defencePerStage>800</defencePerStage>
+        <stageCount>2~3</stageCount>
+        <effectHacking>HackingTerminal</effectHacking>
+        <intellectualSkillPrerequisite>10</intellectualSkillPrerequisite>
+        <lockoutDurationHoursRange>8~16</lockoutDurationHoursRange>
+        <glowIfHacked>false</glowIfHacked>
+        <alertIncrement>50</alertIncrement>
+        <fallbackRaidWave>DMS_RaidWave_FacilityQRF</fallbackRaidWave>
+        <alarmSound>FlickSwitch</alarmSound>
+        <fallbackThing>DMS_DataCache_Restricted</fallbackThing>
+        <rewards>
+          <li>
+            <kind>Techprint</kind>
+            <weight>4</weight>
+          </li>
+          <li>
+            <kind>Thing</kind>
+            <thingDef>DMS_DataCache_Sealed</thingDef>
+            <weight>3</weight>
+            <maxPerBuilding>2</maxPerBuilding>
+          </li>
+          <li>
+            <kind>Thing</kind>
+            <thingDef>DMS_DataCache_Occulted</thingDef>
+            <weight>1</weight>
+            <maxPerBuilding>1</maxPerBuilding>
+          </li>
+          <li>
+            <kind>AccessKey</kind>
+            <weight>3</weight>
+            <keyWeights>
+              <DMS_AccessKey_Nara>1</DMS_AccessKey_Nara>
+              <DMS_AccessKey_Neutrals>1</DMS_AccessKey_Neutrals>
+            </keyWeights>
+          </li>
+        </rewards>
+      </li>
+      <li Class="DMS.CompProperties_HuntBreaker">
+        <suspendYears>1~2</suspendYears>
+        <stackDaysWhileSuspended>15</stackDaysWhileSuspended>
+      </li>
+    </comps>
+  </ThingDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Things_Building/DMS_FPVNest.xml

+++ DMS2/NewContent/Defs/Things_Building/DMS_FPVNest.xml

@@ -0,0 +1,66 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+  <!-- FPV 無人機母巢：設施版 FPV 機巢（DMS_Building_FPVNest）的玩家版，由封存檔案 I 級「駐屯兵器」解鎖。
+       設施版靠警報訊號一次放出四架野禽；玩家版改走 FFF 的無人機平台（同獵犬平台）：裝填鋼鐵、手動部署、收回退料。
+       研究前置寫 Inherit="False"，免得父類的 DMS_UAVBasis 被併進來，研究頁上兩個專案都列出它。
+       FPV drone hive: the player version of the facility FPV nest (DMS_Building_FPVNest), unlocked by the class I
+       sealed file "garrison arsenal". The facility nest releases four wildfowl on an alert signal; this one runs on
+       FFF's drone platform like the hound station: load steel, deploy by hand, recall for a refund.
+       researchPrerequisites uses Inherit="False" so the parent's DMS_UAVBasis isn't merged in and listed as a second unlock. -->
+  <ThingDef ParentName="DMS_BaseDronePlatform">
+    <defName>DMS_FPVNest</defName>
+    <label>FPV drone hive</label>
+    <description>A garrison drone nest built from sealed pioneer patterns. Load it with steel and it assembles wildfowl, coaxial-rotor suicide drones that hunt down hostiles and detonate against them, and launches them in salvos of up to four.\n\nUnlike the facility nests still guarding this world's installations, it has no underground logistics line to restock it, so it must be fed by hand. Recalled drones return their steel; drones that run their batteries flat are lost.</description>
+    <descriptionHyperlinks>
+      <ThingDef>DMS_Drone_Wildfowl</ThingDef>
+    </descriptionHyperlinks>
+    <size>(1,1)</size>
+    <fillPercent>0.75</fillPercent>
+    <uiIconScale>0.5</uiIconScale>
+    <staticSunShadowHeight>0.35</staticSunShadowHeight>
+    <graphicData>
+      <texPath>Things/Building/DMS_Building_HangerSmall</texPath>
+      <graphicClass>Graphic_Single</graphicClass>
+      <drawSize>(3,3)</drawSize>
+      <damageData>
+        <!-- 貼圖 3x3 繪製、機巢本體只佔中間那一條。The 3x3 art only fills the middle strip. -->
+        <rect>(0.32,0.29,0.36,0.65)</rect>
+        <cornerTL>Damage/Corner</cornerTL>
+        <cornerTR>Damage/Corner</cornerTR>
+        <cornerBL>Damage/Corner</cornerBL>
+        <cornerBR>Damage/Corner</cornerBR>
+      </damageData>
+    </graphicData>
+    <statBases>
+      <WorkToBuild>8000</WorkToBuild>
+      <MaxHitPoints>200</MaxHitPoints>
+      <Mass>30</Mass>
+      <Flammability>0.5</Flammability>
+    </statBases>
+    <costList>
+      <Steel>120</Steel>
+      <ComponentIndustrial>6</ComponentIndustrial>
+    </costList>
+    <researchPrerequisites Inherit="False">
+      <li>DMS_Occultech_RemnantPatterns</li>
+    </researchPrerequisites>
+    <comps>
+      <li Class="CompProperties_Power">
+        <compClass>CompPowerTrader</compClass>
+        <basePowerConsumption>200</basePowerConsumption>
+      </li>
+      <!-- 每架 15 鋼（同集群織鳥的彈艙），一批最多四架（同設施版），庫存上限 16 架份。
+           15 steel a drone (as in the cluster weaver's bay), up to four per salvo (as the facility nest), stock for 16. -->
+      <li Class="Fortified.CompProperties_MechPlatform">
+        <gizmoIconPath>UI/Ability/Drone_Send_bird</gizmoIconPath>
+        <fixedIngredient>Steel</fixedIngredient>
+        <costPerPawn>15</costPerPawn>
+        <cooldownTicks>2500</cooldownTicks>
+        <maxPawnsToSpawn>4</maxPawnsToSpawn>
+        <startingIngredientCount>60</startingIngredientCount>
+        <maxIngredientCount>240</maxIngredientCount>
+        <spawnPawnKind>DMS_Drone_Wildfowl</spawnPawnKind>
+      </li>
+    </comps>
+  </ThingDef>
+</Defs>

--- DMS1/NewContent/Defs/Things_Building/DMS_MechCapsule_BullHound.xml

+++ DMS2/NewContent/Defs/Things_Building/DMS_MechCapsule_BullHound.xml

@@ -0,0 +1,43 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       鬥牛犬的封存犬舍：研究「駐屯兵器」之前唯一能取得鬥牛犬的途徑。
+       與其他封存艙一樣是斷電的正規軍封存，機械師可駭入收編；
+       但作為駐防犬，警報響起時比其他搖籃更容易自己醒來咬人（triggerChance 較高）。
+       The BullHound kennel: found inside remnant installations, the only way to obtain a bullhound before "garrison arsenal" is researched.
+       Like the other cradles it is a powered-down line-unit mothball a mechanitor can hack, but as the
+       installation's watchdog it wakes hostile on an alarm far more readily (higher triggerChance).
+       醒來後的 AI 同其他封存艙：警報回應（DMS.LordJob_AlarmResponse），見 DMS_Vault_MechCapsules.xml。
+       Once awake it runs the same alarm response as the other cradles (DMS.LordJob_AlarmResponse); see
+       DMS_Vault_MechCapsules.xml.
+       ============================================================ -->
+
+  <!-- 2x2：駐防犬舍 / garrison kennel -->
+  <ThingDef ParentName="FFF_MechCapsule_Medium">
+    <defName>DMS_MechCapsule_VaultKennel</defName>
+    <label>hibernated bullhound</label>
+    <description>A bullhound garrison automatroid in hibernation mode, clamped into a charging kennel with its back mount still loaded. It was left on watch when the installation was sealed, and its alarm circuit is still live. A mechanitor can attempt to hack and control it.</description>
+    <!-- 警報響應：同地圖的警戒掃描器觸發時，有 triggerChance 的機率讓機兵敵對啟動；每次警報各自擲骰。
+         Alarm response: when an alert scanner on the same map fires, roll triggerChance to wake the mech as a hostile; every alarm rolls again. -->
+    <receivesSignals>true</receivesSignals>
+    <comps>
+      <li Class="DMS.CompProperties_AlertEffector_WakeCapsuleMech">
+        <triggerChance>0.5</triggerChance>
+      </li>
+    </comps>
+    <modExtensions>
+      <li Class="Fortified.ModExtension_MechCapsule">
+        <spawnChance>0.75</spawnChance>
+        <!-- 武裝是固定子砲塔，不走手持武器保留判定。The mount is a fixed sub-turret, so the hand-weapon keep roll never applies. -->
+        <weaponChance>1</weaponChance>
+        <possibleGeneratePawn>
+          <DMS_Mech_BullHound>3</DMS_Mech_BullHound>
+          <DMS_Mech_BullHound_Flamer>2</DMS_Mech_BullHound_Flamer>
+        </possibleGeneratePawn>
+        <innerPawnDrawOffset>(0, 0, 0.1)</innerPawnDrawOffset>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Things_Building/DMS_MechCapsule_Pirate.xml

+++ DMS2/NewContent/Defs/Things_Building/DMS_MechCapsule_Pirate.xml

@@ -0,0 +1,40 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <ThingDef ParentName="FFF_MechCapsule_Small">
+    <defName>DMS_MechCapsule_PirateRaider</defName>
+    <label>disabled mech</label>
+    <!-- 說明文比照 FFF 自己的休眠容器：一句交代是什麼，一句交代能做什麼。
+         Matches FFF's own capsule wording: what it is, then what you can do. -->
+    <description>A raider-pattern automatroid in hibernation mode, still clamped to the assembly cradle it was built on. The line that made it never got as far as locking its command authentication. A mechanitor can attempt to hack and control it.</description>
+    <modExtensions>
+      <li Class="Fortified.ModExtension_MechCapsule">
+        <spawnChance>0.65</spawnChance>
+        <weaponChance>0.7</weaponChance>
+        <!-- PawnGenOption 使用自訂載入器：節點名＝PawnKindDef，內容＝權重。
+             PawnGenOption loads as <PawnKindDefName>weight</PawnKindDefName>. -->
+        <possibleGeneratePawn>
+          <DMS_Mech_Raider>1</DMS_Mech_Raider>
+        </possibleGeneratePawn>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+  <!-- 3x3：海盜塔琴卡重架 / Tachanka gantry -->
+  <ThingDef ParentName="FFF_MechCapsule_Large">
+    <defName>DMS_MechCapsule_PirateTachanka</defName>
+    <label>disabled mech</label>
+    <description>A tachanka-pattern battle frame in hibernation mode, clamped into an assembly gantry with its fitting-out unfinished. Its command authentication has not been locked yet. A mechanitor can attempt to hack and control it.</description>
+    <modExtensions>
+      <li Class="Fortified.ModExtension_MechCapsule">
+        <spawnChance>1.0</spawnChance>
+        <weaponChance>0.85</weaponChance>
+        <possibleGeneratePawn>
+          <DMS_Mech_Tachanka>1</DMS_Mech_Tachanka>
+        </possibleGeneratePawn>
+        <innerPawnDrawOffset>(0, 0, 0.35)</innerPawnDrawOffset>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Things_Building/DMS_Production_Hopper.xml

+++ DMS2/NewContent/Defs/Things_Building/DMS_Production_Hopper.xml

@@ -0,0 +1,128 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- 進料斗：把輸送帶處理不了的粗料（石塊、熔渣塊、屍體）堆在生產線旁，讓自動生產建築自己取用。
+       抽料由框架的 LinkedStorageIngredientPuller 負責，來源建築必須掛 ModExtension_MaterialSource。
+       連結關係仍然走原版 facility 系統：工作台側的 CompProperties_AffectedByFacilities.linkableFacilities
+       要列出 DMS_Hopper（見 DMS_Production_Base.xml 的 DMS_BenchBase），而且工作台的
+       ModExtension_AutoWorkTable.pullFromLinkedStorage 要開，否則料斗只是個普通的儲存架。 -->
+  <ThingDef ParentName="BuildingBase">
+    <defName>DMS_Hopper</defName>
+    <label>feed hopper</label>
+    <description>A gravity-fed bulk hopper with a powered auger in its base to move the coarse material that a normal conveyor line cannot handle, such as stone chunks, slag and mech wreckage.\n\nAutonomous production buildings linked to this hopper draw material straight out of it, so nothing has to be carried in by hand. Cutting the power stops the feed.</description>
+    <thingClass>Building_Storage</thingClass>
+    <graphicData>
+      <texPath>Things/Building/DMSHopper/building</texPath>
+      <graphicClass>Graphic_Multi</graphicClass>
+      <drawSize>(3,2)</drawSize>
+      <damageData>
+        <cornerTL>Damage/Corner</cornerTL>
+        <cornerTR>Damage/Corner</cornerTR>
+        <cornerBL>Damage/Corner</cornerBL>
+        <cornerBR>Damage/Corner</cornerBR>
+      </damageData>
+    </graphicData>
+    <size>(2,1)</size>
+    <rotatable>true</rotatable>
+    <defaultPlacingRot>South</defaultPlacingRot>
+    <altitudeLayer>Building</altitudeLayer>
+    <!-- 有電力與開關，需要即時繪製斷電／關閉的圖示，不能沿用 BuildingBase 的 MapMeshOnly。 -->
+    <drawerType>MapMeshAndRealTime</drawerType>
+    <passability>PassThroughOnly</passability>
+    <pathCost>42</pathCost>
+    <fillPercent>0.5</fillPercent>
+    <canOverlapZones>false</canOverlapZones>
+    <castEdgeShadows>true</castEdgeShadows>
+    <staticSunShadowHeight>0.35</staticSunShadowHeight>
+    <surfaceType>Item</surfaceType>
+    <tickerType>Rare</tickerType>
+    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
+    <constructEffect>ConstructMetal</constructEffect>
+    <repairEffect>Repair</repairEffect>
+    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
+    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
+    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
+    <designationCategory>DMS_Category</designationCategory>
+    <minifiedDef>MinifiedThing</minifiedDef>
+    <thingCategories>
+      <li>BuildingsMisc</li>
+    </thingCategories>
+    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
+    <researchPrerequisites>
+      <li>DMS_Material</li>
+    </researchPrerequisites>
+    <costList>
+      <Steel>80</Steel>
+      <ComponentIndustrial>2</ComponentIndustrial>
+    </costList>
+    <statBases>
+      <MaxHitPoints>250</MaxHitPoints>
+      <WorkToBuild>1500</WorkToBuild>
+      <Mass>45</Mass>
+      <Flammability>0</Flammability>
+      <SellPriceFactor>0.7</SellPriceFactor>
+    </statBases>
+    <inspectorTabs>
+      <li>ITab_Storage</li>
+    </inspectorTabs>
+    <building>
+      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
+      <blueprintClass>Blueprint_Storage</blueprintClass>
+      <storageGroupTag>DMS_Hopper</storageGroupTag>
+      <!-- 塊堆與屍體都不可堆疊，一格一件會讓料斗小到沒有意義；三件一格等於整座 6 件。 -->
+      <maxItemsInCell>3</maxItemsInCell>
+      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
+      <!-- 永遠只收粗料。fixedStorageSettings 是硬上限，玩家改不了，
+           所以自動產線不會被順手塞進來的鋼鐵或藥物卡住。 -->
+      <fixedStorageSettings>
+        <filter>
+          <categories>
+            <li>Chunks</li>
+            <li>Corpses</li>
+            <li>FoodRaw</li>
+          </categories>
+          <!-- 木頭沒有獨立的 ThingCategory（原版只掛在 ResourcesRaw 下），
+               改用 stuff 類別 Woody 篩選：原版 WoodLog 與其他模組的木材都會一併納入。 -->
+          <stuffCategoriesToAllow>
+            <li>Woody</li>
+          </stuffCategoriesToAllow>
+        </filter>
+      </fixedStorageSettings>
+      <!-- 預設只勾塊堆與動物屍體：人形屍體要不要進磨床是玩家自己的決定，別替他決定。 -->
+      <defaultStorageSettings>
+        <priority>Important</priority>
+        <filter>
+          <categories>
+            <li>Chunks</li>
+            <li>CorpsesAnimal</li>
+          </categories>
+        </filter>
+      </defaultStorageSettings>
+    </building>
+    <comps>
+      <li Class="CompProperties_Power">
+        <compClass>CompPowerTrader</compClass>
+        <basePowerConsumption>50</basePowerConsumption>
+      </li>
+      <li Class="CompProperties_Flickable" />
+      <li Class="CompProperties_Facility">
+        <!-- 一座料斗可以同時餵四台機器；maxDistance 收到 6 是為了讓它看起來像產線的一部分，
+             而不是隔著半個工廠遙控供料。requiresLOS 沿用預設 true，中間隔牆就斷料。 -->
+        <maxSimultaneous>4</maxSimultaneous>
+        <maxDistance>6</maxDistance>
+      </li>
+    </comps>
+    <placeWorkers>
+      <li>PlaceWorker_ShowFacilitiesConnections</li>
+    </placeWorkers>
+    <modExtensions>
+      <li Class="Fortified.ModExtension_MaterialSource">
+        <!-- 斷電或被關掉就停止供料，讓玩家看得出產線為什麼停了。 -->
+        <allowWhileInactive>false</allowWhileInactive>
+        <!-- 不搶殖民者已經預約的東西，免得對方的搬運工作在半路失敗。 -->
+        <respectReservations>true</respectReservations>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+</Defs>

