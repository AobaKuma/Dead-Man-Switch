+      <Filth_RubbleBuilding>
+        <groupsPerHundredCells>1~3</groupsPerHundredCells>
+        <itemsPerGroup>3~6</itemsPerGroup>
+        <groupDistRange>1~3</groupDistRange>
+      </Filth_RubbleBuilding>
+      <ChunkSlagSteel>
+        <groupsPerHundredCells>0~2</groupsPerHundredCells>
+        <itemsPerGroup>1~2</itemsPerGroup>
+        <groupDistRange>1~2</groupDistRange>
+      </ChunkSlagSteel>
