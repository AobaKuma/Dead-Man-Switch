+  <!-- ============================================================
+       歷史事件 (HistoryEventDef)
+       HistoryEventDef 本身沒有效果,它只是一個被記錄下來的標籤。
+       要產生實際影響,必須有 PreceptComp 監聽它
+       (PreceptComp_SelfTookMemoryThought / _KnowsMemoryThought /
+        _UnwillingToDo / _DevelopmentPoints),
+       或被當成 Faction.TryAffectGoodwillWith 的 reason。
+
+       其中 DMS_QuestSuccess_* / DMS_QuestFailed_* 是唯一不需要
+       precept 就有效的一組:QuestScriptDef 的 successHistoryEvent
+       會自動記錄,並餵給流動信仰的成長點 (IdeoDevelopmentUtility)。
+       ============================================================ -->
+
+  <!-- ── 任務結算:軍事行動 ────────────────────────────────────── -->
+  <!-- DMS_Boss / DMS_DecoySiteAssault / DMS_PirateAssemblyRaid / DMS_AirportAssault / DMS_LegacyInstallationAssault -->
+  <HistoryEventDef>
+    <defName>DMS_QuestSuccess_Military</defName>
+    <label>military operation completed</label>
+  </HistoryEventDef>
+
+  <HistoryEventDef>
+    <defName>DMS_QuestFailed_Military</defName>
+    <label>military operation failed</label>
+  </HistoryEventDef>
+
+  <!-- ── 任務結算:後勤與文書 ──────────────────────────────────── -->
+  <!-- DMS_SupplyChain / DMS_SupplyChain_Delivery / DMS_ProcessDocumentQuest -->
+  <HistoryEventDef>
+    <defName>DMS_QuestSuccess_Logistics</defName>
+    <label>supply contract fulfilled</label>
+  </HistoryEventDef>
+
+  <HistoryEventDef>
+    <defName>DMS_QuestFailed_Logistics</defName>
+    <label>supply contract defaulted</label>
+  </HistoryEventDef>
+
+  <!-- ── 任務結算:軍階與典禮 ──────────────────────────────────── -->
+  <!-- DMS_PromotionCeremony / DMS_OfficerTraining / DMS_CourtMartial -->
+  <HistoryEventDef>
+    <defName>DMS_QuestSuccess_Ceremony</defName>
+    <label>military formality observed</label>
+  </HistoryEventDef>
+
+  <HistoryEventDef>
+    <defName>DMS_QuestFailed_Ceremony</defName>
+    <label>military formality dishonored</label>
+  </HistoryEventDef>
+
+  <!-- ── 任務結算:封存科技 ────────────────────────────────────── -->
+  <!-- DMS_Stele / DMS_SteleKey_ImpactSite -->
+  <HistoryEventDef>
+    <defName>DMS_QuestSuccess_Occultech</defName>
+    <label>sealed technology recovered</label>
+  </HistoryEventDef>
+
+  <HistoryEventDef>
+    <defName>DMS_QuestFailed_Occultech</defName>
+    <label>sealed technology lost</label>
+  </HistoryEventDef>
+
+  <!-- 封存科技制裁造成好感度變動時的理由，顯示在「好感度變動：XXX」的訊息裡。
+       刻意不讓任何 precept 消費它：制裁本身已經是懲罰，不該再疊一層信仰心情。 -->
+  <HistoryEventDef>
+    <defName>DMS_OccultechResearched</defName>
+    <label>occultech research decoded</label>
+  </HistoryEventDef>
+
+  <!-- ── 行為事件 ─────────────────────────────────────────────── -->
+
+  <!-- 合成／培養出來的食物的 ingestible.ateEvent,目前掛在
+       DMS_CombatRation(C 口糧)與 DMS_Artiprotein(人工蛋白)上。
+       給「拒絕合成食品 / 堅持真食物」這類 precept 用。
+
+       限制:原版只在「直接吃下去」時觸發 ateEvent
+       (FoodUtility.ThoughtsFromIngesting 的 direct 分支)。
+       用人工蛋白煮成的餐點走的是 AddIngestThoughtsFromIngredient,
+       那條路只認原版寫死的 AteHumanMeatAsIngredient / AteFungusAsIngredient /
+       AteInsectMeatAsIngredient,不會讀 ingredient 的 ateEvent。
+       想涵蓋熟食要另外 patch。 -->
+  <HistoryEventDef>
+    <defName>DMS_AteSyntheticFood</defName>
+    <label>ate synthesized food</label>
+  </HistoryEventDef>
+
+  <!-- Fortified.AirSupportDef.historyEventOnTriggered。
+       涵蓋空襲、火炮打擊、迫擊砲打擊等所有間接火力呼叫。 -->
+  <HistoryEventDef>
+    <defName>DMS_CalledFireSupport</defName>
+    <label>called in fire support</label>
+  </HistoryEventDef>
+
+  <!-- DMS.MechBirthExtension.historyEventOnSuccess。 -->
+  <HistoryEventDef>
+    <defName>DMS_GestatedMech</defName>
+    <label>gestated an artificial organism</label>
+  </HistoryEventDef>
+
+  <!-- DMS.QuestPart_CourtVerdict 有罪判決。 -->
+  <HistoryEventDef>
+    <defName>DMS_MemberCourtMartialed</defName>
+    <label>member court-martialed</label>
+  </HistoryEventDef>
+
+</Defs>

--- DMS1/Defs/Misc/DMS_Huntdowns.xml

+++ DMS2/Defs/Misc/DMS_Huntdowns.xml

@@ -0,0 +1,42 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- 封存科技隱匿級的追殺令（Fortified.HuntdownDef）。由 GameComponent_OccultechSanction 在永久敵對時啟動、
+       軍事法庭結案時結束；SAGE 被摧毀時暫停（CompHuntBreaker）。
+       每 4~7 天對任一玩家據點發動一次艦隊襲擊，並確保手上有一份軍事法庭傳票、有機會派發 SAGE 節點任務。
+       Occulted-tier kill order. Started on permanent hostility, ended by the court-martial, suspended by SAGE kills.
+       Every 4~7 days a fleet raid hits a player home; each hunt also offers a court-martial and sometimes a SAGE site. -->
+  <Fortified.HuntdownDef>
+    <defName>DMS_OccultechHunt</defName>
+    <label>occultech kill order</label>
+    <workerClass>DMS.HuntdownWorker_Occultech</workerClass>
+    <faction>DMS_Army</faction>
+    <followGravship>false</followGravship>
+    <retargetPlayerHome>true</retargetPlayerHome>
+    <repeatWhileStaying>true</repeatWhileStaying>
+    <sendWarningLetter>false</sendWarningLetter>
+    <showAlert>false</showAlert>
+    <warningDelayRange>0~0</warningDelayRange>
+    <!-- 4~7 天 4~7 days -->
+    <raidDelayRange>240000~420000</raidDelayRange>
+    <waves>
+      <li>
+        <pointsMultiplier>1.25</pointsMultiplier>
+        <minPoints>300</minPoints>
+      </li>
+    </waves>
+    <questsOnWave>
+      <!-- 軍事法庭是解除永久敵對唯一的出路，每次追殺都確保有一份傳票。
+           The court-martial is the only way out, so every hunt makes sure one is on offer. -->
+      <li>
+        <quest>DMS_CourtMartial</quest>
+      </li>
+      <li>
+        <quest>DMS_FleetNetworkSite</quest>
+        <chance>0.35</chance>
+        <siteThreatPoints>true</siteThreatPoints>
+      </li>
+    </questsOnWave>
+  </Fortified.HuntdownDef>
+
+</Defs>

