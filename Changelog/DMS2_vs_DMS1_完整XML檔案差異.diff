+</Defs>

--- DMS1/NewContent/Defs/Things_Item/DMS_Item_Subsonic.xml

+++ DMS2/NewContent/Defs/Things_Item/DMS_Item_Subsonic.xml

@@ -0,0 +1,339 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+  <!-- ==================================================================== -->
+  <!-- 封存檔案 I 級：次聲波基礎（DMS_Occultech_Subsonic）的物品類解鎖物。      -->
+  <!-- 脈衝邏輯共用 DMS.SubsonicUtility：只作用於血肉生物，機兵免疫。           -->
+  <!-- 建築類（次聲波塔、爆破探勘裝置）見 Things_Building/DMS_Buildings_Subsonic.xml -->
+  <!-- ==================================================================== -->
+
+  <!-- 次聲波創傷：每次脈衝疊加嚴重度，約兩小時內自然消退。疊到最高段足以痛到休克。 -->
+  <HediffDef>
+    <defName>DMS_SubsonicTrauma</defName>
+    <label>infrasonic trauma</label>
+    <description>Tuned infrasound has set this creature's inner ear and viscera resonating. It causes nausea, disorientation and deep, diffuse pain that no wound explains. The keener a creature's hearing, the harder it is hit; a deaf creature is unaffected. Repeated exposure stacks up quickly, and at its worst the pain alone is enough to cause shock.\n\nThe effect fades on its own within a couple of hours.</description>
+    <hediffClass>HediffWithComps</hediffClass>
+    <defaultLabelColor>(0.8, 0.8, 0.35)</defaultLabelColor>
+    <isBad>true</isBad>
+    <makesSickThought>true</makesSickThought>
+    <initialSeverity>0.01</initialSeverity>
+    <maxSeverity>1</maxSeverity>
+    <comps>
+      <li Class="HediffCompProperties_SeverityPerDay">
+        <severityPerDay>-12</severityPerDay>
+      </li>
+    </comps>
+    <stages>
+      <li>
+        <label>discomfort</label>
+        <painOffset>0.1</painOffset>
+        <capMods>
+          <li>
+            <capacity>Consciousness</capacity>
+            <offset>-0.05</offset>
+          </li>
+          <li>
+            <capacity>Hearing</capacity>
+            <offset>-0.1</offset>
+          </li>
+        </capMods>
+      </li>
+      <li>
+        <minSeverity>0.3</minSeverity>
+        <label>disoriented</label>
+        <painOffset>0.25</painOffset>
+        <vomitMtbDays>0.05</vomitMtbDays>
+        <statOffsets>
+          <ShootingAccuracyPawn>-0.3</ShootingAccuracyPawn>
+        </statOffsets>
+        <capMods>
+          <li>
+            <capacity>Consciousness</capacity>
+            <offset>-0.15</offset>
+          </li>
+          <li>
+            <capacity>Manipulation</capacity>
+            <offset>-0.2</offset>
+          </li>
+          <li>
+            <capacity>Moving</capacity>
+            <offset>-0.2</offset>
+          </li>
+          <li>
+            <capacity>Hearing</capacity>
+            <offset>-0.3</offset>
+          </li>
+        </capMods>
+      </li>
+      <li>
+        <minSeverity>0.7</minSeverity>
+        <label>agonizing</label>
+        <painOffset>0.5</painOffset>
+        <vomitMtbDays>0.02</vomitMtbDays>
+        <statOffsets>
+          <ShootingAccuracyPawn>-0.5</ShootingAccuracyPawn>
+        </statOffsets>
+        <capMods>
+          <li>
+            <capacity>Consciousness</capacity>
+            <offset>-0.3</offset>
+          </li>
+          <li>
+            <capacity>Manipulation</capacity>
+            <offset>-0.4</offset>
+          </li>
+          <li>
+            <capacity>Moving</capacity>
+            <offset>-0.4</offset>
+          </li>
+          <li>
+            <capacity>Hearing</capacity>
+            <offset>-0.6</offset>
+          </li>
+        </capMods>
+      </li>
+    </stages>
+  </HediffDef>
+
+  <!-- 聽覺器官損傷：每次脈衝對每個 HearingSource 部位各打一次。
+       armorCategory = Blunt，走 DamageWorker_AddInjury，頭盔（覆蓋耳朵的頭部裝備）與天生鈍器護甲會先抵擋；
+       不用原版 Blunt 的 DamageWorker_Blunt，免得多出內傷擴散與擊暈。 -->
+  <DamageDef>
+    <defName>DMS_InfrasoundRupture</defName>
+    <label>infrasonic rupture</label>
+    <workerClass>DamageWorker_AddInjury</workerClass>
+    <armorCategory>Blunt</armorCategory>
+    <externalViolence>true</externalViolence>
+    <makesBlood>false</makesBlood>
+    <buildingDamageFactor>0</buildingDamageFactor>
+    <hediff>DMS_InfrasoundRupture</hediff>
+    <hediffSolid>Crack</hediffSolid>
+    <overkillPctToDestroyPart>0.4~1.0</overkillPctToDestroyPart>
+    <deathMessage>{0} has been killed by infrasound.</deathMessage>
+  </DamageDef>
+
+  <HediffDef ParentName="InjuryBase">
+    <defName>DMS_InfrasoundRupture</defName>
+    <label>infrasonic rupture</label>
+    <labelNoun>an infrasonic rupture</labelNoun>
+    <description>Tissue torn apart from the inside by resonating infrasound. Left untreated, it can scar into permanent hearing loss.</description>
+    <comps>
+      <li Class="HediffCompProperties_TendDuration">
+        <labelTendedWell>treated</labelTendedWell>
+        <labelTendedWellInner>treated</labelTendedWellInner>
+        <labelSolidTendedWell>repaired</labelSolidTendedWell>
+      </li>
+      <li Class="HediffCompProperties_Infecter">
+        <infectionChance>0.05</infectionChance>
+      </li>
+      <li Class="HediffCompProperties_GetsPermanent">
+        <permanentLabel>infrasonic scarring</permanentLabel>
+      </li>
+    </comps>
+    <injuryProps>
+      <painPerSeverity>0.0125</painPerSeverity>
+      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
+      <bleedRate>0.005</bleedRate>
+      <canMerge>true</canMerge>
+      <destroyedLabel>Ruptured</destroyedLabel>
+    </injuryProps>
+  </HediffDef>
+
+  <!-- ==================================================================== -->
