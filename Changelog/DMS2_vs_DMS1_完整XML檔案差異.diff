+        <li>image->[PAWN_nameFull] being carried away from a [PRODUCT_label] [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] reaching toward a [PRODUCT_label] [circumstance_group]</li>
+        <li>circumstance_phrase->with visible exhaustion</li>
+        <li>circumstance_phrase->with visible exhaustion</li>
+        <li>circumstance_phrase->with a [AdjectiveAngsty] expression</li>
+        <li>circumstance_phrase->while covered with [Gore]</li>
+        <li>circumstance_phrase->without emotion or expression</li>
+        <li>desc_sentence->The [PRODUCT_label] towers over [PAWN_nameDef].</li>
+        <li>desc_sentence->The [PRODUCT_label] is still wet.</li>
+        <li>desc_sentence->[Gore] covers the ground.</li>
+        <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s watch in silence.</li>
+        <li>desc_sentence->[PAWN_nameDef] wears a [AdjectiveAngsty] expression.</li>
+        <li>desc_sentence->In the distance, a [PersonJob] observes.</li>
+      </rulesStrings>
+    </rulePack>
+  </TaleDef>
+
+  <!-- ── 5. 孕育失敗 ──────────────────────────────────────────────
+       觸發:DMS.MechBirthExtension.taleOnFailure。
+       ──────────────────────────────────────────────────────────── -->
+  <TaleDef>
+    <defName>DMS_Tale_MechGestationFailed</defName>
+    <label>gestation failed</label>
+    <taleClass>Tale_SinglePawn</taleClass>
+    <type>Volatile</type>
