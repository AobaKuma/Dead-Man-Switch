+++ DMS2/NewContent/Defs/Vault/DMS_Vault_Rooms.xml

@@ -0,0 +1,620 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       DMS 軍事儲存庫：房間
+       DMS military storage vault: rooms
+
+       所有填充物都是 DMS 自己的廢棄建築（見 DMS_Vault_Prefabs.xml），
+       兩個關鍵房間另外會蓋 FFF 預製塊（見 DMS_Vault_Structures.xml）。
+       Everything here fills from DMS's own ruined buildings; the two key rooms
+       additionally stamp a hand-authored FFF block when they have the space.
+       ============================================================ -->
+
+  <!-- 大廳長廊。串起所有房間的主幹道：中線鋪地板與電纜（電源在檢修通道的密室裡），
+       沿途設哨站（掩體 + 震動感測器），哨戒砲放在走廊角落，兩端牆上裝順著走廊看的攝影機。
+       各項設施在 ModExtension_VaultSecurity 裡指定，留空就不生成那一類。
+       Main hall. The spine that links every room: floored, wired centre strip (powered from the maintenance
+       tunnels' secret rooms), checkpoints (cover + seismic sensor) along the way, sentries in the corridor
+       corners, and a camera on each end wall looking down the corridor. Fixtures come from
+       ModExtension_VaultSecurity; leave one empty to skip that kind. -->
+  <LayoutRoomDef>
+    <defName>DMS_VaultMainHall</defName>
+    <roomContentsWorkerType>DMS.RoomContents_VaultMainHall</roomContentsWorkerType>
+    <dontDestroyWallsDoors>true</dontDestroyWallsDoors>
+    <isValidPlayerSpawnRoom>false</isValidPlayerSpawnRoom>
+    <prefabs>
+      <DMS_Prefab_HallDebris>
+        <countPerTenEdgeCells>0.5</countPerTenEdgeCells>
+        <minMaxRange>0~3</minMaxRange>
+      </DMS_Prefab_HallDebris>
+      <DMS_Prefab_VentBank>
+        <countPerTenEdgeCells>0.3</countPerTenEdgeCells>
+        <minMaxRange>0~2</minMaxRange>
+      </DMS_Prefab_VentBank>
+    </prefabs>
+    <modExtensions>
+      <li Class="DMS.ModExtension_VaultSecurity">
+        <!-- 內部淨寬 5：哨站 3 格寬，兩側各留一條通道。Interior width 5: a 3-wide checkpoint plus a lane each side. -->
+        <corridorExpansion>3</corridorExpansion>
+        <stripTerrain>Concrete</stripTerrain>
+
+        <!-- 暗裝電纜壓在走廊整圈牆線下，不走中線。Hidden conduit under the corridor's wall lines, not down the centre. -->
+        <conduitDef>HiddenConduit</conduitDef>
+        <conduitAlongWalls>true</conduitAlongWalls>
+        <substationDef>DMS_SubstationCabinet_Wall</substationDef>
+        <!-- 配電盤改放檢修通道（見 DMS_MilitaryVault 的 ModExtension_VaultTunnels）。The substation lives in a maintenance tunnel instead. -->
+        <wallSubstation>false</wallSubstation>
+
+        <barricadeDef>Barricade</barricadeDef>
+        <barricadeStuff>Steel</barricadeStuff>
+        <turretDef>DMS_Turret_Sentry</turretDef>
+        <!-- 每座哨戒砲 35% 換成報廢品。Each sentry has a 35% chance of being a wreck. -->
+        <wreckedTurretDef>DMS_Wreckage_SentryGun</wreckedTurretDef>
+        <turretWreckChance>0.35</turretWreckChance>
+        <!-- 砲塔不放哨站，改放走廊角落（死巷、樞紐臂末端），數量也少很多。
+             No turrets at the checkpoints; they go in the corridor corners (dead ends, hub arm ends), and far fewer. -->
+        <checkpointTurrets>false</checkpointTurrets>
+        <cornerTurretChance>0.35</cornerTurretChance>
+        <maxCornerTurretsPerRect>1</maxCornerTurretsPerRect>
+        <sensorDef>DMS_Building_Sensor</sensorDef>
+        <nestDef>DMS_Building_FPVNest</nestDef>
+        <nestChance>0.5</nestChance>
+        <!-- 哨站旁靠牆的警戒次聲波塔。Security infrasonic emitter against the wall beside a checkpoint. -->
+        <subsonicEmitterDef>DMS_Building_SubsonicEmitter_Security</subsonicEmitterDef>
+        <subsonicEmitterChance>0.35</subsonicEmitterChance>
+        <checkpointSpacing>14</checkpointSpacing>
+        <maxCheckpointsPerRect>2</maxCheckpointsPerRect>
+
+        <cameraDef>DMS_Building_Camera</cameraDef>
+        <initialBatteryPct>1</initialBatteryPct>
+      </li>
+    </modExtensions>
+  </LayoutRoomDef>
+
+  <!-- 入口檢查點。版面有 checkpointChance 的機率在房間與走廊之間夾一間（見各版面的 ModExtension_VaultLayout），
+       填充時從 DMS_Room_Checkpoint_A~D 挑一張適合後面那間房的蓋上，牆、門與開口照結構改寫，從走廊只能穿過它進出後面的房間。
+       只由版面指定，不會被隨機抽到；檢修通道、控制台與封鎖中控都不會選它。
+       Entrance checkpoint. With checkpointChance the layout slips one between a room and its corridor (see each
+       layout's ModExtension_VaultLayout); at fill time one of DMS_Room_Checkpoint_A~D suited to the room behind is
+       stamped, its walls, doors and openings rewritten from the structure, so it is the only way in from the corridor.
+       Only ever placed by the layout, never
+       rolled; tunnels, consoles and the lockdown controller all skip it. -->
+  <LayoutRoomDef>
+    <defName>DMS_VaultCheckpoint</defName>
+    <roomContentsWorkerType>DMS.RoomContents_VaultCheckpoint</roomContentsWorkerType>
+    <dontPlaceRandomly>true</dontPlaceRandomly>
+    <dontDestroyWallsDoors>true</dontDestroyWallsDoors>
+    <isValidPlayerSpawnRoom>false</isValidPlayerSpawnRoom>
+    <spawnJunk>false</spawnJunk>
+    <modExtensions>
+      <li Class="DMS.ModExtension_VaultCheckpoint">
+        <!-- 依各結構的 baseWeight（預設 1）抽一張；全部要一樣大。One is picked by each structure's baseWeight (default 1); all must be the same size. -->
+        <structures>
+          <li>DMS_Room_Checkpoint_A</li>
+          <li>DMS_Room_Checkpoint_B</li>
+          <li>DMS_Room_Checkpoint_C</li>
+          <li>DMS_Room_Checkpoint_D</li>
+        </structures>
+        <!-- 結構不帶內容物，交給 FFF 的 Task_FillStorage：貨架放一輪地下倉庫的雜貨（見 DMS_Vault_Loot.xml），
+             書櫃放幾本隨機的書；每座貨架與書櫃各有 fillChance 的機率。
+             The structures carry no contents; FFF's Task_FillStorage puts one round of the underground stores'
+             sundries on the shelves (see DMS_Vault_Loot.xml) and a few random books in the bookcases, each shelf
+             and bookcase with fillChance. -->
+        <shelfLoot>DMS_UnderMapShelfLoot</shelfLoot>
+        <shelfBatches>1~1</shelfBatches>
+        <fillChance>0.8</fillChance>
+        <booksPerBookcase>1~4</booksPerBookcase>
+      </li>
+    </modExtensions>
+  </LayoutRoomDef>
+
+  <!-- 電梯廳。放出口電梯、設定玩家出生點。玩家的初始房間，不放砲塔或警戒建築；
+       牆上的配電盤只是電源，不會攻擊。
+       Elevator lobby: exit car and player spawn spot. The starting room, so no turrets or security
+       fixtures here; the wall substations are just power, they never attack. -->
+  <LayoutRoomDef>
+    <defName>DMS_VaultEntranceHall</defName>
+    <roomContentsWorkerType>DMS.RoomContents_VaultEntrance</roomContentsWorkerType>
+    <!-- 必出房間，門檻跟其他必出房間一樣壓在 9，免得被它們先搶走大房間後放不下。
+         5x5 的出口電梯在 9x9 裡塞不下三格 padding，worker 會自己把 padding 縮到放得下為止。
+         Required room; kept at 9 like the other required rooms so they can't starve it of a rect.
+         The 5x5 exit car can't take 3 cells of padding in a 9x9; the worker shrinks it as needed. -->
+    <minSingleRectWidth>9</minSingleRectWidth>
+    <minSingleRectHeight>9</minSingleRectHeight>
+    <prefabs>
+      <DMS_Prefab_SubstationBank>
+        <countPerTenEdgeCells>0.5</countPerTenEdgeCells>
+        <minMaxRange>0~1</minMaxRange>
+      </DMS_Prefab_SubstationBank>
+      <DMS_Prefab_VentBank>
+        <countPerTenEdgeCells>1</countPerTenEdgeCells>
+        <minMaxRange>0~2</minMaxRange>
+      </DMS_Prefab_VentBank>
+      <DMS_Prefab_RestNook_Ruined>
+        <countPerTenEdgeCells>0.5</countPerTenEdgeCells>
+        <minMaxRange>0~1</minMaxRange>
+      </DMS_Prefab_RestNook_Ruined>
+      <DMS_Prefab_SupplyCache_Edge>
+        <countRange>0~1</countRange>
+      </DMS_Prefab_SupplyCache_Edge>
+      <!-- 電梯口的值班桌。The duty desk by the lift. -->
+      <DMS_Prefab_ConsoleDesk_Edge>
+        <countRange>0~1</countRange>
+      </DMS_Prefab_ConsoleDesk_Edge>
+    </prefabs>
+  </LayoutRoomDef>
+
+  <!-- 軍械庫。貨架來自 FFF 預製塊（房間夠大時）或程序化排列，內容全部來自
+       DMS_LogisticTerminal 這組 ThingSetMaker。
+       Armory. Shelves from the prefab block or procedural rows; contents from the DMS loot table. -->
+  <LayoutRoomDef>
+    <defName>DMS_VaultArmory</defName>
+    <roomContentsWorkerType>DMS.RoomContents_VaultArmory</roomContentsWorkerType>
+    <thingSetMakerDef>DMS_LogisticTerminal</thingSetMakerDef>
+    <minSingleRectWidth>9</minSingleRectWidth>
+    <minSingleRectHeight>9</minSingleRectHeight>
+    <prefabs>
+      <DMS_Prefab_SupplyCache>
+        <countRange>1~2</countRange>
+      </DMS_Prefab_SupplyCache>
+      <DMS_Prefab_SupplyCache_Edge>
+        <countPerTenEdgeCells>0.5</countPerTenEdgeCells>
+        <minMaxRange>0~2</minMaxRange>
+      </DMS_Prefab_SupplyCache_Edge>
+      <DMS_Prefab_CrateCluster>
+        <countRange>0~1</countRange>
+      </DMS_Prefab_CrateCluster>
+      <DMS_Prefab_SubstationBank>
+        <countPerTenEdgeCells>0.5</countPerTenEdgeCells>
+        <minMaxRange>0~1</minMaxRange>
+      </DMS_Prefab_SubstationBank>
+      <!-- 槍械保養台與被撬開的保全貨櫃；貨架擺滿時放不下就算了。
+           A weapons bench and a pried-open security container; skipped when the shelving leaves no room. -->
+      <DMS_Prefab_MaintenanceBench_Edge>
+        <countRange>0~1</countRange>
+      </DMS_Prefab_MaintenanceBench_Edge>
+      <DMS_Prefab_SecurityContainer_Ruined>
+        <countRange>0~1</countRange>
+      </DMS_Prefab_SecurityContainer_Ruined>
+    </prefabs>
+    <scatter>
+      <Filth_OilSmear>
+        <groupsPerHundredCells>0~1</groupsPerHundredCells>
+        <itemsPerGroup>1~3</itemsPerGroup>
+        <groupDistRange>1~3</groupDistRange>
+      </Filth_OilSmear>
+    </scatter>
+  </LayoutRoomDef>
+
+  <!-- 機兵封存艙間。整間的重點就是那些搖籃；掉落物少，威脅集中在艙裡。
+       Mech bay. The cradles are the point: little loose loot, all the threat is inside them. -->
+  <LayoutRoomDef>
+    <defName>DMS_VaultMechBay</defName>
+    <roomContentsWorkerType>DMS.RoomContents_VaultMechBay</roomContentsWorkerType>
+    <!-- 必出房間（countRange 1），門檻放太高會找不到夠大的矩形而生成失敗。
+         Required room: keep the size gate low enough that the layout can always satisfy it. -->
+    <minSingleRectWidth>9</minSingleRectWidth>
+    <minSingleRectHeight>9</minSingleRectHeight>
+    <prefabs>
+      <DMS_Prefab_RoninWreck>
+        <countRange>0~1</countRange>
+      </DMS_Prefab_RoninWreck>
+      <DMS_Prefab_WreckScatter>
+        <countPerHundredCells>1</countPerHundredCells>
+        <minMaxRange>0~1</minMaxRange>
+      </DMS_Prefab_WreckScatter>
+      <DMS_Prefab_MaintenanceBench_Edge>
+        <countRange>0~1</countRange>
+      </DMS_Prefab_MaintenanceBench_Edge>
+    </prefabs>
+    <!-- 牆邊一兩座遠古充電座（Core，純裝飾，不能充電）。
+         An ancient recharger or two along the walls (Core; decoration only, they don't charge). -->
+    <fillEdges>
