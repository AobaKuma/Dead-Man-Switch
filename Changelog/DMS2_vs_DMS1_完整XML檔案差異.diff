+  <!-- EN: right fist -->
+  <DMS_Mech_Gravekeeper_Stugna.tools.right_fist.label>右拳</DMS_Mech_Gravekeeper_Stugna.tools.right_fist.label>
+  <!-- EN: head -->
+  <DMS_Mech_Gravekeeper_Stugna.tools.head.label>頭部</DMS_Mech_Gravekeeper_Stugna.tools.head.label>
+
+  <!-- EN: Sepulturero -->
+  <DMS_Mech_Gravekeeper_Sepulturero.label>掘墓人</DMS_Mech_Gravekeeper_Sepulturero.label>
+  <!-- EN: A highly intelligent large automatroid, deployed by the colonial fleet... -->
