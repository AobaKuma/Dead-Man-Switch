+        <filter>
+          <thingDefs>
+            <li>ComponentStamped</li>
+          </thingDefs>
+        </filter>
+        <count>2</count>
+      </li>
+    </ingredients>
+  </RecipeDef>
+</Defs>

--- DMS1/Biotech/Defs/DMS_Recipes_MechGestator_Gravekeeper.xml

