+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <SitePartDef>
+    <defName>DMS_DecoySite</defName>
+    <label>remnant relay station</label>
+    <description>A decommisioned remnant signal-relay station. Its transmitter array can be repurposed to lure high-value automatroid units, if its garrison is dealt with first.</description>
+    <workerClass>Fortified.SitePartWorker_FFF_TimedHostileSite</workerClass>
+    <modExtensions>
