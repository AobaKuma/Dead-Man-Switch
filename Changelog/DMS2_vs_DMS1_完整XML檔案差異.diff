--- DMS1/Ideology/Defs/DMS_Memes.xml

+++ DMS2/Ideology/Defs/DMS_Memes.xml

@@ -0,0 +1,63 @@

+<?xml version="1.0" encoding="utf-8" ?>
+<Defs>
+
+  <!-- ============================================================
+       指揮鏈 / Chain of command
+       DMS 唯一的 meme。刻意只做一個:這個模組是軍事寫實內容包,
+       不是 Ideology 擴充,做太多 meme 會跟 VIE 之類的模組打架,
+       也會逼玩家為了用 DMS 的內容換掉整套信仰。
+
+       category 預設 Normal(0),impact 必須落在 1~3。
+       descriptionMaker 只有 structure meme 才是必填,這裡刻意不做
+       (那是幾百行的信仰起源敘述,翻譯成本遠大於效益)。
+       ============================================================ -->
+  <MemeDef>
+    <defName>DMS_Meme_ChainOfCommand</defName>
+    <label>chain of command</label>
+    <description>We are an army, discipline paramount, orders consistent.</description>
+    <iconPath>UI/Faction/ArmyFavor</iconPath>
+    <groupDef>Misc</groupDef>
+    <impact>2</impact>
+    <renderOrder>950</renderOrder>
+    <requireOne>
+      <li>
+        <li>DMS_Formality_Strict</li>
+      </li>
+      <li>
+        <li>DMS_Operations_Venerated</li>
+        <li>DMS_Operations_Necessary</li>
+      </li>
+    </requireOne>
+    <thingStyleCategories>
+      <li>
+        <category>DMS_Industrial</category>
+        <priority>1</priority>
+      </li>
+    </thingStyleCategories>
+    <generalRules>
+      <rulesStrings>
+        <li>memeAdjective->regimental</li>
+        <li>memeAdjective->uniformed</li>
+        <li>memeAdjective->disciplined</li>
+        <li>memeCreed->command</li>
+        <li>memeCreed->service</li>
+        <li>memeCreed->regiment</li>
+        <li>memeHyphenPrefix->rank</li>
+        <li>memeHyphenPrefix->drill</li>
+        <li>memeConcept->duty</li>
+        <li>memeConcept->discipline</li>
+        <li>memeConcept->command</li>
+        <li>memeConcept->rank</li>
+        <li>memeConcept->orders</li>
+        <li>memeLeaderNoun->commander</li>
+        <li>memeLeaderNoun->colonel</li>
+        <li>memeLeaderNoun->marshal</li>
+        <li>memeLeaderNoun->captain</li>
+        <li>memeMoralist->adjutant</li>
+        <li>memeMoralist->provost</li>
+        <li>memeMoralist->inspector</li>
+      </rulesStrings>
+    </generalRules>
+  </MemeDef>
+
+</Defs>

--- DMS1/Ideology/Defs/DMS_Precepts_Formality.xml

+++ DMS2/Ideology/Defs/DMS_Precepts_Formality.xml

@@ -0,0 +1,173 @@

+<?xml version="1.0" encoding="utf-8" ?>
+<Defs>
+
+  <!-- ============================================================
+       軍務儀典 / Military formality
+       消費 DMS_QuestSuccess_Ceremony、DMS_QuestFailed_Ceremony、
+       DMS_MemberCourtMartialed。
+
+       三個事件都沒有 Doer:前兩個來自 QuestScriptDef,第三個是
+       QuestPart_CourtVerdict 刻意不帶 Doer 記錄的(被告在服刑期間
+       被移出地圖,帶了 Doer 反而全殖民地都收不到消息)。
+       所以這裡一律用 KnowsMemoryThought,不能用 SelfTookMemoryThought,
+       也不能設 doerMustBeMyFaction。
+       ============================================================ -->
+
+  <IssueDef>
+    <defName>DMS_Issue_Formality</defName>
+    <label>military formality</label>
+    <iconPath>UI/Issues/Apostasy</iconPath>
+  </IssueDef>
+
+  <!-- ── 嚴格:授銜、完訓、軍法都是神聖的 ──────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_Formality_Strict</defName>
+    <issue>DMS_Issue_Formality</issue>
+    <label>strict</label>
+    <description>Discipline, ceremony and military law are all part of keeping order. To break their forms is shameful.</description>
+    <impact>High</impact>
+    <displayOrderInIssue>10</displayOrderInIssue>
+    <displayOrderInImpact>1000</displayOrderInImpact>
+    <associatedMemes>
+      <li>DMS_Meme_ChainOfCommand</li>
+    </associatedMemes>
+    <comps>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestSuccess_Ceremony</eventDef>
+        <thought>DMS_Thought_Ceremony_Strict</thought>
+      </li>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestFailed_Ceremony</eventDef>
+        <thought>DMS_Thought_CeremonyFailed_Strict</thought>
+      </li>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_MemberCourtMartialed</eventDef>
+        <thought>DMS_Thought_CourtMartialed_Strict</thought>
+      </li>
+      <li Class="PreceptComp_DevelopmentPoints">
+        <eventDef>DMS_QuestSuccess_Ceremony</eventDef>
+        <points>5</points>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ── 隨便:誰扛槍誰說話(預設) ─────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_Formality_Casual</defName>
+    <issue>DMS_Issue_Formality</issue>
+    <label>casual</label>
+    <description>Rank is just a title. Ceremony is just procedure.</description>
+    <impact>Low</impact>
+    <displayOrderInIssue>20</displayOrderInIssue>
+    <displayOrderInImpact>500</displayOrderInImpact>
+    <defaultSelectionWeight>1</defaultSelectionWeight>
+    <comps>
+      <li Class="PreceptComp_DevelopmentPoints">
+        <eventDef>DMS_QuestSuccess_Ceremony</eventDef>
+        <points>1</points>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ── 鄙夷:軍階是壓迫的工具 ────────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_Formality_Contemptuous</defName>
+    <issue>DMS_Issue_Formality</issue>
+    <label>contemptuous</label>
+    <description>Military law is the oppressor's instrument of violence. To serve as the oppressor's executioner is shameful.</description>
+    <impact>Medium</impact>
+    <displayOrderInIssue>30</displayOrderInIssue>
+    <displayOrderInImpact>700</displayOrderInImpact>
+    <conflictingMemes>
+      <li>DMS_Meme_ChainOfCommand</li>
+    </conflictingMemes>
+    <comps>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestSuccess_Ceremony</eventDef>
+        <thought>DMS_Thought_Ceremony_Contemptuous</thought>
+      </li>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_MemberCourtMartialed</eventDef>
+        <thought>DMS_Thought_CourtMartialed_Contemptuous</thought>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ============================ 心情 ============================ -->
+
+  <ThoughtDef>
+    <defName>DMS_Thought_Ceremony_Strict</defName>
+    <thoughtClass>Thought_Memory</thoughtClass>
+    <doNotApplyToQuestLodgers>true</doNotApplyToQuestLodgers>
+    <durationDays>8</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>ceremony observed</label>
+        <description>We observed the forms properly, in front of an official witness. That still means something.</description>
+        <baseMoodEffect>5</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_CeremonyFailed_Strict</defName>
+    <thoughtClass>Thought_Memory</thoughtClass>
+    <doNotApplyToQuestLodgers>true</doNotApplyToQuestLodgers>
+    <durationDays>8</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>ceremony failed</label>
+        <description>We could not even get through a ceremony. It shames all of us.</description>
+        <baseMoodEffect>-10</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_CourtMartialed_Strict</defName>
+    <thoughtClass>Thought_Memory</thoughtClass>
+    <doNotApplyToQuestLodgers>true</doNotApplyToQuestLodgers>
+    <durationDays>10</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>member court-martialed</label>
+        <description>One of our officers was convicted and we could not answer it. We all carry that.</description>
+        <baseMoodEffect>-6</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_Ceremony_Contemptuous</defName>
+    <thoughtClass>Thought_Memory</thoughtClass>
+    <doNotApplyToQuestLodgers>true</doNotApplyToQuestLodgers>
+    <durationDays>6</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>ceremony observed</label>
+        <description>Someone was handed a rank and permission to give orders. It is just another leash.</description>
+        <baseMoodEffect>-4</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_CourtMartialed_Contemptuous</defName>
+    <thoughtClass>Thought_Memory</thoughtClass>
+    <doNotApplyToQuestLodgers>true</doNotApplyToQuestLodgers>
+    <durationDays>6</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>member court-martialed</label>
+        <description>A fleet court ground one of ours down. Sooner or later it comes for the rest of us.</description>
+        <baseMoodEffect>-4</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+</Defs>

--- DMS1/Ideology/Defs/DMS_Precepts_Operations.xml

+++ DMS2/Ideology/Defs/DMS_Precepts_Operations.xml

@@ -0,0 +1,201 @@

+<?xml version="1.0" encoding="utf-8" ?>
+<Defs>
+
+  <!-- ============================================================
+       軍事行動 / Military operations
+       消費 DMS_QuestSuccess_Military、DMS_QuestFailed_Military、
+       DMS_CalledFireSupport。
+
+       注意事項:
+       1. DMS_QuestSuccess_Military / DMS_QuestFailed_Military 由
+          QuestScriptDef 的 successHistoryEvent 記錄,事件裡沒有 Doer。
+          沒有 Doer 時 IdeoUtility 會通知「所有自由殖民者」,所以
+          KnowsMemoryThought 會全體生效，但也因此不能用
+          SelfTookMemoryThought(它會直接 GetArg<Pawn>(Doer) 而爆掉),
+          也不能設 doerMustBeMyFaction(設了就永遠不觸發)。
+       2. DMS_CalledFireSupport 有 Doer,所以 Knows 只會傳到
+          呼叫者所在的那張地圖(或商隊),這正是我們要的。
+       ============================================================ -->
+
+  <IssueDef>
+    <defName>DMS_Issue_Operations</defName>
+    <label>military operations</label>
+    <iconPath>UI/Issues/Raiding</iconPath>
+  </IssueDef>
+
+  <!-- ── 崇尚:打仗是這個群體存在的理由 ─────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_Operations_Venerated</defName>
+    <issue>DMS_Issue_Operations</issue>
+    <label>venerated</label>
+    <description>The unit exists to be used. A completed operation is the highest thing we do, and a failed one is a wound the whole colony carries. Fire support is not something to apologize for.</description>
+    <impact>High</impact>
+    <displayOrderInIssue>10</displayOrderInIssue>
+    <displayOrderInImpact>1000</displayOrderInImpact>
+    <associatedMemes>
+      <li>DMS_Meme_ChainOfCommand</li>
+    </associatedMemes>
+    <comps>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestSuccess_Military</eventDef>
+        <thought>DMS_Thought_OperationSuccess_Venerated</thought>
+      </li>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestFailed_Military</eventDef>
+        <thought>DMS_Thought_OperationFailed_Venerated</thought>
+      </li>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_CalledFireSupport</eventDef>
+        <thought>DMS_Thought_FireSupport_Venerated</thought>
+      </li>
+      <li Class="PreceptComp_DevelopmentPoints">
+        <eventDef>DMS_QuestSuccess_Military</eventDef>
+        <points>4</points>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ── 必要之惡:該做就做(預設) ──────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_Operations_Necessary</defName>
+    <issue>DMS_Issue_Operations</issue>
+    <label>necessary</label>
+    <description>Nobody enjoys it. We do it because the alternative is worse, and we expect it to be done properly when it has to be done.</description>
+    <impact>Low</impact>
+    <displayOrderInIssue>20</displayOrderInIssue>
+    <displayOrderInImpact>500</displayOrderInImpact>
+    <defaultSelectionWeight>1</defaultSelectionWeight>
+    <associatedMemes>
+      <li>DMS_Meme_ChainOfCommand</li>
+    </associatedMemes>
+    <comps>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestFailed_Military</eventDef>
+        <thought>DMS_Thought_OperationFailed_Necessary</thought>
+      </li>
+      <li Class="PreceptComp_DevelopmentPoints">
+        <eventDef>DMS_QuestSuccess_Military</eventDef>
+        <points>2</points>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ── 憎惡:拒絕主動用兵 ────────────────────────────────────────
+       刻意不用 PreceptComp_UnwillingToDo:那會讓 pawn 直接拒絕執行,
+       在「玩家自己按按鈕呼叫火力支援」的情境等於純粹擋路。
+       改成每呼叫一次就付一次心情代價,由玩家自己決定要不要吃。
+       ──────────────────────────────────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_Operations_Abhorrent</defName>
+    <issue>DMS_Issue_Operations</issue>
+    <label>abhorrent</label>
+    <description>To call down fire on a target you cannot see is an abhorrent act. There is no telling what else is down there.</description>
+    <impact>High</impact>
+    <displayOrderInIssue>30</displayOrderInIssue>
+    <displayOrderInImpact>900</displayOrderInImpact>
+    <conflictingMemes>
+      <li>DMS_Meme_ChainOfCommand</li>
+    </conflictingMemes>
+    <comps>
+      <li Class="PreceptComp_SelfTookMemoryThought">
+        <eventDef>DMS_CalledFireSupport</eventDef>
+        <thought>DMS_Thought_FireSupport_Abhorrent_Self</thought>
+      </li>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_CalledFireSupport</eventDef>
+        <thought>DMS_Thought_FireSupport_Abhorrent_Knows</thought>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ============================ 心情 ============================ -->
+
+  <ThoughtDef>
+    <defName>DMS_Thought_OperationSuccess_Venerated</defName>
+    <durationDays>6</durationDays>
+    <stackLimit>3</stackLimit>
+    <stackedEffectMultiplier>0.6</stackedEffectMultiplier>
+    <stages>
+      <li>
+        <label>operation completed</label>
+        <description>We were given a job and we finished it. That is what we are for.</description>
+        <baseMoodEffect>6</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_OperationFailed_Venerated</defName>
+    <durationDays>6</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>operation failed</label>
+        <description>We were given a job and we did not finish it. There is no way to dress that up.</description>
+        <baseMoodEffect>-8</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_FireSupport_Venerated</defName>
+    <durationDays>2</durationDays>
+    <stackLimit>3</stackLimit>
+    <stackedEffectMultiplier>0.6</stackedEffectMultiplier>
+    <stages>
+      <li>
+        <label>fire on target</label>
+        <description>Somebody called it in and it landed where it was supposed to. Good.</description>
+        <baseMoodEffect>3</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_OperationFailed_Necessary</defName>
+    <durationDays>4</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>operation failed</label>
+        <description>We took the job and we did not deliver. Somebody is going to pay for that, and it probably will not be the people who gave the order.</description>
+        <baseMoodEffect>-4</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_FireSupport_Abhorrent_Self</defName>
+    <durationDays>6</durationDays>
+    <stackLimit>2</stackLimit>
+    <nullifyingTraits>
+      <li>Psychopath</li>
+      <li>Bloodlust</li>
+    </nullifyingTraits>
+    <stages>
+      <li>
+        <label>I called it in</label>
+        <description>I called saturation fire down on a target. Every stray round that landed is on me.</description>
+        <baseMoodEffect>-10</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_FireSupport_Abhorrent_Knows</defName>
+    <durationDays>4</durationDays>
+    <stackLimit>2</stackLimit>
+    <nullifyingTraits>
+      <li>Psychopath</li>
+      <li>Bloodlust</li>
+    </nullifyingTraits>
+    <stages>
+      <li>
+        <label>someone called it in</label>
+        <description>One of us called saturation fire down on a target nobody could see. Such things should never be done.</description>
+        <baseMoodEffect>-5</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+</Defs>

--- DMS1/Ideology/Defs/DMS_Precepts_SealedTech.xml

+++ DMS2/Ideology/Defs/DMS_Precepts_SealedTech.xml

@@ -0,0 +1,103 @@

+<?xml version="1.0" encoding="utf-8" ?>
+<Defs>
+
+  <!-- ============================================================
+       封存科技 / Sealed technology
+       消費 DMS_QuestSuccess_Occultech(石碑與撞擊點任務)。
+
+       Forbidden 這一檔跟模組現有的封存科技敘述是同一個立場:
+       那些 def 的收尾本來就是一段「經 ███ 及 ██ 之審批,列為
+       I 級封存技術」的公文。做一個信仰站在審批者那一邊,自洽。
+       ============================================================ -->
+
+  <IssueDef>
+    <defName>DMS_Issue_SealedTech</defName>
+    <label>sealed technology</label>
+    <iconPath>UI/Issues/Research</iconPath>
+  </IssueDef>
+
+  <!-- ── 崇尚:挖出封存科技是使命 ──────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_SealedTech_Venerated</defName>
+    <issue>DMS_Issue_SealedTech</issue>
+    <label>venerated</label>
+    <description>To unlock the unknown is the human instinct that drives progress.</description>
+    <impact>Medium</impact>
+    <displayOrderInIssue>10</displayOrderInIssue>
+    <displayOrderInImpact>800</displayOrderInImpact>
+    <comps>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestSuccess_Occultech</eventDef>
+        <thought>DMS_Thought_Occultech_Venerated</thought>
+      </li>
+      <li Class="PreceptComp_DevelopmentPoints">
+        <eventDef>DMS_QuestSuccess_Occultech</eventDef>
+        <points>8</points>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ── 可接受:有用就拿(預設) ──────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_SealedTech_Acceptable</defName>
+    <issue>DMS_Issue_SealedTech</issue>
+    <label>acceptable</label>
+    <description>Sealed technology is useful, but its risks still deserve caution.</description>
+    <impact>Low</impact>
+    <displayOrderInIssue>20</displayOrderInIssue>
+    <displayOrderInImpact>500</displayOrderInImpact>
+    <defaultSelectionWeight>1</defaultSelectionWeight>
+    <comps>
+      <li Class="PreceptComp_DevelopmentPoints">
+        <eventDef>DMS_QuestSuccess_Occultech</eventDef>
+        <points>3</points>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ── 禁忌:那些東西被封起來是有理由的 ──────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_SealedTech_Forbidden</defName>
+    <issue>DMS_Issue_SealedTech</issue>
+    <label>forbidden</label>
+    <description>Sealed technology was shelved for a reason, and we should never dig it back up.</description>
+    <impact>High</impact>
+    <displayOrderInIssue>30</displayOrderInIssue>
+    <displayOrderInImpact>900</displayOrderInImpact>
+    <comps>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_QuestSuccess_Occultech</eventDef>
+        <thought>DMS_Thought_Occultech_Forbidden</thought>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ============================ 心情 ============================ -->
+
+  <ThoughtDef>
+    <defName>DMS_Thought_Occultech_Venerated</defName>
+    <durationDays>15</durationDays>
+    <stackLimit>1</stackLimit>
+    <stages>
+      <li>
+        <label>sealed technology unlocked</label>
+        <description>We unlocked a piece of sealed technology that had been shelved and forgotten. Let them come and explain why we should not have.</description>
+        <baseMoodEffect>8</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_Occultech_Forbidden</defName>
+    <durationDays>15</durationDays>
+    <stackLimit>1</stackLimit>
+    <stages>
+      <li>
+        <label>sealed technology unlocked</label>
+        <description>We unlocked a piece of sealed technology that had been locked away. I hope we have not made an even worse mistake.</description>
+        <baseMoodEffect>-8</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+</Defs>

--- DMS1/Ideology/Defs/DMS_Precepts_SyntheticLife.xml

+++ DMS2/Ideology/Defs/DMS_Precepts_SyntheticLife.xml

@@ -0,0 +1,159 @@

+<?xml version="1.0" encoding="utf-8" ?>
+<Defs>
+
+  <!-- ============================================================
+       人造生命 / Synthetic life
+       消費 DMS_GestatedMech(孕育出人造生物體)與
+       DMS_AteSyntheticFood(C 口糧、人工蛋白)。
+
+       兩個事件都帶 Doer,所以 SelfTookMemoryThought 可用。
+       食物事件走的是 FoodUtility.AddThoughtsFromIdeo,那條路只認
+       PreceptComp_SelfTookMemoryThought(Thing.Ingested 記錄時
+       canApplySelfTookThoughts 是 false,但食物心情另外走這條)。
+
+       已知缺口:ateEvent 只在「直接吃下去」時觸發。用人工蛋白
+       煮成的餐點走 AddIngestThoughtsFromIngredient,那條路不讀
+       ingredient 的 ateEvent,要涵蓋熟食得另外 patch。
+       ============================================================ -->
+
+  <IssueDef>
+    <defName>DMS_Issue_SyntheticLife</defName>
+    <label>synthetic life</label>
+    <iconPath>UI/Issues/BodyModifications</iconPath>
+  </IssueDef>
+
+  <!-- ── 崇尚:人造生命比血肉更可靠 ────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_SyntheticLife_Venerated</defName>
+    <issue>DMS_Issue_SyntheticLife</issue>
+    <label>venerated</label>
+    <description>Flesh is a first draft. What comes out of a gestation pod was designed on purpose, and what comes out of a reaction chamber is food that was designed on purpose too.</description>
+    <impact>Medium</impact>
+    <displayOrderInIssue>10</displayOrderInIssue>
+    <displayOrderInImpact>800</displayOrderInImpact>
+    <comps>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_GestatedMech</eventDef>
+        <thought>DMS_Thought_Gestation_Venerated</thought>
+      </li>
+      <li Class="PreceptComp_SelfTookMemoryThought">
+        <eventDef>DMS_AteSyntheticFood</eventDef>
+        <thought>DMS_Thought_SyntheticFood_Venerated</thought>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ── 可接受:是工具(預設) ────────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_SyntheticLife_Acceptable</defName>
+    <issue>DMS_Issue_SyntheticLife</issue>
+    <label>acceptable</label>
+    <description>It is equipment that happens to be wet. Nobody needs to have feelings about equipment.</description>
+    <impact>Low</impact>
+    <displayOrderInIssue>20</displayOrderInIssue>
+    <displayOrderInImpact>500</displayOrderInImpact>
+    <defaultSelectionWeight>1</defaultSelectionWeight>
+  </PreceptDef>
+
+  <!-- ── 憎惡:用子宮長出機器是褻瀆 ────────────────────────────── -->
+  <PreceptDef>
+    <defName>DMS_SyntheticLife_Abhorrent</defName>
+    <issue>DMS_Issue_SyntheticLife</issue>
+    <label>abhorrent</label>
+    <description>A body is for carrying a person. Using one as a factory for something that was never going to be a person is the worst thing this technology has been put to, and eating what the same machines produce is not far behind.</description>
+    <impact>High</impact>
+    <displayOrderInIssue>30</displayOrderInIssue>
+    <displayOrderInImpact>900</displayOrderInImpact>
+    <comps>
+      <li Class="PreceptComp_SelfTookMemoryThought">
+        <eventDef>DMS_GestatedMech</eventDef>
+        <thought>DMS_Thought_Gestation_Abhorrent_Self</thought>
+      </li>
+      <li Class="PreceptComp_KnowsMemoryThought">
+        <eventDef>DMS_GestatedMech</eventDef>
+        <thought>DMS_Thought_Gestation_Abhorrent_Knows</thought>
+      </li>
+      <li Class="PreceptComp_SelfTookMemoryThought">
+        <eventDef>DMS_AteSyntheticFood</eventDef>
+        <thought>DMS_Thought_SyntheticFood_Abhorrent</thought>
+      </li>
+    </comps>
+  </PreceptDef>
+
+  <!-- ============================ 心情 ============================ -->
+
+  <ThoughtDef>
+    <defName>DMS_Thought_Gestation_Venerated</defName>
+    <durationDays>10</durationDays>
+    <stackLimit>2</stackLimit>
+    <stages>
+      <li>
+        <label>a pod was sealed</label>
+        <description>We used our own bodies to gestate something better than ourselves.</description>
+        <baseMoodEffect>6</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_SyntheticFood_Venerated</defName>
+    <durationDays>1</durationDays>
+    <stackLimit>1</stackLimit>
+    <stages>
+      <li>
+        <label>ate synthesized food</label>
+        <description>I ate synthesized food. Clean and precisely measured.</description>
+        <baseMoodEffect>2</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_Gestation_Abhorrent_Self</defName>
+    <durationDays>15</durationDays>
+    <stackLimit>1</stackLimit>
+    <nullifyingTraits>
+      <li>Psychopath</li>
+    </nullifyingTraits>
+    <stages>
+      <li>
+        <label>I carried that thing</label>
+        <description>My body gave birth to something that is not even alive.</description>
+        <baseMoodEffect>-12</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_Gestation_Abhorrent_Knows</defName>
+    <durationDays>10</durationDays>
+    <stackLimit>2</stackLimit>
+    <nullifyingTraits>
+      <li>Psychopath</li>
+    </nullifyingTraits>
+    <stages>
+      <li>
+        <label>we grew one of those</label>
+        <description>We are using living bodies as seedbeds. Such things are a desecration.</description>
+        <baseMoodEffect>-8</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+  <ThoughtDef>
+    <defName>DMS_Thought_SyntheticFood_Abhorrent</defName>
+    <durationDays>1</durationDays>
+    <stackLimit>1</stackLimit>
+    <nullifyingTraits>
+      <li>Ascetic</li>
+    </nullifyingTraits>
+    <stages>
+      <li>
+        <label>ate synthesized food</label>
+        <description>Something with not a single natural ingredient in it should never be eaten.</description>
+        <baseMoodEffect>-4</baseMoodEffect>
+      </li>
+    </stages>
+  </ThoughtDef>
+
+</Defs>

