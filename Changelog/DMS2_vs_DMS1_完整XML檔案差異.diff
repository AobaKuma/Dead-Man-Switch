+        <li>desc_sentence->No one in the room meets [PAWN_possessive] eyes.</li>
+        <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s watch in silence.</li>
+        <li>desc_sentence->In the distance, a [PersonJob] observes.</li>
+      </rulesStrings>
+    </rulePack>
+  </TaleDef>
+
+  <!-- ── 7. 軍法無罪 ──────────────────────────────────────────────
+       觸發:DMS.QuestPart_CourtVerdict 的無罪分支。
+       ──────────────────────────────────────────────────────────── -->
+  <TaleDef>
+    <defName>DMS_Tale_Acquitted</defName>
+    <label>acquitted</label>
+    <taleClass>Tale_SinglePawn</taleClass>
+    <type>Volatile</type>
+    <baseInterest>2</baseInterest>
+    <rulePack>
+      <rulesStrings>
+        <li>tale_noun->the acquittal of [PAWN_nameDef]</li>
+        <li>image->[PAWN_nameFull] walking out of a hearing room [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] shaking hands with an officer [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] standing before a panel of officers [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] straightening [PAWN_possessive] uniform [circumstance_group]</li>
+        <li>circumstance_phrase->without emotion or expression</li>
+        <li>circumstance_phrase->without emotion or expression</li>
+        <li>circumstance_phrase->with a [AdjectiveFriendly] expression</li>
+        <li>circumstance_phrase->while standing perfectly straight</li>
+        <li>desc_sentence->[PAWN_possessive] insignia is still in place.</li>
+        <li>desc_sentence->[Quantity_adjphrase] officers sit behind a long table.</li>
+        <li>desc_sentence->Unsigned papers lie on the table.</li>
+        <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s watch in silence.</li>
+        <li>desc_sentence->In the distance, a [PersonJob] observes.</li>
+      </rulesStrings>
+    </rulePack>
+  </TaleDef>
+
+</Defs>

--- DMS1/Defs/Misc/DamageDef.xml

+++ DMS2/Defs/Misc/DamageDef.xml

@@ -0,0 +1,15 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+	<!-- 反建築用爆破傷害: 對建築(尤其是不可通行的牆體)的破壞倍率遠高於一般爆炸, 對人員殺傷則與一般爆炸相當 -->
+	<DamageDef ParentName="Bomb">
+		<defName>DMS_Damage_Demolition</defName>
+		<label>demolition blast</label>
+		<deathMessage>{0} has been killed by a demolition charge.</deathMessage>
+		<buildingDamageFactorImpassable>12</buildingDamageFactorImpassable>
