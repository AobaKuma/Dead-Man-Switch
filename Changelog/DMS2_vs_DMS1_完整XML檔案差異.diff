--- DMS1/NewContent/Languages/English/DefInjected/SitePartDef/DMS_LegacySites.xml

+++ DMS2/NewContent/Languages/English/DefInjected/SitePartDef/DMS_LegacySites.xml

@@ -0,0 +1,52 @@

+<?xml version="1.0" encoding="UTF-8"?>
+<LanguageData>
+
+  <!-- ============ 餘械機場 Remnant airfield ============ -->
+  <!-- EN: remnant airfield -->
+  <DMS_AirportSite.label>remnant airfield</DMS_AirportSite.label>
+  <!-- EN: A Legacy remnant drone airfield. The control tower still runs a high-powered decoy radio tuned to the cluster weaver's command band - once the garrison is dealt with, the transmitter can call the mothership down onto the airfield instead of onto your home. -->
+  <DMS_AirportSite.description>A Legacy remnant drone airfield. The control tower still runs a high-powered decoy radio tuned to the cluster weaver's command band - once the garrison is dealt with, the transmitter can call the mothership down onto the airfield instead of onto your home.</DMS_AirportSite.description>
+  <!-- EN: You have arrived at the remnant airfield. A drone garrison holds the tower and the aprons.\n\nThe decoy radio in the tower is intact. Clear the field, then use it to call the cluster weaver down here - far from your colony. -->
+  <DMS_AirportSite.arrivedLetter>You have arrived at the remnant airfield. A drone garrison holds the tower and the aprons.\n\nThe decoy radio in the tower is intact. Clear the field, then use it to call the cluster weaver down here - far from your colony.</DMS_AirportSite.arrivedLetter>
+
+  <!-- ============ 儲存庫地面站 Vault access station ============ -->
+  <!-- EN: vault access station -->
+  <DMS_VaultStationSite.label>vault access station</DMS_VaultStationSite.label>
+  <!-- EN: A Legacy remnant surface station built over a buried military storage vault. The freight elevator is locked under an armored cover plate that only the access console beside it can raise, and the console answers to a key-card. -->
+  <DMS_VaultStationSite.description>A Legacy remnant surface station built over a buried military storage vault. The freight elevator is locked under an armored cover plate that only the access console beside it can raise, and the console answers to a key-card.</DMS_VaultStationSite.description>
+  <!-- EN: You have arrived at the vault access station. A remnant garrison holds the compound.\n\nThe freight elevator is sealed under its cover plate. Swipe an access key-card at the access console beside it to raise the plate. -->
+  <DMS_VaultStationSite.arrivedLetter>You have arrived at the vault access station. A remnant garrison holds the compound.\n\nThe freight elevator is sealed under its cover plate. Swipe an access key-card at the access console beside it to raise the plate.</DMS_VaultStationSite.arrivedLetter>
+
+  <!-- ============ 餘械維修站 Remnant repair depot ============ -->
+  <!-- EN: remnant repair depot -->
+  <DMS_RepairStationSite.label>remnant repair depot</DMS_RepairStationSite.label>
+  <!-- EN: A Legacy remnant field maintenance depot. Units too damaged to walk were cradled here for servicing; two of them are still clamped in their cradles behind a sealed door, waiting for a crew that never came back. -->
