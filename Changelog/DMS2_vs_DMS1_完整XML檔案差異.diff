--- DMS1/NewContent/Defs/Vault/DMS_Vault_MapGenerator.xml

+++ DMS2/NewContent/Defs/Vault/DMS_Vault_MapGenerator.xml

@@ -0,0 +1,104 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- 口袋地圖本體。只用 Core 的地形產生步驟，建築佈局由 DMS_VaultElevator 追加的
+       DMS_VaultStructure 負責（見 DMS.Building_VaultElevator.GetExtraGenSteps）。
+       Core-only terrain steps; the structure comes from the gen step the portal injects. -->
+  <MapGeneratorDef>
+    <defName>DMS_MilitaryVault</defName>
+    <label>military storage vault</label>
+    <isUnderground>true</isUnderground>
+    <disableCallAid>true</disableCallAid>
+    <pocketMapProperties>
+      <!-- Underground 生物群系與 Underground_RocksFromGrid 都在 Core，不需要任何 DLC。
+           Both the Underground biome and the rock grid step live in Core. -->
+      <biome>Underground</biome>
+      <!-- 深層恆溫機房，比地面冷得多。 -->
+      <temperature>12</temperature>
+      <canBeCleaned>true</canBeCleaned>
+    </pocketMapProperties>
+    <genSteps>
+      <li>ElevationFertility</li>
+      <li>Underground_RocksFromGrid</li>
+      <li>Terrain</li>
+      <li>RockChunks</li>
+      <!-- DMS_VaultStructure 由 DMS_VaultElevator 動態插入 / injected by the portal -->
+      <li>Fog</li>
+    </genSteps>
+  </MapGeneratorDef>
+
+  <!-- 取代原版 GenStep_AncientStockpile：同樣的流程，但沒有 OdysseyActive 閘門。
+       Same pipeline as vanilla's, minus the Odyssey gate. -->
+  <GenStepDef>
+    <defName>DMS_VaultStructure</defName>
+    <order>551</order>
+    <genStep Class="DMS.DMS_GenStep_Vault">
+      <layoutDef>DMS_MilitaryVault</layoutDef>
+      <!-- 比原版儲藏庫（40~50）大，才塞得下長廊、中庭與車輛庫。分區之間要留 6 格岩層，樞紐與支道起頭周圍都掛不了房間，
+           所以從原本的 60~70 放大到 90~100，房間數才回到原本的水準（模擬中位數約 11 間）。
+           口袋地圖 130 見方，四周仍留 15 格以上的岩層給檢修通道。
+           Bigger than vanilla's stockpile (40~50) so the hall, atrium and vehicle bay fit. The 6-cell rock gap
+           between sectors leaves no rooms around hubs and branch necks, so it grew from 60~70 to 90~100 to bring
+           the room count back (median about 11 in simulation). The pocket map is 130 square, leaving 15+ cells of
+           rock on every side for the tunnels. -->
+      <sizeRange>90~100</sizeRange>
+    </genStep>
+  </GenStepDef>
+
+  <!-- ============================================================
+       手工版面的地下地圖：三張「單體大空間 + 小房間」FFF_StructureDef（見 DMS_Vault_UnderMaps.xml）。
+       結構步驟直接寫在 genSteps 裡，傳送門只要把 pocketMapGenerator 指到 DMS_UndergroundHall，
+       不需要 ModExtension_PortalLayout。
+       Hand-authored underground maps: three "one big hall + small rooms" FFF_StructureDefs
+       (DMS_Vault_UnderMaps.xml). The structure step is baked into genSteps, so a portal only has to
+       point pocketMapGenerator at DMS_UndergroundHall; no ModExtension_PortalLayout needed.
+       ============================================================ -->
+  <MapGeneratorDef>
+    <defName>DMS_UndergroundHall</defName>
+    <label>underground facility</label>
+    <isUnderground>true</isUnderground>
+    <disableCallAid>true</disableCallAid>
+    <pocketMapProperties>
+      <biome>Underground</biome>
+      <temperature>12</temperature>
+      <canBeCleaned>true</canBeCleaned>
+    </pocketMapProperties>
+    <genSteps>
+      <li>ElevationFertility</li>
+      <li>Underground_RocksFromGrid</li>
+      <li>Terrain</li>
+      <li>RockChunks</li>
+      <li>DMS_UndergroundHallStructure</li>
+      <li>Fog</li>
+    </genSteps>
+  </MapGeneratorDef>
+
+  <GenStepDef>
+    <defName>DMS_UndergroundHallStructure</defName>
+    <order>551</order>
+    <genStep Class="DMS.DMS_GenStep_UndergroundStructure">
+      <structureDefs>
+        <li>DMS_UnderMap_Warehouse</li>
+        <li>DMS_UnderMap_VehicleBay</li>
+        <li>DMS_UnderMap_ReactorHall</li>
+      </structureDefs>
+      <!-- 只有這些會掛防務陣營；門、家具、貨架保持無陣營讓玩家能直接用。
+           Only these get the defender faction; doors, furniture and shelving stay factionless so the player can use them. -->
+      <defenderDefs>
+        <li>DMS_Building_Camera</li>
+        <li>DMS_Building_Scanner_Small</li>
+        <li>DMS_Building_Scanner_Large</li>
+        <li>DMS_Building_FPVNest</li>
+        <li>DMS_MechCapsule_VaultInfantry</li>
+        <li>DMS_MechCapsule_VaultAssault</li>
+        <li>DMS_MechCapsule_VaultFrame</li>
+        <li>DMS_MechCapsule_VaultKennel</li>
+        <!-- 砲塔掛上陣營後會依自身 CompCanBeDormant_NPCChance.npcDormantChance 決定要不要休眠。
+             Once it has a faction the turret rolls its own CompCanBeDormant_NPCChance.npcDormantChance. -->
+        <li>DMS_Turret_Sentry</li>
+      </defenderDefs>
+      <initialBatteryPct>1</initialBatteryPct>
+    </genStep>
+  </GenStepDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Vault/DMS_Vault_MechCapsules.xml

+++ DMS2/NewContent/Defs/Vault/DMS_Vault_MechCapsules.xml

@@ -0,0 +1,107 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       封存庫的機兵搖籃。與海盜組裝廠的容器不同，這裡的是「正規軍封存」：
+       指令認證還在、但電源早就斷了，所以一樣可以被機械師駭入接管。
+       Vault mech cradles. Unlike the pirate assembly capsules these are
+       properly mothballed line units — still hackable, just long dead.
+
+       警報喚醒走 DMS.CompAlertEffector_WakeCapsuleMech：醒來後跟洞口增援一樣是警報回應
+       （DMS.LordJob_AlarmResponse），當下走得到警報位置就前往、走不到就守在艙邊，只打看得到的敵人。
+       Alarm wake-ups go through DMS.CompAlertEffector_WakeCapsuleMech: once awake the mech runs the same
+       alarm response as the hole reinforcements (DMS.LordJob_AlarmResponse), heading for the alarm if it can
+       be reached right then, otherwise holding by its cradle, and only fighting what it can see.
+       ============================================================ -->
+
+  <!-- 1x1：步兵級封存艙 / infantry-class cradle -->
+  <ThingDef ParentName="FFF_MechCapsule_Small">
+    <defName>DMS_MechCapsule_VaultInfantry</defName>
+    <label>hibernated mech</label>
+    <description>A line infantry automatroid in hibernation mode, sealed in a storage cradle. The vault lost power before anyone came to collect it. A mechanitor can attempt to hack and control it.</description>
+    <!-- 警報響應：同地圖的警戒掃描器（攝影機／掃描器）觸發時，有 triggerChance 的機率讓機兵敵對啟動。
+         每次警報各自擲骰，掃描器重新武裝後再觸發會再擲一次。
+         Alarm response: when an alert scanner on the same map fires, roll triggerChance to wake the mech as a hostile.
+         Every alarm rolls again, so a scanner that re-arms and re-triggers gives another chance. -->
+    <receivesSignals>true</receivesSignals>
+    <comps>
+      <li Class="DMS.CompProperties_AlertEffector_WakeCapsuleMech">
+        <triggerChance>0.35</triggerChance>
+      </li>
+    </comps>
+    <modExtensions>
+      <li Class="Fortified.ModExtension_MechCapsule">
+        <spawnChance>0.8</spawnChance>
+        <weaponChance>0.85</weaponChance>
+        <possibleGeneratePawn>
+          <DMS_Mech_Soldat>3</DMS_Mech_Soldat>
+          <DMS_Mech_Kanonier>2</DMS_Mech_Kanonier>
+          <DMS_Mech_Grenadier>1</DMS_Mech_Grenadier>
+          <DMS_Mech_Arquebusier>2</DMS_Mech_Arquebusier>
+          <DMS_Mech_Jaeger>1</DMS_Mech_Jaeger>
+          <DMS_Mech_Sergeant>1</DMS_Mech_Sergeant>
+        </possibleGeneratePawn>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+  <!-- 2x2：突擊級封存艙 / assault-class cradle -->
+  <ThingDef ParentName="FFF_MechCapsule_Medium">
+    <defName>DMS_MechCapsule_VaultAssault</defName>
+    <label>hibernated mech</label>
+    <description>An assault-pattern automatroid in hibernation mode, clamped into a maintenance cradle with its actuator bays still open. The vault was sealed before the servicing was finished. A mechanitor can attempt to hack and control it.</description>
+    <!-- 警報響應：同地圖的警戒掃描器（攝影機／掃描器）觸發時，有 triggerChance 的機率讓機兵敵對啟動。
+         每次警報各自擲骰，掃描器重新武裝後再觸發會再擲一次。
+         Alarm response: when an alert scanner on the same map fires, roll triggerChance to wake the mech as a hostile.
+         Every alarm rolls again, so a scanner that re-arms and re-triggers gives another chance. -->
+    <receivesSignals>true</receivesSignals>
+    <comps>
+      <li Class="DMS.CompProperties_AlertEffector_WakeCapsuleMech">
+        <triggerChance>0.25</triggerChance>
+      </li>
+    </comps>
+    <modExtensions>
+      <li Class="Fortified.ModExtension_MechCapsule">
+        <spawnChance>0.7</spawnChance>
+        <weaponChance>0.8</weaponChance>
+        <possibleGeneratePawn>
+          <DMS_Mech_Ronin>3</DMS_Mech_Ronin>
+          <DMS_Mech_Gladiator>2</DMS_Mech_Gladiator>
+          <DMS_Mech_Phalanx>2</DMS_Mech_Phalanx>
+          <DMS_Mech_Protector>1</DMS_Mech_Protector>
+          <DMS_Mech_Siegebreaker>1</DMS_Mech_Siegebreaker>
+        </possibleGeneratePawn>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+  <!-- 3x3：戰鬥框架龍門架 / battle frame gantry -->
+  <ThingDef ParentName="FFF_MechCapsule_Large">
+    <defName>DMS_MechCapsule_VaultFrame</defName>
+    <label>hibernated battle frame</label>
+    <description>A battle frame in hibernation mode, pinned into a service gantry for long-term storage. Its command authentication expired with the unit that owned it. A mechanitor can attempt to hack and control it.</description>
+    <!-- 警報響應：同地圖的警戒掃描器（攝影機／掃描器）觸發時，有 triggerChance 的機率讓機兵敵對啟動。
+         每次警報各自擲骰，掃描器重新武裝後再觸發會再擲一次。
+         Alarm response: when an alert scanner on the same map fires, roll triggerChance to wake the mech as a hostile.
+         Every alarm rolls again, so a scanner that re-arms and re-triggers gives another chance. -->
+    <receivesSignals>true</receivesSignals>
+    <comps>
+      <li Class="DMS.CompProperties_AlertEffector_WakeCapsuleMech">
+        <triggerChance>0.15</triggerChance>
+      </li>
+    </comps>
+    <modExtensions>
+      <li Class="Fortified.ModExtension_MechCapsule">
+        <spawnChance>0.55</spawnChance>
+        <weaponChance>0.9</weaponChance>
+        <possibleGeneratePawn>
+          <DMS_Mech_BattleFrame>3</DMS_Mech_BattleFrame>
+          <DMS_Mech_FieldCommand>1</DMS_Mech_FieldCommand>
+          <DMS_Mech_Tachanka>1</DMS_Mech_Tachanka>
+        </possibleGeneratePawn>
+        <innerPawnDrawOffset>(0, 0, 0.35)</innerPawnDrawOffset>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Vault/DMS_Vault_Portal.xml

+++ DMS2/NewContent/Defs/Vault/DMS_Vault_Portal.xml

@@ -0,0 +1,208 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       DMS 軍事儲存庫：出入口
+       DMS military storage vault: surface entrance / underground exit
+
+       地表電梯（Core 的 MapPortal）→ 產生口袋地圖 → DMS_VaultStructure 依
+       StructureLayoutDef 佈局 → 入口房間放下對應的出口。
+       全程只用 Core 與 DMS/FFF 的內容，不需要任何 DLC。
+
+       Surface lift (Core MapPortal) → pocket map → DMS_VaultStructure lays the layout →
+       the entrance room drops the matching exit. Core + DMS/FFF only; no DLC required.
+       ============================================================ -->
+
+  <!-- Archive / CommandComplex 電梯繼承自 DMS_VaultElevator，不必另設 -->
+  <DesignatorDropdownGroupDef>
+    <defName>DMS_VaultElevators</defName>
+    <label>freight elevators</label>
+  </DesignatorDropdownGroupDef>
+
+  <ThingDef ParentName="BuildingBase" Name="DMS_ElevatorBase">
+    <defName>DMS_VaultElevator</defName>
+    <label>freight elevator</label>
+    <designatorDropdown>DMS_VaultElevators</designatorDropdown>
+    <description>The entrance to a buried military storage vault. The lift still has power, but its controls are locked. Hack it to bring the car up.</description>
+    <thingClass>DMS.Building_VaultElevator</thingClass>
+    <size>(5,5)</size>
+    <rotatable>true</rotatable>
+    <useHitPoints>false</useHitPoints>
+    <destroyable>false</destroyable>
+    <tickerType>Normal</tickerType>
+    <canOverlapZones>false</canOverlapZones>
+    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
+    <altitudeLayer>FloorEmplacement</altitudeLayer>
+    <fillPercent>0</fillPercent>
+    <passability>PassThroughOnly</passability>
+    <holdsRoof>true</holdsRoof>
+    <graphicData>
+      <graphicClass>Graphic_Multi</graphicClass>
+      <texPath>Things/Building/Elevator/building</texPath>
+      <drawSize>(5,5)</drawSize>
+    </graphicData>
+    <statBases>
+      <Flammability>0</Flammability>
+    </statBases>
+    <!-- 目前沒有任何世界生成流程會放置它，掛在開發用類別下方便測試與後續接線。
+         Nothing places this in worldgen yet; the dev category makes it testable and easy to wire up later. -->
+    <designationCategory>FFF_DevCategory</designationCategory>
+    <building>
+      <isEdifice>true</isEdifice>
+      <deconstructible>false</deconstructible>
+      <isTargetable>false</isTargetable>
+      <isInert>true</isInert>
+      <claimable>false</claimable>
+      <expandHomeArea>false</expandHomeArea>
+      <neverBuildable>true</neverBuildable>
+    </building>
+    <portal>
+      <pocketMapGenerator>DMS_MilitaryVault</pocketMapGenerator>
+      <exitDef>DMS_VaultElevatorExit</exitDef>
+      <!-- 結構 90~100 見 DMS_Vault_MapGenerator.xml，地圖要留出四周的岩層。
+           The structure runs 90~100 (see DMS_Vault_MapGenerator.xml); leave rock around it. -->
+      <pocketMapSize>130</pocketMapSize>
+    </portal>
+    <comps>
+      <!-- 數值比照原版 AncientHatch，讓破解時間與玩家既有經驗一致。
+           Same hack budget as vanilla AncientHatch so pacing matches player expectations. -->
+      <li Class="CompProperties_Hackable">
+        <defence>39000</defence>
+        <effectHacking>HackingTerminal</effectHacking>
+        <lockoutDurationHoursRange>6~18</lockoutDurationHoursRange>
+        <showProgressAfterHackCompletion>false</showProgressAfterHackCompletion>
+        <notHackedInspectString>Hack to open.</notHackedInspectString>
+        <intellectualSkillPrerequisite>4</intellectualSkillPrerequisite>
+        <hackingCompletedSound>Hacking_Completed</hackingCompletedSound>
+        <hackedMessage>{HACKER_labelShort} has finished hacking {SUBJECT_labelNoParenthesisDef}.</hackedMessage>
+      </li>
+      <li Class="CompProperties_Sealable">
+        <sealTexPath>UI/Commands/DMS_UnlockContainer</sealTexPath>
+        <sealCommandLabel>Seal shaft</sealCommandLabel>
+        <sealCommandDesc>Choose a colonist to permanently seal the lift shaft. Anything or anyone left below will be lost forever.</sealCommandDesc>
+        <cannotSealLabel>Cannot seal</cannotSealLabel>
+        <confirmSealText>Sealing the lift shaft is permanent. Anything or anyone left below will be lost forever.{0}\n\nAre you sure you want to continue?</confirmSealText>
+        <sealedInspectString>Permanently sealed.</sealedInspectString>
+        <cannotEnterLabel>Sealed</cannotEnterLabel>
+      </li>
+      <li Class="CompProperties_Glower">
+        <glowRadius>3</glowRadius>
+        <glowColor>(217,178,73,0)</glowColor>
+      </li>
+      <!-- 設施封鎖：封鎖時拒絕進出；中控被毀時，地表端提供緊急解鎖（Fortified.CompFacilityLockdownGate）。
+           Facility lockdown: refuses entry while locked; once the controller is destroyed, the surface end
+           offers an emergency override (Fortified.CompFacilityLockdownGate). -->
+      <li Class="Fortified.CompProperties_FacilityLockdownGate">
+        <overrideWork>6000</overrideWork>
+        <overrideSkillPrerequisite>6</overrideSkillPrerequisite>
+      </li>
+    </comps>
+    <inspectorTabs>
+      <li>ITab_ContentsMapPortal</li>
+    </inspectorTabs>
+    <modExtensions>
+      <!-- 進入時追加的產生步驟與要鋪的版面。
+           The gen step run on the pocket map, and the layout it should build. -->
+      <li Class="DMS.ModExtension_PortalLayout">
+        <genStep>DMS_VaultStructure</genStep>
+        <layout>DMS_MilitaryVault</layout>
+      </li>
+      <!-- 豎井封閉後換成沒有車廂、只剩封板的樣子。
+           Once the shaft is sealed the car is gone and only the cover plate remains. -->
+      <li Class="DMS.ModExtension_SealedGraphic">
+        <sealedGraphicData>
+          <graphicClass>Graphic_Multi</graphicClass>
+          <texPath>Things/Building/Elevator_sealed/building</texPath>
+          <drawSize>(5,5)</drawSize>
+        </sealedGraphicData>
+      </li>
+    </modExtensions>
+  </ThingDef>
+
+  <!-- 封板狀態的貨運電梯。用 Elevator_sealed 貼圖，是 FFF 門禁系統的 wanter 端：
+       在版面中以 Task_LinkAccessKeyWanter 連到 access console，刷卡後原地換成上面的 DMS_VaultElevator
+       （CompHackable 直接視為已駭入，鑰匙卡就是唯一門檻）。
