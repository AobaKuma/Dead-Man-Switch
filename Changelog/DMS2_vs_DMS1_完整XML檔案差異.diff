+
+  <ThingDef>
+    <defName>DMS_OccultechKey</defName>
+    <label>occultech glyph</label>
+    <thingClass>DMS.OccultechKey</thingClass>
+    <description>A palm-sized cipher plate in a sealed casing. Each glyph carries one fragment of the authentication key for a stele buried beneath this world. The colonial fleets split every stele's key across several glyphs and scatter them, so no single find can open one.\n\nRead as a full set with qubit decryption, the glyphs resolve where their stele lies and how to break its seal. The reading collapses their quantum states, and the glyphs are spent.</description>
+    <graphicData>
+      <texPath>Things/Resource/DMS_OccultechGlyph</texPath>
+      <graphicClass>Graphic_Single</graphicClass>
+    </graphicData>
+    <tradeability>None</tradeability>
+    <category>Item</category>
+    <drawerType>MapMeshAndRealTime</drawerType>
+    <tickerType>Rare</tickerType>
+    <rotatable>false</rotatable>
+    <altitudeLayer>Item</altitudeLayer>
+    <selectable>true</selectable>
+    <alwaysHaulable>true</alwaysHaulable>
+    <drawGUIOverlay>true</drawGUIOverlay>
+    <scatterableOnMapGen>false</scatterableOnMapGen>
