--- DMS1/NewContent/Defs/Sites/DMS_LegacySite_ScatterRuins.xml

+++ DMS2/NewContent/Defs/Sites/DMS_LegacySite_ScatterRuins.xml

@@ -0,0 +1,67 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       六個先鋒殘餘設施站點的補充散布：在 Fog（order 1500）之前，於地圖上剩餘的空地
+       隨機放幾座 DMS_SiteStruct_*（Ruin_ScatteredMedium_A/B/C.xml，29x29 中型廢墟）。
+       order 1400 時主結構、衛星、岩塊、植物、動物都已就位，DMS.DMS_GenStep_ScatterStructures
+       只挑「沒建築、沒屋頂、非水面、非鋪設地板」的空地，所以不會壓到既有設施。
+       GenStepDef 的 linkWithSite 只能綁一個 SitePartDef，因此用一個抽象父定義加六個子定義。
+
+       Extra scatter for the six Legacy-installation sites: just before Fog (order 1500),
+       drop a few DMS_SiteStruct_* pieces (29x29 medium ruins from Ruin_ScatteredMedium_A/B/C.xml)
+       onto whatever open ground is left. At order 1400 the main structure, satellites, chunks,
+       plants and animals are all placed, and DMS.DMS_GenStep_ScatterStructures only accepts
+       ground with no buildings, no roof, no water and no laid floor, so nothing is overwritten.
+       linkWithSite takes a single SitePartDef, hence one abstract parent and six children.
+       ============================================================ -->
+
+  <GenStepDef Name="DMS_LegacySiteScatterRuinsBase" Abstract="True">
+    <order>1400</order>
+    <genStep Class="DMS.DMS_GenStep_ScatterStructures">
+      <tag>DMS_SiteStruct</tag>
+      <countRange>3~6</countRange>
+      <minSpacing>6</minSpacing>
+      <randomRotation>true</randomRotation>
+      <attemptsPerPiece>60</attemptsPerPiece>
+      <!-- 廢墟裡的攝影機／無人機巢掛站點派系，才會當作防務運作。
+           Cameras / drone nests in the ruins get the site faction so they act as defences. -->
+      <useSiteFaction>true</useSiteFaction>
+    </genStep>
+  </GenStepDef>
+
+  <GenStepDef ParentName="DMS_LegacySiteScatterRuinsBase">
+    <defName>DMS_AirportScatterRuins</defName>
+    <linkWithSite>DMS_AirportSite</linkWithSite>
+  </GenStepDef>
+
+  <GenStepDef ParentName="DMS_LegacySiteScatterRuinsBase">
+    <defName>DMS_VaultStationScatterRuins</defName>
+    <linkWithSite>DMS_VaultStationSite</linkWithSite>
+  </GenStepDef>
+
+  <GenStepDef ParentName="DMS_LegacySiteScatterRuinsBase">
+    <defName>DMS_RepairStationScatterRuins</defName>
+    <linkWithSite>DMS_RepairStationSite</linkWithSite>
+  </GenStepDef>
+
+  <GenStepDef ParentName="DMS_LegacySiteScatterRuinsBase">
+    <defName>DMS_OperationBaseScatterRuins</defName>
+    <linkWithSite>DMS_OperationBaseSite</linkWithSite>
+  </GenStepDef>
+
+  <!-- 85x58 主結構已佔去大半地圖，只補 2~3 座。The 85x58 main structure eats most of the map; only 2~3 here. -->
+  <GenStepDef ParentName="DMS_LegacySiteScatterRuinsBase">
+    <defName>DMS_SiteStationScatterRuins</defName>
+    <linkWithSite>DMS_SiteStationSite</linkWithSite>
+    <genStep Class="DMS.DMS_GenStep_ScatterStructures">
+      <countRange>2~3</countRange>
+    </genStep>
+  </GenStepDef>
+
+  <GenStepDef ParentName="DMS_LegacySiteScatterRuinsBase">
+    <defName>DMS_LaunchSiteScatterRuins</defName>
+    <linkWithSite>DMS_LaunchSiteSite</linkWithSite>
+  </GenStepDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Sites/Stele_ImpactSite.xml

+++ DMS2/NewContent/Defs/Sites/Stele_ImpactSite.xml

@@ -0,0 +1,102 @@

+<?xml version="1.0" encoding="utf-8" ?>
+<Defs>
+
+  <!-- ============================================================
+       石碑任務線的兩種站點（任務腳本在 Quests/DMS_Stele.xml）。
+       守軍都由 GenStep_FFFGarrisonedStructure 的 spawnDefenders 依站點威脅點數生成（先鋒殘餘），
+       版面依 useTag 挑選，在 GenStructures/SteleQuests/。
+
+       The stele line's two sites (quest scripts in Quests/DMS_Stele.xml). Both garrisons come from
+       GenStep_FFFGarrisonedStructure's spawnDefenders, scaled by the site's threat points (Legacy remnants);
+       layouts are picked by useTag from GenStructures/SteleQuests/.
+       ============================================================ -->
+
+  <!-- 撞擊地點：墜落的密鑰艙與先鋒搭起的掩體，密鑰在掩體中央。
+       Impact site: the crashed glyph capsule and the shelter the pioneers built over it; the glyph sits inside. -->
+  <SitePartDef>
+    <defName>DMS_SteleKey_ImpactSite</defName>
+    <label>impact site</label>
+    <description>The crash site of a fleet glyph capsule. The pioneers sheltered it where it fell, and Legacy remnants still guard it.</description>
+    <siteTexture>UI/Faction/LegacyIcon</siteTexture>
+    <expandingIconTexture>UI/Faction/LegacyIcon</expandingIconTexture>
+    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
+    <showFactionInInspectString>true</showFactionInInspectString>
+    <handlesWorldObjectTimeoutInspectString>true</handlesWorldObjectTimeoutInspectString>
+    <requiresFaction>true</requiresFaction>
+    <wantsThreatPoints>true</wantsThreatPoints>
+    <considerEnteringAsAttack>true</considerEnteringAsAttack>
+    <minMapSize>(200, 0, 200)</minMapSize>
+    <gravShipsCanLandOn>false</gravShipsCanLandOn>
+    <approachOrderString>Assault {0}</approachOrderString>
+    <approachingReportString>Assaulting {0}.</approachingReportString>
+    <tags>
+      <li>DMS_SteleKey</li>
+    </tags>
+  </SitePartDef>
+
+  <GenStepDef>
+    <defName>DMS_SteleKey_ImpactSite</defName>
+    <linkWithSite>DMS_SteleKey_ImpactSite</linkWithSite>
+    <order>400</order>
+    <genStep Class="Fortified.Structures.GenStep_FFFGarrisonedStructure">
+      <useTag>DMS_SteleImpactSite</useTag>
+      <randomOffset>0~2</randomOffset>
+      <randomRotation>true</randomRotation>
+      <filthTypes>
+        <li>Filth_RubbleBuilding</li>
+        <li>Filth_MachineBits</li>
+        <li>Filth_Ash</li>
+      </filthTypes>
+      <debrisDef>ChunkSlagSteel</debrisDef>
+      <debrisCount>10~16</debrisCount>
+      <scatterRadius>18</scatterRadius>
+      <spawnDefenders>true</spawnDefenders>
+      <defendRadius>16</defendRadius>
+    </genStep>
+  </GenStepDef>
+
+  <!-- 石碑封藏庫：最終站點。石碑在封藏庫正中央，守軍點數 ×1.25（見任務的 pointsFactor）。
+       Stele vault: the final site. The stele stands in the middle of the vault; garrison points ×1.25 (the quest's pointsFactor). -->
+  <SitePartDef>
+    <defName>DMS_SteleVault</defName>
+    <label>stele vault</label>
+    <description>A sealed vault holding a buried stele, guarded by Legacy remnants.</description>
+    <siteTexture>UI/Faction/LegacyIcon</siteTexture>
+    <expandingIconTexture>UI/Faction/LegacyIcon</expandingIconTexture>
+    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
+    <showFactionInInspectString>true</showFactionInInspectString>
+    <requiresFaction>true</requiresFaction>
+    <wantsThreatPoints>true</wantsThreatPoints>
+    <considerEnteringAsAttack>true</considerEnteringAsAttack>
+    <minMapSize>(200, 0, 200)</minMapSize>
+    <!-- 石碑重 500 kg，允許重力艦降落，給有重力艦的玩家一條運回來的路。
+         The stele weighs 500 kg; gravships may land, giving gravship players a way to haul it back. -->
+    <gravShipsCanLandOn>true</gravShipsCanLandOn>
+    <approachOrderString>Assault {0}</approachOrderString>
+    <approachingReportString>Assaulting {0}.</approachingReportString>
+    <tags>
+      <li>DMS_SteleVault</li>
+    </tags>
+  </SitePartDef>
+
+  <GenStepDef>
+    <defName>DMS_SteleVault</defName>
+    <linkWithSite>DMS_SteleVault</linkWithSite>
+    <order>400</order>
+    <genStep Class="Fortified.Structures.GenStep_FFFGarrisonedStructure">
+      <useTag>DMS_SteleVault</useTag>
+      <randomOffset>0~2</randomOffset>
+      <filthTypes>
+        <li>Filth_RubbleBuilding</li>
+        <li>Filth_RubbleRock</li>
+        <li>Filth_MachineBits</li>
+      </filthTypes>
+      <debrisDef>ChunkSlagSteel</debrisDef>
+      <debrisCount>6~10</debrisCount>
+      <scatterRadius>20</scatterRadius>
+      <spawnDefenders>true</spawnDefenders>
+      <defendRadius>18</defendRadius>
+    </genStep>
+  </GenStepDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Storyteller/Incidents_Quests.xml

+++ DMS2/NewContent/Defs/Storyteller/Incidents_Quests.xml

@@ -0,0 +1,23 @@

+<?xml version="1.0" encoding="utf-8" ?>
+<Defs>
+
+  <!-- 格蕾西亞專屬的任務發布管道。這裡刻意不寫 <questScriptDef>：原版
+       IncidentDef.ConfigErrors 會擋掉「questScriptDef 指向一個 rootSelectionWeight
+       不為 0 的任務」，也就是一個任務不能同時進隨機池又被事件直接點名。實際要發
+       哪個任務改由 DMS.StorytellerComp_FavoredQuest 在 GenerateParms 裡塞進
+       parms.questScriptDef，IncidentWorker_GiveQuest 會照樣接受。
+       baseChance 0 表示它不會進隨機事件池，只由那個 comp 觸發。
+
+       Greysia's own quest channel. <questScriptDef> is deliberately omitted:
+       vanilla IncidentDef.ConfigErrors rejects pointing at a quest that also has
+       a non-zero rootSelectionWeight, because a quest may not be both random-pool
+       and incident-driven. DMS.StorytellerComp_FavoredQuest supplies the quest
+       through parms.questScriptDef instead, which IncidentWorker_GiveQuest
+       accepts. baseChance 0 keeps it out of the random incident pool. -->
+  <IncidentDef ParentName="GiveQuestBase">
+    <defName>DMS_GiveQuest_Favored</defName>
+    <label>fleet contract</label>
+    <baseChance>0</baseChance> <!-- given by a special storyteller comp -->
+  </IncidentDef>
+
+</Defs>

