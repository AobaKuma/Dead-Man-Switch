+        <li>image->[PAWN_nameFull] gripping [PAWN_possessive] head [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] standing rigid among marching machines [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] issuing commands [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] collapsing to one knee [circumstance_group]</li>
+        <li>circumstance_phrase->with a [AdjectiveAngsty] expression</li>
+        <li>circumstance_phrase->with a [AdjectiveAngsty] expression</li>
+        <li>circumstance_phrase->while bleeding from the nose</li>
+        <li>circumstance_phrase->with eyes rolled back</li>
+        <li>circumstance_phrase->while sweating with exertion</li>
+        <li>desc_sentence->[Quantity_adjphrase] [Mechanoid]s stand in perfect formation behind [PAWN_nameDef].</li>
+        <li>desc_sentence->The machines in the background move in perfect unison.</li>
+        <li>desc_sentence->[PAWN_nameDef] wears a [AdjectiveAngsty] expression.</li>
+        <li>desc_sentence->Warning lights wash the scene in [Color].</li>
+        <li>desc_sentence->In the distance, a [PersonJob] observes.</li>
+        <li>desc_sentence->[PAWN_nameDef] is drenched in sweat.</li>
+      </rulesStrings>
+    </rulePack>
+  </TaleDef>
+
+  <!-- ── 2. 武器校準完成 ──────────────────────────────────────────
+       觸發:HediffDef DMS_WeaponInprint 的 maximized 階段 (severity 6)。
+       對象是合成人機兵,屬玩家派系時才會被記錄。
+       ──────────────────────────────────────────────────────────── -->
+  <TaleDef>
+    <defName>DMS_Tale_WeaponImprinted</defName>
+    <label>weapon calibration maximized</label>
+    <taleClass>Tale_SinglePawn</taleClass>
+    <type>Volatile</type>
+    <baseInterest>1</baseInterest>
+    <rulePack>
+      <rulesStrings>
+        <li>tale_noun->[PAWN_nameDef] finishing [PAWN_possessive] weapon calibration</li>
+        <li>image->[PAWN_nameFull] stripping a weapon down [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] reassembling a weapon [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] standing motionless on a firing range [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] raising a rifle [circumstance_group]</li>
+        <li>image->[PAWN_nameFull] cradling a worn rifle [circumstance_group]</li>
+        <li>circumstance_phrase->with mechanical precision</li>
+        <li>circumstance_phrase->with mechanical precision</li>
+        <li>circumstance_phrase->without a single wasted movement</li>
+        <li>circumstance_phrase->while wielding [PAWN_possessive] weapon</li>
+        <li>circumstance_phrase->without emotion or expression</li>
+        <li>desc_sentence->The weapon is worn through where [PAWN_nameDef] grips it.</li>
+        <li>desc_sentence->[PAWN_possessive] skill is visible in the work.</li>
+        <li>desc_sentence->Spent brass covers the ground.</li>
+        <li>desc_sentence->A row of identical units stands at attention in the background.</li>
+        <li>desc_sentence->A rack of [Weapon]s stands [side_position].</li>
+        <li>desc_sentence->[Quantity_adjphrase] [PersonJob]s watch with amazement.</li>
+      </rulesStrings>
+    </rulePack>
+  </TaleDef>
+
+  <!-- ── 3. 呼叫火力支援 ──────────────────────────────────────────
+       觸發:Fortified.AirSupportDef.taleOnTriggered。
+       框架只傳一個 pawn,所以 taleClass 必須是 Tale_SinglePawn。
+       刻意不引用 AirSupportDef 的 label:現有的幾個 label 還是
+       「Air Raid Test」這類佔位字串,寫進藝術品敘述會很難看。
+       ──────────────────────────────────────────────────────────── -->
+  <TaleDef>
+    <defName>DMS_Tale_CalledFireSupport</defName>
