--- DMS1/NewContent/Defs/Quests/DMS_FleetNetworkQuest.xml

+++ DMS2/NewContent/Defs/Quests/DMS_FleetNetworkQuest.xml

@@ -0,0 +1,124 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       SAGE 節點：殖民艦隊追緝網路上的戰略主機。只在隱匿級追殺進行中（且未暫停）時出現，
+       由 DMS.QuestNode_Root_DMS_FleetNetworkSite 把關；追殺每觸發一次也有 35% 機率主動派發
+       （OccultechSanctionUtility.TryOfferNetworkSite）。打爛 SAGE 會暫停追殺，由建築本身的
+       DMS.CompHuntBreaker 處理，與任務成敗無關：肅清即算完成。
+       版面 DMS_SageNode 在 GenStructures/Site_FleetNetwork.xml。
+
+       SAGE node: a strategic host on the colony fleet's tracking network. Only offered while the Occulted hunt
+       is running and not suspended (gated by DMS.QuestNode_Root_DMS_FleetNetworkSite); each hunt also has a 35%
+       chance to offer one outright (OccultechSanctionUtility.TryOfferNetworkSite). Destroying the SAGE suspends
+       the hunt through the building's own DMS.CompHuntBreaker, independent of the quest: clearing the site
+       completes it. The DMS_SageNode layout lives in GenStructures/Site_FleetNetwork.xml.
+       ============================================================ -->
+
+  <SitePartDef>
+    <defName>DMS_SageNodeSite</defName>
+    <label>SAGE node</label>
+    <description>A strategic command host on the colony fleet's tracking network, guarded by Legacy remnant machines.</description>
+    <workerClass>Fortified.SitePartWorker_FFF_TimedHostileSite</workerClass>
+    <modExtensions>
+      <li Class="Fortified.FFF_TimedSiteExtension">
+        <baseEntryHours>36</baseEntryHours>
+        <minEntryHours>10</minEntryHours>
+        <maxEntryHours>72</maxEntryHours>
+        <entryLetterLabelKey>DMS_SageNode_EntryCountdownLabel</entryLetterLabelKey>
+        <entryLetterTextKey>DMS_SageNode_EntryCountdownText</entryLetterTextKey>
+      </li>
+    </modExtensions>
+    <siteTexture>UI/Faction/LegacyIcon</siteTexture>
+    <expandingIconTexture>UI/Faction/LegacyIcon</expandingIconTexture>
+    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
+    <showFactionInInspectString>true</showFactionInInspectString>
+    <requiresFaction>true</requiresFaction>
+    <wantsThreatPoints>true</wantsThreatPoints>
+    <gravShipsCanLandOn>true</gravShipsCanLandOn>
+    <minThreatPoints>500</minThreatPoints>
+    <minMapSize>(200, 0, 200)</minMapSize>
+    <considerEnteringAsAttack>true</considerEnteringAsAttack>
+    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
+    <approachOrderString>Assault {0}</approachOrderString>
+    <approachingReportString>Assaulting {0}.</approachingReportString>
+    <arrivedLetter>You have arrived at the SAGE node. Sentry towers cover the approaches, and the node is wired for fire support.</arrivedLetter>
+    <arrivedLetterDef>NegativeEvent</arrivedLetterDef>
+    <tags>
+      <li>DMS_SageNodeSite</li>
+    </tags>
+  </SitePartDef>
+
+  <GenStepDef>
+    <defName>DMS_SageNodeStructure</defName>
+    <linkWithSite>DMS_SageNodeSite</linkWithSite>
+    <order>400</order>
+    <genStep Class="Fortified.Structures.GenStep_FFFGarrisonedStructure">
+      <useTag>DMS_SageNode</useTag>
+      <randomOffset>0~2</randomOffset>
+      <filthTypes>
+        <li>Filth_RubbleBuilding</li>
+        <li>Filth_MachineBits</li>
+      </filthTypes>
+      <debrisDef>ChunkSlagSteel</debrisDef>
+      <debrisCount>6~10</debrisCount>
+      <scatterRadius>24</scatterRadius>
+      <lootMaker>MapGen_DefaultStockpile</lootMaker>
+      <spawnDefenders>true</spawnDefenders>
+      <defendRadius>20</defendRadius>
+      <satelliteScatter>
+        <li>
+          <tag>DMS_RuinSatellite</tag>
+          <count>3~4</count>
+          <radiusPct>0.26</radiusPct>
+          <minRadius>34</minRadius>
+          <minSpacing>5</minSpacing>
+        </li>
+      </satelliteScatter>
+    </genStep>
+  </GenStepDef>
+
+  <QuestScriptDef>
+    <defName>DMS_FleetNetworkSite</defName>
+    <successHistoryEvent>DMS_QuestSuccess_Military</successHistoryEvent>
+    <failedOrExpiredHistoryEvent>DMS_QuestFailed_Military</failedOrExpiredHistoryEvent>
+    <rootSelectionWeight>1.2</rootSelectionWeight>
+    <rootMinPoints>500</rootMinPoints>
+    <expireDaysRange>4~8</expireDaysRange>
+    <sendAvailableLetter>true</sendAvailableLetter>
+    <questNameRules>
+      <rulesStrings>
+        <li>questName(installation==DMS_SageNodeSite)->SAGE</li>
+        <li>questName(installation==DMS_SageNodeSite)->Blind the [sage]</li>
+        <li>sage->SAGE node</li>
+        <li>sage->strategic host</li>
+        <li>sage->air-defense host</li>
+      </rulesStrings>
+    </questNameRules>
+    <questDescriptionRules>
+      <rulesStrings>
+        <li>questDescription(installation==DMS_SageNodeSite)->We have found the host that is coordinating [fleetName]'s hunt for us: a SAGE node, the distributed strategic command computer the fleet uses for planetary air defense and to tie together the radar and navigation networks across several continents. Its rack array is guarded by (*Threat)[enemiesCount] [enemiesLabel](/Threat), and it is wired into a full facility alarm system with fire support.\n\nThe SAGE core can be hacked two or three times. Each run pulls technical blueprints, sealed data caches or access keys out of its strategic database, and each run will set off the facility's alarm again. Destroying it will cripple the fleet's hunt; within a year or two another computer on the SAGE network will be promoted to host and pick up where it left off.\n\nThe node's coordinates hold for [siteTimeout], until the network rotates its hosts.\n\nCaution: it is a hostile installation. Once you enter, its monitoring protocol will summon enemy reinforcements after a countdown, and the node can call in mortar fire.</li>
+      </rulesStrings>
+    </questDescriptionRules>
+    <root Class="DMS.QuestNode_Root_DMS_FleetNetworkSite">
+      <factionDef>DMS_Legacy</factionDef>
+      <baseTimeoutDays>12</baseTimeoutDays>
+      <minTimeoutDays>4</minTimeoutDays>
+      <maxTimeoutDays>24</maxTimeoutDays>
+      <!-- 目前只有一種站點；保留清單寫法，之後要加別的網路節點站點只需加一項。
+           Only one site kind for now; the list form stays so another network node is a one-entry addition. -->
+      <installations>
+        <li>
+          <sitePartDef>DMS_SageNodeSite</sitePartDef>
+          <weight>1</weight>
+          <minPoints>500</minPoints>
+          <expiredLetterLabelKey>DMS_SageNode_ExpiredLabel</expiredLetterLabelKey>
+          <expiredLetterTextKey>DMS_SageNode_ExpiredText</expiredLetterTextKey>
+          <clearedLetterLabelKey>DMS_SageNode_ClearedLabel</clearedLetterLabelKey>
+          <clearedLetterTextKey>DMS_SageNode_ClearedText</clearedLetterTextKey>
+        </li>
+      </installations>
+    </root>
+  </QuestScriptDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Quests/DMS_LegacyInstallationQuest.xml

+++ DMS2/NewContent/Defs/Quests/DMS_LegacyInstallationQuest.xml

@@ -0,0 +1,139 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       先鋒殘餘設施：一個任務涵蓋五座站點（機場另有專屬任務 DMS_AirportAssault）。
+       DMS.QuestNode_Root_DMS_RandomInstallation 依威脅點數過濾、依權重抽一座，
+       把 sitePartDef 與逾期／肅清信件鍵寫回 FFF 的根節點，並提供語法常數 installation
+       （值為 SitePartDef 的 defName）讓名稱與描述分流。
+       每座站點的 SitePartDef／GenStepDef 仍在各自的 DMS_LegacySite_*.xml。
+
+       Legacy remnant installations: one quest covering five sites (the airfield keeps
+       its own DMS_AirportAssault). DMS.QuestNode_Root_DMS_RandomInstallation filters by
+       threat points, rolls one by weight, writes the sitePartDef and expiry / cleared letter
+       keys into FFF's root node, and exposes the grammar constant "installation" (the
+       SitePartDef's defName) so name and description can branch on it. Each site's
+       SitePartDef / GenStepDef stays in its own DMS_LegacySite_*.xml.
+       ============================================================ -->
+
+  <QuestScriptDef>
+    <defName>DMS_LegacyInstallationAssault</defName>
+    <successHistoryEvent>DMS_QuestSuccess_Military</successHistoryEvent>
+    <failedOrExpiredHistoryEvent>DMS_QuestFailed_Military</failedOrExpiredHistoryEvent>
+    <!-- 與海盜組裝廠同級。門檻取最低的一座（發射場）；其餘由 installations 的 minPoints 把關。
+         Same tier as the pirate assembly yard. The floor is the lowest site's (launch site); the rest gate on minPoints. -->
+    <rootSelectionWeight>1.0</rootSelectionWeight>
+    <rootMinPoints>300</rootMinPoints>
+    <expireDaysRange>4~8</expireDaysRange>
+    <sendAvailableLetter>true</sendAvailableLetter>
+    <questNameRules>
+      <rulesStrings>
+        <!-- 儲存庫地面站 / Vault access station -->
+        <li>questName(installation==DMS_VaultStationSite)->Buried arsenal</li>
+        <li>questName(installation==DMS_VaultStationSite)->The [vault]</li>
+        <li>vault->Sealed vault</li>
+        <li>vault->Storage vault</li>
+        <li>vault->Deep store</li>
+        <!-- 維修站 / Repair depot -->
+        <li>questName(installation==DMS_RepairStationSite)->Depot raid</li>
+        <li>questName(installation==DMS_RepairStationSite)->The [depot]</li>
+        <li>depot->Repair depot</li>
+        <li>depot->Maintenance yard</li>
+        <li>depot->Cradle yard</li>
+        <!-- 前進基地 / Forward base -->
+        <li>questName(installation==DMS_OperationBaseSite)->Forward base</li>
+        <li>questName(installation==DMS_OperationBaseSite)->The [base]</li>
+        <li>base->Remnant FOB</li>
+        <li>base->Wire perimeter</li>
+        <li>base->Supply dump</li>
+        <!-- 荒廢站點 / Derelict station -->
+        <li>questName(installation==DMS_SiteStationSite)->Derelict station</li>
+        <li>questName(installation==DMS_SiteStationSite)->The [station]</li>
+        <li>station->Dead station</li>
+        <li>station->Old station</li>
+        <li>station->Rusted station</li>
+        <!-- 廢棄發射場 / Abandoned launch site -->
+        <li>questName(installation==DMS_LaunchSiteSite)->Launch site salvage</li>
+        <li>questName(installation==DMS_LaunchSiteSite)->The [site]</li>
+        <li>site->Dead launch site</li>
+        <li>site->Silo field</li>
+        <li>site->Wrecked pad</li>
+      </rulesStrings>
+    </questNameRules>
+    <questDescriptionRules>
+      <rulesStrings>
+        <!-- 儲存庫地面站 / Vault access station -->
+        <li>questDescription(installation==DMS_VaultStationSite)->A supply manifest recovered from remnant traffic lists a [siteFactionName] storage vault, and the surface station that sits on top of it. The station is still manned by (*Threat)[enemiesCount] [enemiesLabel](/Threat), and heavy units are among them.\n\nThe freight elevator into the vault is locked under an armored cover plate, slaved to the access console beside it. The console takes a key-card, not a hack: swipe one and the plate retracts. The car still has power, so what is below was never collected.\n\nThe manifest's location fix expires in [siteTimeout]. After that the station will relocate and its position will be lost.\n\nThe installation also runs a site server: a small records host that can be hacked once for blueprints or access keys, at the cost of setting off the alarm.\n\nCaution: it is a hostile installation. Once you enter, its monitoring protocol will summon enemy reinforcements after a countdown. Get the shaft open, then decide whether to hold the surface or go down.</li>
+
+        <!-- 維修站 / Repair depot -->
+        <li>questDescription(installation==DMS_RepairStationSite)->A maintenance request on the remnant network leads to a [siteFactionName] field repair depot. The depot is guarded by (*Threat)[enemiesCount] [enemiesLabel](/Threat): engineers, riflemen and a drone screen.\n\nTwo units are still clamped in the depot's cradles, in hibernation, behind a sealed maintenance door. They were never re-authenticated after servicing, so a mechanitor with spare bandwidth can hack one and take it. The depot's security console releases the door. There is also a mobile crew lifter on the pad and a stock of tungsteel in the stores.\n\nThe request's location fix expires in [siteTimeout]. After that the depot will relocate and its position will be lost.\n\nThe installation also runs a site server: a small records host that can be hacked once for blueprints or access keys, at the cost of setting off the alarm.\n\nCaution: it is a hostile installation. Once you enter, its monitoring protocol will summon enemy reinforcements after a countdown.</li>
+
+        <!-- 前進基地 / Forward base -->
+        <li>questDescription(installation==DMS_OperationBaseSite)->Remnant traffic has given away a [siteFactionName] forward operating base. It is held by (*Threat)[enemiesCount] [enemiesLabel](/Threat): line infantry behind the wire, with heavy support and night-capable units in reserve.\n\nThe base is a supply hub. Crates of rations, small arms, spare parts and prosthetics sit in the open, and a freight elevator at the back of the compound leads down into a buried store. The blast doors in front of it answer to two security consoles; hack both to open the way, then hack the lift itself.\n\nThe position fix holds for [siteTimeout]. After that the base will strike camp and its position will be lost.\n\nThe installation also runs a site server: a small records host that can be hacked once for blueprints or access keys, at the cost of setting off the alarm.\n\nCaution: it is a hostile installation. Once you enter, its monitoring protocol will summon enemy reinforcements after a countdown.</li>
+
+        <!-- 荒廢站點 / Derelict station -->
+        <li>questDescription(installation==DMS_SiteStationSite)->A pre-war station, half of it collapsed, has been located nearby. A [siteFactionName] detachment has dug into the ruins: (*Threat)[enemiesCount] [enemiesLabel](/Threat), shield-bearers and infantry with drone and lifter support, spread across the station's halls.\n\nThe station was abandoned in a hurry. Ancient supply crates, industrial shelving and the wrecks of the old security systems are still scattered through it, along with a working pod launcher pair. Everything the detachment has not already stripped is yours.\n\nThe detachment is expected to move on in [siteTimeout]. After that the station will be picked clean and no longer worth the trip.\n\nThe installation also runs a site server: a small records host that can be hacked once for blueprints or access keys, at the cost of setting off the alarm.\n\nOne of the station's freight elevators still runs down to a data archive the fleet buried beneath it. A facility server core sits in the sealed server hall at the bottom; it can be hacked several times, and every attempt will bring the archive's defences up from below. The corridors are fitted with gas vents, and a lockdown controller will seal the lift a minute after the alert level maxes out.\n\nCaution: it is a hostile installation. Once you enter, its monitoring protocol will summon enemy reinforcements after a countdown, and the station is large enough to get lost in.</li>
+
+        <!-- 廢棄發射場 / Abandoned launch site -->
+        <li>questDescription(installation==DMS_LaunchSiteSite)->An old missile launch complex has turned up on the scanners. The launchers were destroyed long ago and the compound is falling apart, but a [siteFactionName] patrol of (*Threat)[enemiesCount] [enemiesLabel](/Threat) still sweeps the wreckage.\n\nNobody ever salvaged the place. Wrecked automatroids, a logistics container, sensor and radar mounts and the remains of the launch crews' equipment are all still where they fell.\n\nThe patrol's schedule puts it there for another [siteTimeout]. After that it moves on and the site's position is lost.\n\nThe installation also runs a site server: a small records host that can be hacked once for blueprints or access keys, at the cost of setting off the alarm.\n\nCaution: it is a hostile installation. Once you enter, the patrol's monitoring protocol will summon enemy reinforcements after a countdown.</li>
+      </rulesStrings>
+    </questDescriptionRules>
+    <root Class="DMS.QuestNode_Root_DMS_RandomInstallation">
+      <factionDef>DMS_Legacy</factionDef>
+      <baseTimeoutDays>16</baseTimeoutDays>
+      <minTimeoutDays>4</minTimeoutDays>
+      <maxTimeoutDays>30</maxTimeoutDays>
+      <!-- 權重與 minPoints 沿用先前各自任務的設定：入門級的發射場較常出現、重型設施要到中後期。
+           Weights and minPoints carry over from the former per-site quests: the entry-level launch
+           site shows up most, the heavy installations wait for the mid game. -->
+      <installations>
+        <li>
+          <sitePartDef>DMS_LaunchSiteSite</sitePartDef>
+          <weight>1.2</weight>
+          <minPoints>300</minPoints>
+          <expiredLetterLabelKey>DMS_LaunchSite_ExpiredLabel</expiredLetterLabelKey>
+          <expiredLetterTextKey>DMS_LaunchSite_ExpiredText</expiredLetterTextKey>
+          <clearedLetterLabelKey>DMS_LaunchSite_ClearedLabel</clearedLetterLabelKey>
+          <clearedLetterTextKey>DMS_LaunchSite_ClearedText</clearedLetterTextKey>
+        </li>
+        <li>
+          <sitePartDef>DMS_SiteStationSite</sitePartDef>
+          <weight>1</weight>
+          <minPoints>500</minPoints>
+          <expiredLetterLabelKey>DMS_SiteStation_ExpiredLabel</expiredLetterLabelKey>
+          <expiredLetterTextKey>DMS_SiteStation_ExpiredText</expiredLetterTextKey>
+          <clearedLetterLabelKey>DMS_SiteStation_ClearedLabel</clearedLetterLabelKey>
+          <clearedLetterTextKey>DMS_SiteStation_ClearedText</clearedLetterTextKey>
+        </li>
+        <li>
+          <sitePartDef>DMS_RepairStationSite</sitePartDef>
+          <weight>1</weight>
+          <minPoints>700</minPoints>
+          <expiredLetterLabelKey>DMS_RepairStation_ExpiredLabel</expiredLetterLabelKey>
+          <expiredLetterTextKey>DMS_RepairStation_ExpiredText</expiredLetterTextKey>
+          <clearedLetterLabelKey>DMS_RepairStation_ClearedLabel</clearedLetterLabelKey>
+          <clearedLetterTextKey>DMS_RepairStation_ClearedText</clearedLetterTextKey>
+        </li>
+        <li>
+          <sitePartDef>DMS_OperationBaseSite</sitePartDef>
+          <weight>1</weight>
+          <minPoints>900</minPoints>
+          <expiredLetterLabelKey>DMS_OperationBase_ExpiredLabel</expiredLetterLabelKey>
+          <expiredLetterTextKey>DMS_OperationBase_ExpiredText</expiredLetterTextKey>
+          <clearedLetterLabelKey>DMS_OperationBase_ClearedLabel</clearedLetterLabelKey>
+          <clearedLetterTextKey>DMS_OperationBase_ClearedText</clearedLetterTextKey>
+        </li>
+        <li>
+          <sitePartDef>DMS_VaultStationSite</sitePartDef>
+          <weight>1</weight>
+          <minPoints>900</minPoints>
+          <expiredLetterLabelKey>DMS_VaultStation_ExpiredLabel</expiredLetterLabelKey>
+          <expiredLetterTextKey>DMS_VaultStation_ExpiredText</expiredLetterTextKey>
+          <clearedLetterLabelKey>DMS_VaultStation_ClearedLabel</clearedLetterLabelKey>
+          <clearedLetterTextKey>DMS_VaultStation_ClearedText</clearedLetterTextKey>
+        </li>
+      </installations>
+    </root>
+  </QuestScriptDef>
+
+</Defs>

--- DMS1/NewContent/Defs/Quests/DMS_LegacySite_Airport.xml

+++ DMS2/NewContent/Defs/Quests/DMS_LegacySite_Airport.xml

@@ -0,0 +1,145 @@

+<?xml version="1.0" encoding="utf-8"?>
+<Defs>
+
+  <!-- ============================================================
+       殘餘機場：集群織鳥 Boss 的客場地圖。
+       版面（DMS_Airport，Site_LegacyInstallations.xml）本身已放好 DMS_DecoyTransmitter：
+       清掉守軍後在現場啟動它，織鳥會直接降落在機場而不是玩家殖民地。
+       跑道下方另有一座貨運電梯（DMS_VaultElevator），由兩座安全控制台把關。
+       守軍 = 版面內的 FFF_Element_PawnGroup + GenStep 依威脅點數生成的守軍。
+
+       Remnant airfield: the away map for the cluster weaver boss.
+       The layout (DMS_Airport in Site_LegacyInstallations.xml) already carries a
+       DMS_DecoyTransmitter; fire it after the garrison is dead and the weaver
+       lands on the airfield instead of on the colony. A freight elevator under
+       the aprons is gated by two security consoles. The garrison comes from
+       the in-layout FFF_Element_PawnGroup plus the GenStep's threat-point garrison.
+       ============================================================ -->
+
+  <SitePartDef>
+    <defName>DMS_AirportSite</defName>
+    <label>remnant airfield</label>
+    <description>A Legacy remnant drone airfield. The control tower still runs a high-powered decoy radio tuned to the cluster weaver's command band: once the garrison is dealt with, the transmitter can call the mothership down onto the airfield instead of onto your home.</description>
+    <workerClass>Fortified.SitePartWorker_FFF_TimedHostileSite</workerClass>
+    <modExtensions>
+      <!-- 客場 Boss 戰需要時間，倒數比一般站點寬鬆。
+           A boss fight on an away map takes time; looser countdown than the other sites. -->
+      <li Class="Fortified.FFF_TimedSiteExtension">
+        <baseEntryHours>48</baseEntryHours>
+        <minEntryHours>12</minEntryHours>
+        <maxEntryHours>96</maxEntryHours>
+        <entryLetterLabelKey>DMS_Airport_EntryCountdownLabel</entryLetterLabelKey>
+        <entryLetterTextKey>DMS_Airport_EntryCountdownText</entryLetterTextKey>
+      </li>
+    </modExtensions>
+    <!-- 世界地圖上用先鋒殘餘的陣營圖標，套陣營色。The Legacy faction icon on the world map, tinted with the faction colour. -->
+    <siteTexture>UI/Faction/LegacyIcon</siteTexture>
+    <expandingIconTexture>UI/Faction/LegacyIcon</expandingIconTexture>
+    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
+    <showFactionInInspectString>true</showFactionInInspectString>
+    <requiresFaction>true</requiresFaction>
+    <wantsThreatPoints>true</wantsThreatPoints>
+    <gravShipsCanLandOn>true</gravShipsCanLandOn>
+    <minThreatPoints>800</minThreatPoints>
+    <considerEnteringAsAttack>true</considerEnteringAsAttack>
+    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
+    <approachOrderString>Assault {0}</approachOrderString>
+    <approachingReportString>Assaulting {0}.</approachingReportString>
+    <arrivedLetter>You have arrived at the remnant airfield. A drone garrison holds the tower and the aprons.\n\nThe decoy radio in the tower is intact. Clear the field, then use it to call the cluster weaver down here, far from your colony.</arrivedLetter>
+    <arrivedLetterDef>NegativeEvent</arrivedLetterDef>
+    <tags>
+      <li>DMS_AirportSite</li>
+    </tags>
+  </SitePartDef>
+
+  <GenStepDef>
+    <defName>DMS_AirportStructure</defName>
+    <linkWithSite>DMS_AirportSite</linkWithSite>
+    <order>400</order>
+    <genStep Class="Fortified.Structures.GenStep_FFFGarrisonedStructure">
+      <useTag>DMS_Airport</useTag>
+      <randomOffset>0~3</randomOffset>
+      <filthTypes>
+        <li>Filth_RubbleBuilding</li>
+        <li>Filth_MachineBits</li>
+        <li>Filth_Ash</li>
+      </filthTypes>
+      <!-- 版面已放 DMS_DecoyTransmitter；保底一座，版面若被裁切仍有召喚器。
+           The layout places DMS_DecoyTransmitter; keep it as the centerpiece so a clipped layout still has one. -->
+      <centerpieceDef>DMS_DecoyTransmitter</centerpieceDef>
+      <debrisDef>ChunkSlagSteel</debrisDef>
+      <debrisCount>8~14</debrisCount>
+      <scatterRadius>30</scatterRadius>
+      <lootMaker>MapGen_DefaultStockpile</lootMaker>
+      <!-- 版面自帶的 PawnGroup 之外，再依站點威脅點數生成一支守軍（LordJob_DefendPoint），
+           讓兵力隨難度縮放；[enemiesCount] 對應的就是這一支。
+           On top of the layout's own PawnGroup, spawn a garrison from the site's threat points
+           (LordJob_DefendPoint) so strength scales with difficulty; [enemiesCount] describes this group. -->
+      <spawnDefenders>true</spawnDefenders>
+      <defendRadius>22</defendRadius>
+      <satelliteScatter>
+        <li>
+          <tag>DMS_DecoySiteEdgeRuin</tag>
+          <count>1~2</count>
+          <radiusPct>0.24</radiusPct>
+          <minRadius>48</minRadius>
+          <minSpacing>6</minSpacing>
+        </li>
+        <li>
+          <tag>DMS_RuinSatellite</tag>
+          <count>4~6</count>
+          <radiusPct>0.2</radiusPct>
+          <minRadius>44</minRadius>
+          <minSpacing>5</minSpacing>
+        </li>
