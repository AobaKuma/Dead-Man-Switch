+  <!-- ==================================================================== -->
+  <ThingDef ParentName="ResourceBase" Name="DMS_BaseDataCache" Abstract="True">
+    <graphicData>
+      <texPath>Things/Misc/DataCache</texPath>
+      <graphicClass>Graphic_Single</graphicClass>
