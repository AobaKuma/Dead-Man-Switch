--- DMS1/NewContent/Languages/English/DefInjected/ThingDef/DMS_Vault.xml

+++ DMS2/NewContent/Languages/English/DefInjected/ThingDef/DMS_Vault.xml

@@ -0,0 +1,22 @@

+<?xml version="1.0" encoding="utf-8"?>
+<LanguageData>
+
+  <DMS_VaultElevator.label>freight elevator</DMS_VaultElevator.label>
+  <DMS_VaultElevator.description>The entrance to a buried military storage vault. The lift still has power, but its controls are locked. Hack it to bring the car up.</DMS_VaultElevator.description>
+
+  <DMS_VaultElevator_Sealed.label>sealed freight elevator</DMS_VaultElevator_Sealed.label>
+  <DMS_VaultElevator_Sealed.description>The surface pad of a buried freight elevator, locked down under an armored cover plate. The shaft controls are tied to a nearby access console; swipe a key-card there to retract the cover and bring the car up.</DMS_VaultElevator_Sealed.description>
+
+  <DMS_VaultElevatorExit.label>freight elevator car</DMS_VaultElevatorExit.label>
+  <DMS_VaultElevatorExit.description>A lift car which links to the surface pad above.</DMS_VaultElevatorExit.description>
+
+  <DMS_MechCapsule_VaultInfantry.label>mothballed mech</DMS_MechCapsule_VaultInfantry.label>
+  <DMS_MechCapsule_VaultInfantry.description>A line infantry automatroid in hibernation mode, sealed in a storage cradle. The vault lost power before anyone came to collect it. A mechanitor can attempt to hack and control it.</DMS_MechCapsule_VaultInfantry.description>
+
+  <DMS_MechCapsule_VaultAssault.label>mothballed mech</DMS_MechCapsule_VaultAssault.label>
+  <DMS_MechCapsule_VaultAssault.description>An assault-pattern automatroid in hibernation mode, clamped into a maintenance cradle with its actuator bays still open. The vault was sealed before the servicing was finished. A mechanitor can attempt to hack and control it.</DMS_MechCapsule_VaultAssault.description>
+
+  <DMS_MechCapsule_VaultFrame.label>mothballed battle frame</DMS_MechCapsule_VaultFrame.label>
+  <DMS_MechCapsule_VaultFrame.description>A battle frame in hibernation mode, pinned into a service gantry for long-term storage. Its command authentication expired with the unit that owned it. A mechanitor can attempt to hack and control it.</DMS_MechCapsule_VaultFrame.description>
+
+</LanguageData>

--- DMS1/NewContent/Languages/English/DefInjected/ThingDef/DMS_Vault_Treasury.xml

+++ DMS2/NewContent/Languages/English/DefInjected/ThingDef/DMS_Vault_Treasury.xml

@@ -0,0 +1,18 @@

+<?xml version="1.0" encoding="utf-8"?>
+<LanguageData>
+
+  <DMS_VaultConsole.label>security console</DMS_VaultConsole.label>
+  <DMS_VaultConsole.description>The vault's access-control terminal. The sealed storage doors answer only to this console, and its credentials expired along with the unit that owned the place. Hack it to release the doors.</DMS_VaultConsole.description>
+  <DMS_VaultConsole.comps.0.notHackedInspectString>Hack to release the sealed storage doors.</DMS_VaultConsole.comps.0.notHackedInspectString>
+  <DMS_VaultConsole.comps.0.hackedInspectString>Storage doors released.</DMS_VaultConsole.comps.0.hackedInspectString>
+  <DMS_VaultConsole.comps.0.hackedMessage>{HACKER_labelShort} has finished hacking {SUBJECT_labelNoParenthesisDef}.</DMS_VaultConsole.comps.0.hackedMessage>
+  <DMS_VaultConsole.comps.0.hackedLetterLabel>Storage doors released</DMS_VaultConsole.comps.0.hackedLetterLabel>
+  <DMS_VaultConsole.comps.0.hackedLetterText>Someone has broken into the vault's access-control system. The sealed storage doors are open.</DMS_VaultConsole.comps.0.hackedLetterText>
+
+  <DMS_VaultGateConsole.label>gate console</DMS_VaultGateConsole.label>
+  <DMS_VaultGateConsole.description>The control terminal for a sector gate. The gate's sealed doors answer only to this console, and its credentials expired along with the unit that owned the place. Hack it to open the gate.</DMS_VaultGateConsole.description>
+  <DMS_VaultGateConsole.comps.0.notHackedInspectString>Hack to open the sector gate.</DMS_VaultGateConsole.comps.0.notHackedInspectString>
+  <DMS_VaultGateConsole.comps.0.hackedInspectString>Sector gate open.</DMS_VaultGateConsole.comps.0.hackedInspectString>
+  <DMS_VaultGateConsole.comps.0.hackedMessage>{HACKER_labelShort} has opened the sector gate.</DMS_VaultGateConsole.comps.0.hackedMessage>
+
+</LanguageData>

