--- DMS1/CE/Patches/RecoillessRack_CE.xml

+++ DMS2/CE/Patches/RecoillessRack_CE.xml

@@ -0,0 +1,55 @@

+<?xml version="1.0" encoding="utf-8"?>
+
+<!--
+	CE: 戰鬥框架無後座力砲掛架的開火能力 (DMS_BF_RecoillessShot)。
+
+	1. 彈道換成 CE 本體的 M72 LAW 彈頭 Bullet_M72LAW（CE_DisposableRocketLauncher 用的那顆）。
+	   原版打的 DMS_Bullet_LRR_HEAT 是 vanilla Projectile，armorPenetrationBase 走 0~2 的
+	   倍率制，在 CE 的 mm 制裝甲下等同無效。CE 的
+	   CombatExtended.HarmonyCE.Harmony_CompAbilityEffect_LaunchProjectile 會在 projectileDef
+	   的 thingClass 繼承自 ProjectileCE 時攔截 CompAbilityEffect_LaunchProjectile，改走
+	   CE_Utility.LaunchProjectileCE，所以只換 projectileDef 即可，不必動 verbClass。
+	2. 備彈 2 -> 1、補彈 30000 -> 60000 tick：CE 的聚能裝藥破甲量遠高於原版，
+	   同樣的密度會讓掛架單獨處理掉整波裝甲目標
+	3. 射程 29.9 -> 39.9：CE 底下同級的 4KG 輕型無後座力砲射程為 44，
+	   掛架取略低於手持型的值
+
+	注意：這裡沒有做「消耗 CE 彈藥」。CE 的彈藥消耗走 Verb.EquipmentSource ->
+	CompAmmoUser，而 hediff 授予的能力沒有 EquipmentSource，純 XML 無法接上；
+	要真的吃彈藥必須在 FortifiedCE 加一個 AbilityComp。
+-->
+<Patch>
+	<Operation Class="PatchOperationSequence">
+		<operations>
+
+			<li Class="PatchOperationReplace">
+				<xpath>Defs/AbilityDef[defName="DMS_BF_RecoillessShot"]/comps/li[@Class="CompProperties_AbilityLaunchProjectile"]/projectileDef</xpath>
+				<value>
+					<projectileDef>Bullet_M72LAW</projectileDef>
+				</value>
+			</li>
+
+			<li Class="PatchOperationReplace">
+				<xpath>Defs/AbilityDef[defName="DMS_BF_RecoillessShot"]/charges</xpath>
+				<value>
+					<charges>1</charges>
+				</value>
+			</li>
+
+			<li Class="PatchOperationReplace">
+				<xpath>Defs/AbilityDef[defName="DMS_BF_RecoillessShot"]/cooldownTicksRange</xpath>
+				<value>
+					<cooldownTicksRange>60000</cooldownTicksRange>
+				</value>
+			</li>
+
+			<li Class="PatchOperationReplace">
+				<xpath>Defs/AbilityDef[defName="DMS_BF_RecoillessShot"]/verbProperties/range</xpath>
+				<value>
+					<range>39.9</range>
+				</value>
+			</li>
+
+		</operations>
+	</Operation>
+</Patch>

--- DMS1/CE/Patches/Weapons/AmmoSwitch_CE_Remove.xml

+++ DMS2/CE/Patches/Weapons/AmmoSwitch_CE_Remove.xml

@@ -0,0 +1,61 @@

+<?xml version="1.0" encoding="utf-8"?>
+
+<!--
+  CE 環境下把 FFF 的 AmmoSwitch 整組拆掉。
+
+  1) verb: PatchOperationMakeGunCECompatible 會 append 一個 CombatExtended.VerbPropertiesCE,
+     但它清除舊 verb 的 xpath 只認
+         li[verbClass="Verb_Shoot" or verbClass="Verb_ShootOneUse" or verbClass="Verb_LaunchProjectile"]
+     認不得 Fortified.Verb_Shoot_AmmoSwitch / Fortified.Verb_LaunchProjectile_AmmoSwitch。
+     結果舊 verb 留著, 武器變成兩個 verb, 而 VerbTracker.PrimaryVerb 取第一個,
+     也就是非 CE 的 AmmoSwitch verb, CE 的彈道 / CompAmmoUser / 開火模式全部失效。
+     所以這裡要自己把 AmmoSwitch 的 verb 拔掉, 空出位置給 CE 補上的 VerbPropertiesCE。
+
+  2) comp: 留著 CompProperties_AmmoSwitch 玩家會看到一個按了沒反應的切換彈種按鈕。
+     對應的彈丸 def 保留 - CE 會把它們轉成自己的 AmmoDef 來源。
+
+  ※ 這裡列到的每一把槍都必須在 CE/Patches 底下有對應的 PatchOperationMakeGunCECompatible,
+    否則拔掉 verb 之後會變成沒有 verb 的槍。目前 11 把 (含 AncientCorps 的 KS-23K、AGL 手持/陣地兩型) 都有。
+  ※ 本操作與 MakeGunCECompatible 的先後順序無關: 先拔後補 / 先補後拔結果都是剛好一個 verb,
+    所以不必在意 Patches 底下的檔案載入順序 (Buildings/ 會排在 Weapons/ 前面)。
+  ※ verb 被換掉之後, 原本的 DefName.verbs.Verb_*_AmmoSwitch.label 翻譯會失效,
+    CE 版的標籤補在 1.6/CE/Languages/*/DefInjected/ThingDef/AmmoSwitch_CE.xml (verbs.Verb_ShootCE.label)。
+-->
+<Patch>
+    <Operation Class="PatchOperationSequence">
+        <operations>
+
+            <!-- 拔掉 CE 認不得的 AmmoSwitch verb -->
+            <li Class="PatchOperationRemove">
+                <xpath>Defs/ThingDef[defName="DMS_Revolver" or
+                                     defName="DMS_RiotShotgun" or
+                                     defName="DMS_AssaultShotgun" or
+                                     defName="DMS_HeavyMachineGun" or
+                                     defName="DMS_Gun_HeavyMachineGun" or
+                                     defName="DMS_AutomaticGrenadeLauncher" or
+                                     defName="DMS_Gun_AutomaticGrenadeLauncher" or
+                                     defName="DMS_Autocannon" or
+                                     defName="DMS_Gun_Recoilless" or
+                                     defName="DMS_Gun_RecoillessLight"
+                                    ]/verbs/li[verbClass="Fortified.Verb_Shoot_AmmoSwitch" or
+                                               verbClass="Fortified.Verb_LaunchProjectile_AmmoSwitch"]</xpath>
+            </li>
+
+            <!-- 拔掉切換彈種的 comp -->
+            <li Class="PatchOperationRemove">
+                <xpath>Defs/ThingDef[defName="DMS_Revolver" or
+                                     defName="DMS_RiotShotgun" or
+                                     defName="DMS_AssaultShotgun" or
+                                     defName="DMS_HeavyMachineGun" or
+                                     defName="DMS_Gun_HeavyMachineGun" or
+                                     defName="DMS_AutomaticGrenadeLauncher" or
+                                     defName="DMS_Gun_AutomaticGrenadeLauncher" or
+                                     defName="DMS_Autocannon" or
+                                     defName="DMS_Gun_Recoilless" or
+                                     defName="DMS_Gun_RecoillessLight"
+                                    ]/comps/li[@Class="Fortified.CompProperties_AmmoSwitch"]</xpath>
+            </li>
+
+        </operations>
+    </Operation>
+</Patch>

