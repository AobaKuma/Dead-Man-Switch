<LanguageData>

  <!-- EN: challenge -->
  <DMS_GravekeeperChallengeTalk.label>challenge</DMS_GravekeeperChallengeTalk.label>
  <!-- [INITIATOR_nameDef] is the gravekeeper, [RECIPIENT_nameDef] the intruder; phrased like the vanilla interaction logs. -->
  <DMS_GravekeeperChallengeTalk.logRulesInitiator.rulesStrings>
    <li>r_logentry(p=3)->[INITIATOR_nameDef] [challenged] [RECIPIENT_nameDef].</li>
    <li>r_logentry->[INITIATOR_nameDef] [demanded] [RECIPIENT_nameDef]'s [credential].</li>
    <li>r_logentry->[INITIATOR_nameDef] ordered [RECIPIENT_nameDef] to [order].</li>
    <li>r_logentry->[INITIATOR_nameDef] [scanned] [RECIPIENT_nameDef] and found no [credential].</li>
    <li>r_logentry->[INITIATOR_nameDef] blocked [RECIPIENT_nameDef]'s path and [challenged] [RECIPIENT_objective].</li>
    <li>r_logentry->[INITIATOR_nameDef] recited a centuries-old security protocol to [RECIPIENT_nameDef].</li>

    <li>challenged(p=3)->challenged</li>
    <li>challenged->stopped and questioned</li>
    <li>challenged->interrogated</li>
    <li>challenged->halted</li>
    <li>challenged->sternly questioned</li>
    <li>challenged->ran a security check on</li>

    <li>demanded(p=3)->demanded</li>
    <li>demanded->asked for</li>
    <li>demanded->insisted on seeing</li>
    <li>demanded->requested</li>

    <li>credential->clearance</li>
    <li>credential->access code</li>
    <li>credential->identification</li>
    <li>credential->security pass</li>
    <li>credential->unit designation</li>
    <li>credential->authorization</li>

    <li>scanned->scanned</li>
    <li>scanned->swept a sensor over</li>
    <li>scanned->checked</li>

    <li>order->halt</li>
    <li>order->stand still</li>
    <li>order->withdraw</li>
    <li>order->state [RECIPIENT_possessive] business</li>
    <li>order->identify [RECIPIENT_objective]self</li>
    <li>order->leave the installation</li>
  </DMS_GravekeeperChallengeTalk.logRulesInitiator.rulesStrings>

</LanguageData>
