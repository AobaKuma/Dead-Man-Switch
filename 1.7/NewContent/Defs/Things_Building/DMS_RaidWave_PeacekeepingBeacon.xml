<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="DMS_BossCallerBase">
    <defName>DMS_RaidWaveBeacon_PeacekeepingOperators</defName>
    <uiOrder>6030</uiOrder>
    <label>remnant distress beacon</label>
    <description>A configurable distress beacon. Select peacekeeping, counter-terrorism or infantry forces before activation. The signal summons the selected detachment and reveals its associated boss installation. Single use.</description>
    <descriptionHyperlinks>
      <ThingDef>DMS_Mech_Protector</ThingDef>
      <ThingDef>DMS_Mech_Ronin</ThingDef>
      <ThingDef>DMS_Mech_Falcon</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Building/Facility_Base</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shadowData>
        <volume>(1.2, 0.6, 0.6)</volume>
        <offset>(0.1, 0, 0)</offset>
      </shadowData>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <size>(1,1)</size>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>DMS_DeadMansSwitch</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>TriggerObject</useJob>
        <useLabel>Broadcast selected distress signal</useLabel>
        <useDuration>900</useDuration>
        <floatMenuFactionIcon>DMS_Legacy</floatMenuFactionIcon>
      </li>
      <li Class="DMS.CompProperties_SelectableRaidGroup">
        <groups>
          <li>
            <labelKey>DMS_RaidGroup_Peacekeeping</labelKey>
            <raidWave>DMS_RaidWave_PeacekeepingOperators</raidWave>
            <quest>DMS_AirportAssault</quest>
            <!-- Optional: omit researchPrerequisites to keep this option unlocked. All listed projects are required. -->
          </li>
          <li>
            <labelKey>DMS_RaidGroup_CounterTerrorism</labelKey>
            <raidWave>DMS_RaidWave_CounterTerrorism</raidWave>
            <quest>DMS_ResidentialAssault</quest>
            <researchPrerequisites><li>DMS_AdvancedControl</li></researchPrerequisites>
          </li>
          <li>
            <labelKey>DMS_RaidGroup_Infantry</labelKey>
            <raidWave>DMS_RaidWave_Infantry</raidWave>
            <quest>DMS_ArsenalAssault</quest>
            <researchPrerequisites><li>DMS_Hypothesis</li></researchPrerequisites>
          </li>
        </groups>
      </li>
    </comps>
  </ThingDef>
</Defs>