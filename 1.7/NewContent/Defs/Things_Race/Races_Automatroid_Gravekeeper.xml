          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.4</drawSize>
          <shadowData>
            <volume>(1.1,1,1.1)</volume>
            <offset>(0,0,-0.45)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Automatroid/Gravekeeper/gravekeeper_B</texPath>
          <shaderType>CutoutComplex</shaderType>
