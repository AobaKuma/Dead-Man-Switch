  <!-- ===== 斯圖格納導彈 / Stugna missiles =====
       與龍騎兵的斯圖格納發射器同樣兩發，但機兵沒有彈藥可裝填，改成每發獨立冷卻一天。
       導彈與彈藥在 AncientCorps 裡，所以這裡另做一枚只用 DMS 核心與 FFF 資源的導彈。
       Two missiles like the dragoon's Stugna launcher, but a mech has no ammo to reload, so each
       charge recovers on its own after a day. The dragoon's missile and ammo live in AncientCorps,
       so this missile only uses DMS core and FFF assets. -->
  <AbilityDef>
    <defName>DMS_GravekeeperStugna</defName>
    <label>Stugna missile</label>
    <description>Fire one of the two Stugna anti-tank guided missiles racked on the shoulder launcher. The shaped charge punches through heavy armor, but locking on takes time and needs a clear line of sight. Each missile is replaced a day after it is fired.</description>
    <iconPath>UI/Ability/Missile</iconPath>
    <aiCanUse>true</aiCanUse>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <charges>2</charges>
    <cooldownPerCharge>true</cooldownPerCharge>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <minRange>6.9</minRange>
      <range>44.9</range>
      <warmupTime>3</warmupTime>
      <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
      <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
      <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      <ai_TargetHasRangedAttackScoreOffset>50</ai_TargetHasRangedAttackScoreOffset>
      <soundCast>RocketswarmLauncher_Fire</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
      <requireLineOfSight>true</requireLineOfSight>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>DMS_Bullet_GravekeeperStugna</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>DMS_Bullet_GravekeeperStugna</defName>
    <label>Stugna missile</label>
    <graphicData>
      <texPath>Things/Ammo/76mm9M311Missile/Projectile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>1.25</drawSize>
    </graphicData>
    <thingClass>Fortified.Projectile_Parabola_ConeExplosive</thingClass>
    <projectile>
      <damageDef>FFF_ShapeChargeBullet</damageDef>
      <speed>80</speed>
      <damageAmountBase>160</damageAmountBase>
      <armorPenetrationBase>2</armorPenetrationBase>
      <explosionRadius>1.95</explosionRadius>
      <flyOverhead>true</flyOverhead>
      <explosionRadiusDisplayPadding>3</explosionRadiusDisplayPadding>
      <arcHeightFactor>0.1</arcHeightFactor>
      <soundExplode>Explosion_Rocket</soundExplode>
    </projectile>
    <comps>
      <li Class="Fortified.CompProperties_AfterBurner">
        <lifeTime>60</lifeTime>
        <ExhaustFleck>DMS_Fleck_RocketFlame</ExhaustFleck>
        <ExhaustCurve>
          <points>
            <li>(0,3)</li>
            <li>(0.15,2)</li>
            <li>(0.5,1)</li>
          </points>
        </ExhaustCurve>
        <SmokeFleck>DMS_Fleck_RocketSmokeTrail</SmokeFleck>
        <SmokeCurve>
          <points>
            <li>(0,3)</li>
            <li>(0.5,1)</li>
            <li>(0.9,1)</li>
            <li>(1,0.5)</li>
          </points>
        </SmokeCurve>
      </li>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>DMS_LaunchDust_Recoilless</effecterDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="Fortified.ExplosiveExtension">
        <preExplosionOffset>1.5</preExplosionOffset>
        <effecterDef>FFF_Effecter_Penetrate_Sabot</effecterDef>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
