  <!-- 送葬者 / Enterrador -->
  <PawnKindDef ParentName="DMS_MechGravekeeperKindBase">
    <defName>DMS_Mech_Gravekeeper_Enterrador</defName>
    <label>Enterrador</label>
    <race>DMS_Mech_Gravekeeper_Stugna</race>
    <combatPower>550</combatPower>
    <weaponTags Inherit="False">
      <li>H_Gatling127mm</li>                                                       <!--GAU-19-->
