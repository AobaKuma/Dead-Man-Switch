<LanguageData>

  <!-- EN: tungsteel foundry -->
  <DMS_FT2_TungsteelFoundry.label>鎢鋼冶煉廠</DMS_FT2_TungsteelFoundry.label>
  <!-- EN: Alloys local metal into tungsteel for armour plating and heavy frames. Taxes can send tungsteel home. -->
  <DMS_FT2_TungsteelFoundry.description>將本地金屬冶煉成鎢鋼，供裝甲板與重型框架使用。稅收可將鎢鋼送回殖民地。</DMS_FT2_TungsteelFoundry.description>
  <!-- EN: salvage smelter / bloomery forge / tungsteel foundry / integrated alloy complex / metallurgy industrial park / foundry cluster -->
  <DMS_FT2_TungsteelFoundry.tierLabels>
    <li>拾荒熔爐</li>
    <li>塊煉鍛爐</li>
    <li>鎢鋼冶煉廠</li>
    <li>鎢鋼複合冶煉設施</li>
    <li>冶金產業園區</li>
    <li>冶金工廠群</li>
  </DMS_FT2_TungsteelFoundry.tierLabels>

  <!-- EN: component stamping plant -->
  <DMS_FT2_StampingPlant.label>沖壓零件廠</DMS_FT2_StampingPlant.label>
  <!-- EN: Mass-produces cheap stamped components for field equipment. Taxes can send components home. -->
  <DMS_FT2_StampingPlant.description>大量生產廉價的沖壓零件，供野戰裝備使用。稅收可將零件送回殖民地。</DMS_FT2_StampingPlant.description>
  <!-- EN: salvage parts bench / die-press shop / component stamping plant / component production complex / component industrial park / component factory cluster -->
  <DMS_FT2_StampingPlant.tierLabels>
    <li>拾荒零件台</li>
    <li>模壓工坊</li>
    <li>沖壓零件廠</li>
    <li>零件複合生產設施</li>
    <li>零件生產園區</li>
    <li>零件工廠群</li>
  </DMS_FT2_StampingPlant.tierLabels>

  <!-- EN: artiprotein vats -->
  <DMS_FT2_ArtiproteinVats.label>人造蛋白槽</DMS_FT2_ArtiproteinVats.label>
  <!-- EN: Cultures artificial protein independent of soil and weather. Taxes can send artiprotein home. -->
  <DMS_FT2_ArtiproteinVats.description>培養人造蛋白，不受土壤與天候影響。稅收可將人造蛋白送回殖民地。</DMS_FT2_ArtiproteinVats.description>
  <!-- EN: ration fermenting pit / brewing vats / artiprotein vats / protein culture complex / food production park / food factory cluster -->
  <DMS_FT2_ArtiproteinVats.tierLabels>
    <li>口糧發酵坑</li>
    <li>釀造槽</li>
    <li>人造蛋白槽</li>
    <li>蛋白複合培養設施</li>
    <li>食品生產園區</li>
    <li>食品工廠群</li>
  </DMS_FT2_ArtiproteinVats.tierLabels>

  <!-- EN: synthetic fibre mill -->
  <DMS_FT2_SyntheticFibreMill.label>化纖紡織廠</DMS_FT2_SyntheticFibreMill.label>
  <!-- EN: Spins polyester and, with spacer technology, plasfiber for uniforms and webbing. Taxes can send fabric home. -->
  <DMS_FT2_SyntheticFibreMill.description>紡製聚酯纖維，具備太空科技後亦可生產等離子纖維，供軍服與織帶使用。稅收可將布料送回殖民地。</DMS_FT2_SyntheticFibreMill.description>
  <!-- EN: salvage cordage shed / weaving shed / synthetic fibre mill / textile production complex / textile industrial park / textile mill cluster -->
  <DMS_FT2_SyntheticFibreMill.tierLabels>
    <li>拾荒繩索棚</li>
    <li>織布棚</li>
    <li>化纖紡織廠</li>
    <li>紡織複合生產設施</li>
    <li>紡織產業園區</li>
    <li>紡織工廠群</li>
  </DMS_FT2_SyntheticFibreMill.tierLabels>

  <!-- EN: field supply depot -->
  <DMS_FT2_FieldSupplyDepot.label>前線補給站</DMS_FT2_FieldSupplyDepot.label>
  <!-- EN: Stockpiles combat rations and field medicine for the garrison. Taxes can send military supplies home. -->
  <DMS_FT2_FieldSupplyDepot.description>為駐軍囤積作戰口糧與野戰醫療用品。稅收可將軍需品送回殖民地。</DMS_FT2_FieldSupplyDepot.description>
  <!-- EN: supply cache / quartermaster's store / field supply depot / logistics complex / logistics park / depot cluster -->
  <DMS_FT2_FieldSupplyDepot.tierLabels>
    <li>補給藏匿點</li>
    <li>軍需官倉庫</li>
    <li>前線補給站</li>
    <li>後勤複合設施</li>
    <li>後勤園區</li>
    <li>倉儲基地群</li>
  </DMS_FT2_FieldSupplyDepot.tierLabels>

