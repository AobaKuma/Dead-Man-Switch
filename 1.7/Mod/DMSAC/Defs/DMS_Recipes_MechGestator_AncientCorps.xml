<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 古代機兵（AncientCorps）聯動：古機單位的培育配方，全部掛在 II 級封存檔案「主戰規格」底下。
       只在 AncientCorps 啟用時載入（LoadFolders.xml → 1.7/Mod/DMSAC）。
       重型走小型培育艙、超重型走大型培育艙；培育時取該種族的第一個 PawnKind（基本型號），
       武器照 PawnKind 的 weaponTags 生成，跟其他 DMS 機兵一樣。
       海盜改裝的籬笆（DMS_Mech_Zabor_Pirate）不開放。復活清單由 AncientCorps 自己的 Additional_Resurrect.xml 處理。
       AncientCorps integration: gestation recipes for the ancient corps units, all under the class II sealed file
       "main battle specification". Only loaded when AncientCorps is active (LoadFolders.xml → 1.7/Mod/DMSAC).
       Heavy units use the small gestator, ultra-heavies the large one. Gestation takes the race's first PawnKind
       (the base pattern) and arms it from that kind's weaponTags, like every other DMS mech.
       The pirate-modified Zabor (DMS_Mech_Zabor_Pirate) stays unbuildable. AncientCorps' own Additional_Resurrect.xml
       already covers resurrection. -->
  <RecipeDef Name="DMSAC_HeavyRecipeBase" ParentName="DMS_HeavyMechanoidRecipe" Abstract="True">
    <researchPrerequisite>DMS_Occultech_MainBattle</researchPrerequisite>
    <gestationCycles>3</gestationCycles>
  </RecipeDef>

  <RecipeDef Name="DMSAC_UltraHeavyRecipeBase" ParentName="DMS_SuperHeavyMechanoidRecipe" Abstract="True">
    <researchPrerequisite>DMS_Occultech_MainBattle</researchPrerequisite>
    <gestationCycles>6</gestationCycles>
  </RecipeDef>

  <!-- BR-3 磨坊 / BR-3 Molot -->
  <RecipeDef ParentName="DMSAC_HeavyRecipeBase">
    <defName>DMSAC_Make_Molot</defName>
    <label>Gestate BR-3 "Molot"</label>
    <description>Gestate a BR-3 "Molot", the infantry combat platform of the ancient corps. Its production pattern was drawn up under the same main battle specification as the gravekeeper.</description>
    <products>
      <DMS_Mech_Molot>1</DMS_Mech_Molot>
    </products>
    <descriptionHyperlinks>
      <ThingDef>DMS_Mech_Molot</ThingDef>
    </descriptionHyperlinks>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>200</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Tungsteel</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentStamped</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
    </ingredients>
  </RecipeDef>

