<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- DMS_AutoMill 自動磨床 : 半自動版本的石材加工桌
       自動工作台共用 DMS_Autofacturers 下拉選單；原版依 Def 載入順序取第一個當預設，1.7/CE 又比 1.7 先載入，
       所以由 DMS.Patch_AutofacturerDropdownOrder 依 uiOrder 重排，開不開 CE 自動磨床（1040）都排第一。
       The automated workbenches share the DMS_Autofacturers dropdown. Vanilla shows whichever entry loads first and
       1.7/CE loads before 1.7, so DMS.Patch_AutofacturerDropdownOrder re-sorts it by uiOrder; the auto mill (1040) stays
       first with or without CE. -->
  <ThingDef ParentName="DMS_AutofacturerBenchBase">
    <defName>DMS_AutoMill</defName>
    <uiOrder>1040</uiOrder>
    <label>Auto mill</label>
    <!-- 一台以連續進料的方式運轉的自動化石材加工機，只要備妥原料便能無人值守地持續產出石磚。 -->
    <description>An automated milling bench fed by a continuous feed line. Once loaded with raw chunks it grinds and cuts stone blocks unattended, trading precision for the ability to run without an operator.</description>
    <graphicData>
      <texPath>Things/Building/AutoMill</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <designationCategory>DMS_Category</designationCategory>
    <costList>
      <Steel>180</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>2500</WorkToBuild>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0.25</Flammability>
      <Cleanliness>-5</Cleanliness>
      <WorkTableWorkSpeedFactor>0.75</WorkTableWorkSpeedFactor>
    </statBases>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <size>(3,2)</size>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <recipes />
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>500</basePowerConsumption>
        <idlePowerDraw>30</idlePowerDraw>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DMS_Material</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="Fortified.ModExtension_AutoWorkTable">
        <workAmountPerStage>5000</workAmountPerStage>
        <pullFromLinkedStorage>true</pullFromLinkedStorage>
        <autoEjectProducts>true</autoEjectProducts>
        <phaseEffecter_east>DMS_Effect_Printer_East</phaseEffecter_east>
        <phaseEffecter_west>DMS_Effect_Printer_West</phaseEffecter_west>
        <phaseEffecter_north>DMS_Effect_Printer_North</phaseEffecter_north>
        <phaseEffecter_south>DMS_Effect_Printer_South</phaseEffecter_south>
      </li>
      <li Class="Fortified.ModExtension_RecipeInheritance">
        <inheritRecipesFrom>
          <li>TableButcher</li>
        </inheritRecipesFrom>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
