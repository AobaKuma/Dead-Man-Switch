<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DMS_OccultTechFont</defName>
    <label>Stele</label>
    <description>A databank holding technical data and backups of colonial records, along with case analyses and post-incident reviews of every accident that has occurred across all colonization programs to date. A stele serves both as the medium through which the colonial fleets share experience and knowledge with their kin across star systems, and as a backup database buried deep beneath every colonized world. Complex encryption and verification algorithms keep its records from being lost over long voyages through space or ages sealed underground, while also preventing anyone outside the colonial fleets from obtaining the dangerous technology within.\n\nRumor has it that decoding techniques leaked by fleet deviants can perform a destructive scan to extract the data inside, but using such techniques may draw the hostility of the colonial fleets.</description>
    <graphicData>
      <texPath>Things/Building/Stele/Stele</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(7,7)</drawSize>
      <drawOffset>(0,1.2,1.25)</drawOffset>
      <shadowData>
        <volume>(3,4,3)</volume>
      </shadowData>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>50</pathCost>
    <tickerType>Rare</tickerType>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>6000</MaxHitPoints>
      <WorkToBuild>80000</WorkToBuild>
      <Mass>500</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <!-- 玩家不可建造：只能從石碑任務線（DMS_Stele）取得。 -->
    <designationCategory>FFF_DevCategory</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <!-- 可微縮：石碑封藏庫的石碑要佔領、拆卸後運回據點（500 kg）。不進貿易池。
         Minifiable: the vault's stele is claimed, uninstalled and hauled home (500 kg). Kept out of trade. -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <tradeability>None</tradeability>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="Fortified.CompProperties_OccultechSource">
        <totalReserve>4000</totalReserve>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>DMS_OccultechExtractor</defName>
    <label>Decoder</label>
    <description>A destructive decoding rig. It fires a high-energy laser through the holographic storage plates inside a stele and analyzes the scattered spectrum to read the data within: the only way for factions outside the colonial fleets to access a stele's contents. Set it flush against a stele and supply power, and it will continuously extract the knowledge and file it into your expeditional research, no researcher required. Extraction stops if the stele runs dry, power is lost, or no stele is in front of it. It can be uninstalled and reinstalled elsewhere.</description>
    <graphicData>
      <texPath>Things/Building/Stele/SteleDecoder</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,3)</drawSize>
      <damageData>
        <rect>(0,0,2,1)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>30</pathCost>
    <tickerType>Rare</tickerType>
    <size>(1,2)</size>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <designationCategory>DMS_Category</designationCategory>
    <researchPrerequisites>
      <li>DMS_Occultech_QubitDecryption</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <!-- 可移動：允許卸除、搬運後重新安裝於他處。 -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <idlePowerDraw>50</idlePowerDraw>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="Fortified.CompProperties_OccultechExtractor">
        <knowledgePerDay>50</knowledgePerDay>
        <knowledgeCategory>DMS_Restricted</knowledgeCategory>
      </li>
    </comps>
  </ThingDef>

  <!-- ============================================================= -->
  <!-- 水壓裂解採礦機：封存檔案 I 級（DMS_Occultech_HydraulicFracturing） -->
  <!-- 不需要人操作的 3×3 自動深鑽機（DMS.CompHydraulicFracturing）：    -->
  <!-- 有電時每 6 小時一份；範圍內有深層礦脈就照原版份量開採，           -->
  <!-- 採盡後改產化合燃料（3/4）或鋼鐵（1/4）。每份汙染周圍 6 格土地。    -->
  <!-- ============================================================= -->
  <ThingDef ParentName="BuildingBase">
    <defName>DMS_HydraulicFracturingRig</defName>
    <label>hydraulic fracturing rig</label>
    <description>An automatic deep drill that splits the bedrock with ultra-high-pressure fluid and needs no operator. While powered it produces a portion every 6 hours: deep deposits in range are mined first, then chemfuel or steel is drawn from the bedrock once they run out.\n\nEvery portion pollutes the ground nearby. Can be uninstalled and moved.</description>
    <descriptionHyperlinks>
      <ThingDef>Chemfuel</ThingDef>
      <ThingDef>Steel</ThingDef>
    </descriptionHyperlinks>
    <thingClass>Building</thingClass>
    <!-- 噴發效果要每 tick 冒蒸氣，所以用 Normal；生產邏輯仍是每 250 ticks 跑一次。 -->
    <tickerType>Normal</tickerType>
    <!-- 浮動部件（CompFloatingGraphic）要逐幀繪製。The floating part is drawn every frame. -->
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <!-- 底座框架；鑽塔（_top）由下方 CompProperties_FloatingGraphic 另外畫。The base frame; the derrick (_top) is drawn by the CompProperties_FloatingGraphic below. -->
      <texPath>Things/Building/DMS_HydraulRig</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <shadowData>
        <volume>(2.6, 1, 2.6)</volume>
      </shadowData>
    </graphicData>
    <!-- 底座加鑽塔的合成圖。Base and derrick composited. -->
    <uiIconPath>Things/Building/DMS_HydraulRig_icon</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <!-- 不可通行的玩家建築必須完全掩蔽（fillPercent 1），否則原版會報 config error；同原版污染性發電機。 -->
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <!-- 掃描深層礦脈的範圍，與 comp 的 scanRadius 一致；汙染範圍由 comp 另外畫。 -->
    <specialDisplayRadius>6</specialDisplayRadius>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>15000</WorkToBuild>
      <Mass>80</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-40</Beauty>
      <SellPriceFactor>0.7</SellPriceFactor>
    </statBases>
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>DMS_Category</designationCategory>
    <researchPrerequisites>
      <li>DMS_Occultech_HydraulicFracturing</li>
    </researchPrerequisites>
    <placeWorkers>
      <!-- 放置時顯示深層礦脈；沒有岩床又沒有礦脈的地方不能放。Shows deep deposits while placing. -->
      <li>PlaceWorker_DeepDrill</li>
      <li>PlaceWorker_InvalidOverSubstructure</li>
    </placeWorkers>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <building>
      <uninstallWork>3000</uninstallWork>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <repairEffect>Repair</repairEffect>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>800</basePowerConsumption>
        <soundAmbientPowered>GeothermalPlant_Ambience</soundAmbientPowered>
      </li>
      <li Class="DMS.CompProperties_HydraulicFracturing">
        <!-- 6 小時一份，一天 4 份。6 hours per portion, 4 a day. -->
        <ticksPerPortion>15000</ticksPerPortion>
        <scanRadius>6</scanRadius>
        <yieldFactor>1</yieldFactor>
        <fallbackYields>
          <li>
            <thingDef>Chemfuel</thingDef>
            <count>20</count>
            <weight>3</weight>
          </li>
          <li>
            <thingDef>Steel</thingDef>
            <count>15</count>
            <weight>1</weight>
          </li>
        </fallbackYields>
        <!-- 約 700 格，每天汙染 24 格，一個月左右汙染滿。About 700 cells at 24 a day: saturated in about a month. -->
        <pollutionRadius>14.9</pollutionRadius>
        <cellsPollutedPerPortion>6</cellsPollutedPerPortion>
        <!-- 運轉中像蒸氣間歇泉一樣間歇噴發（數值同原版間歇泉），每產出一份也噴一次。
             Sprays like a steam geyser while running (same numbers as the vanilla geyser), plus once per portion. -->
        <sprayIntervalTicks>500~2000</sprayIntervalTicks>
        <sprayDurationTicks>200~500</sprayDurationTicks>
        <sprayThickness>0.6</sprayThickness>
        <!-- 鑽塔頂端的孔蓋（鑽塔靜止時），運作中會跟著鑽塔升降。The hatch on top of the derrick at rest; follows the derrick while running. -->
        <sprayOffset>(0,0,2.4)</sprayOffset>
        <spraySound>GeyserSpray</spraySound>
      </li>
      <!-- 鑽塔：只在實際開採時升起並浮動（CompHydraulicFracturing 回報運作狀態）。
           與底座同為 384px 畫布、同 4×4 繪製；依 _icon 合成圖對位，鑽塔畫布中心比底座高 128px = 1.333 格。
           升起高度與浮動幅度是穩定錨原本 3×3 繪製時的數值再乘 4/3。
           The derrick rises and drifts only while mining (CompHydraulicFracturing reports the state). It shares the
           base's 384px canvas and 4×4 draw size; aligned against the _icon composite, its canvas centre sits 128px =
           1.333 cells above the base's. Lift and drift are the reality anchor's old 3×3 values times 4/3. -->
      <li Class="DMS.CompProperties_FloatingGraphic">
        <graphic>
          <texPath>Things/Building/DMS_HydraulRig_top</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(4,4)</drawSize>
        </graphic>
        <offset>(0,0,1.333)</offset>
        <liftHeight>0.27</liftHeight>
        <bobAmplitude>0.065</bobAmplitude>
      </li>
    </comps>
  </ThingDef>

</Defs>
