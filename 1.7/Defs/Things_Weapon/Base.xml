<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>AutomatroidWeapon</defName>
		<label>automatroid weapon</label>
		<parent>WeaponsRanged</parent>
	</ThingCategoryDef>

	<!-- 武器造價原則: 鋼(St)對標原版同定位槍械的用鋼量, 鎢鋼(T)對應槍身結構, 衝壓零件(S)對應機構複雜度
		市值 ≈ 材料市值 + 工作量 x 0.0036; 熔煉時 costList 中的鋼/鎢鋼會自動回收 25%, smeltProducts 為額外回收
		民用/警用: 鋼 + 工業零件, 對齊原版同定位槍械
		輕型(手槍/PDW/衝鋒槍): St30~50 T15~30 S1~4, 市值約 420~660 (原版自動手槍/衝鋒手槍 30~45 鋼)
		中型(突擊步槍/霰彈/戰鬥步槍/精確射手/反器材/狙擊榴彈): St60~80 T30~50 S3~7, 市值約 680~1140 (原版步槍 60 鋼)
		陣地(LMG/HMG/AGL): St75~100 T45~55 S7~9, 市值約 1100~1380 (原版輕機槍/榴彈發射器 75 鋼)
		M214: St160 T50 S10, 市值約 1520 (原版迷你砲 160 鋼)
		重型(猿人/獒犬/龍騎兵級): St100~120 T60~80 S9~14, 市值約 1440~2000
		載具/超重型(鬣蜥/象龜/2A38M): St200 T120~130 S18~20, 市值約 2780~2980
		次世代(GAU-8/黎明之刃): St250~300 T160~200 S24~35, 市值約 4700~5030
		注意: 機兵 PawnKind 用 weaponMoney 以市值挑武器, 調整造價後需確認市值仍落在其預算內
		(例: 猿人只能拿機砲, 其 weaponMoney 下限須高於機砲市值; 鬣蜥/壁虎下限 3000 須高於 MK44) -->

	<!-- 可切換彈種的彈丸基底: CompProperties_SwitchableAmmo 讓資訊卡顯示傷害/穿甲/擊倒力 -->
	<ThingDef ParentName="BaseBullet" Name="DMS_BaseSwitchableBullet" Abstract="True">
		<comps>
			<li Class="Fortified.CompProperties_SwitchableAmmo" />
		</comps>
	</ThingDef>

	<ThingDef Name="DMS_AutomatroidGun" ParentName="BaseGun" Abstract="True">
		<soundInteract>DMS_EquipGear</soundInteract>
		<thingCategories Inherit="False">
			<li>AutomatroidWeapon</li>
		</thingCategories>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<recipeUsers Inherit="False">
				<li>DMS_TableMachinePrinter</li>
			</recipeUsers>
			<unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
		</recipeMaker>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToMake>40000</WorkToMake>
		</statBases>
		<tradeTags>
			<li>DMS_WeaponRanged</li>
		</tradeTags>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>12</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>12</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
	</ThingDef>

	<ThingDef Name="DMS_BaseMakeableGun" ParentName="DMS_AutomatroidGun" Abstract="True">
		<recipeMaker>
			<recipeUsers Inherit="False">
				<li>TableMachining</li>
				<li>DMS_TableMachinePrinter</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>

	<!-- 即使穿著動力外骨骼也沒法操作的重型槍械-->
	<ThingDef Name="DMS_AutomatroidHeavyGun" ParentName="DMS_AutomatroidGun" Abstract="True">
		<storedConceptLearnOpportunity>DMS_HeavyWeapon</storedConceptLearnOpportunity>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToMake>80000</WorkToMake>
		</statBases>
		<recipeMaker>
			<researchPrerequisites>
				<li>DMS_EquipmentHeavy</li>
			</researchPrerequisites>
		</recipeMaker>
		<tools Inherit="False">
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>24</power>
				<cooldownTime>3</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>24</power>
				<cooldownTime>3</cooldownTime>
			</li>
		</tools>
	</ThingDef>
</Defs>