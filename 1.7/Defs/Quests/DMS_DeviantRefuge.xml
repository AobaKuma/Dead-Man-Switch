<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================= -->
  <!-- 脫序者接納任務。設計見 Plans/DMS_脫序者接納任務_實作計畫.md。       -->
  <!-- 第 15 天由說書人 comp 提供一次（Patches/DMS_DeviantRefuge_Storyteller.xml）。 -->
  <!-- 接受 → 脫序者步行進場並加入 → 5 天後交付封存檔案：量子位元破譯＋2 項 I 級，  -->
  <!-- 同時與殖民艦隊敵對並啟動綁定脫序者的追殺 DMS_DeviantHunt。               -->
  <!-- Deviant refuge quest. Offered once on day 15; the deviant joins, and five days later hands over -->
  <!-- qubit decryption plus two class I files, turning the fleet hostile and starting DMS_DeviantHunt. -->
  <!-- ============================================================= -->
  <QuestScriptDef>
    <defName>DMS_DeviantRefuge</defName>
    <!-- 不進隨機任務池：IncidentDef.questScriptDef 要求 rootSelectionWeight 為 0。 -->
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <isRootSpecial>true</isRootSpecial>
    <expireDaysRange>3~5</expireDaysRange>
    <defaultChallengeRating>3</defaultChallengeRating>
    <successHistoryEvent>DMS_QuestSuccess_Occultech</successHistoryEvent>
    <failedOrExpiredHistoryEvent>DMS_QuestFailed_Occultech</failedOrExpiredHistoryEvent>
    <questNameRules>
      <rulesStrings>
        <li>questName->The Deviant</li>
        <li>questName->Deviant refuge: [deviant_nameFull]</li>
        <li>questName->A defector from the fleet</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->Someone calling [deviant_objective]self [deviant_nameFull] is hailing us on a private band. [deviant_pronoun] served on the rolls of [fleetName] until [deviant_pronoun] watched the fleet let a war that could have been avoided run its course in the name of its rules, and walked away. Now [deviant_pronoun] is wanted by the fleet and asks to settle at [map_definite].\n\n[deviant_nameDef] carries an encrypted archive copied out of the fleet's databanks. Given a few days, [deviant_pronoun] says, [deviant_pronoun] can restore its contents for us.\n\nBeware: the moment the archive is restored, [fleetName] will learn that we are sheltering [deviant_nameDef] and demand [deviant_objective] back. If we refuse, the fleet will turn hostile and keep sending hunters after [deviant_objective] until [deviant_pronoun] dies or is banished from the colony.\n\nOnly accept if you are ready to make an enemy of [fleetName].</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="DMS.QuestNode_Root_DeviantRefuge">
      <fleetFactionDef>DMS_Army</fleetFactionDef>
      <deviantKind>DMS_Deviant</deviantKind>
      <!-- 加入後幾天交付。Days from joining to the handover. -->
      <handoverDays>5</handoverDays>
      <!-- 接受後這段時間內沒有加入（找不到可進場的地圖）就判失敗。 -->
      <arrivalTimeoutDays>1</arrivalTimeoutDays>
      <guaranteedProjects>
        <li>DMS_Occultech_QubitDecryption</li>
      </guaranteedProjects>
      <randomCategory>DMS_Restricted</randomCategory>
      <randomCount>2</randomCount>
      <huntdown>DMS_DeviantHunt</huntdown>
      <!-- 引渡要求：還原完成的同時艦隊要求交人，選擇交給玩家。拒絕（或期限內不答覆）＝上面的封存檔案＋敵對＋追殺。
           Extradition demand: as the archive is restored the fleet demands the deviant; the player chooses. Refusing (or
           staying silent) gives the files above plus hostility and the hunt. -->
      <extraditionDecisionDays>2</extraditionDecisionDays>
      <extraditionGoodwill>25</extraditionGoodwill>
      <!-- 皇權 DLC：交出時一名殖民者領受的艦隊榮譽（下士一級約 10）。Royalty: fleet honor for one colonist (about one corporal step). -->
      <extraditionHonor>10</extraditionHonor>
      <extraditionMoodPenalty>true</extraditionMoodPenalty>
    </root>
  </QuestScriptDef>

  <!-- 脫序者本人：外觀與裝備同艦隊船員；成年背景從下面六則變體隨機一則，每則都是智識 +18。
       任務節點以 onlyUseForcedBackstories 生成，原版 25% 的固定傳記（solid bio）不會蓋掉背景；這個旗標同時關掉洗牌，
       所以童年把船員的童年池（FleetChild 類別的四則）逐一列出。原版 20 歲以下不給成年背景，所以年齡下限 25。
       The deviant: a fleet crew member whose adulthood is one of the six variants below, each with +18 Intellectual.
       The quest node generates with onlyUseForcedBackstories so vanilla's 25% solid bio roll cannot replace them; the
       flag also turns off shuffling, so the childhood lists the crew's own pool (the four FleetChild ones). Vanilla gives
       no adulthood below 20, hence the minimum age. -->
  <PawnKindDef ParentName="DMS_CrewMemberBase">
    <defName>DMS_Deviant</defName>
    <label>deviant</label>
    <minGenerationAge>25</minGenerationAge>
    <maxGenerationAge>45</maxGenerationAge>
    <fixedChildBackstories>
      <li>DMS_CivilianChild01</li>
      <li>DMS_OfficerChild01</li>
      <li>DMS_OfficerChild03</li>
      <li>DMS_MilitaryChild01</li>
    </fixedChildBackstories>
    <fixedAdultBackstories>
      <li>DMS_DeviantAdult01</li>
      <li>DMS_DeviantAdult02</li>
      <li>DMS_DeviantAdult03</li>
      <li>DMS_DeviantAdult04</li>
      <li>DMS_DeviantAdult05</li>
      <li>DMS_DeviantAdult06</li>
    </fixedAdultBackstories>
  </PawnKindDef>

  <!-- 六則成年變體：各自因艦隊的規定或上級的漠視而違紀脫離。不洗牌，只給 DMS_Deviant。
       都是智識 +18，副技能各不相同。射擊／近戰被 PawnKind 鎖在 4~8，背景加成會被蓋掉，所以不加這兩項。
       Six adulthood variants, each breaking with the fleet over its rules or its indifference. Not shuffleable.
       All give +18 Intellectual with their own secondary skills; none touches Shooting or Melee, which the
       PawnKind pins to 4~8 and would override. -->
  <BackstoryDef>
    <defName>DMS_DeviantAdult01</defName>
    <title>Think Tank Analyst</title>
    <titleShort>Analyst</titleShort>
    <description>[PAWN_nameDef] was one of the senior analysts at the fleet's intelligence think tank. After confirming vital intelligence that could have prevented a war and getting nowhere reporting it to command, [PAWN_pronoun] gravely broke regulations and took the files to try to stop the war in person. The war still claimed many lives.</description>
    <slot>Adulthood</slot>
    <shuffleable>false</shuffleable>
    <skillGains>
      <Intellectual>18</Intellectual>
      <Social>5</Social>
      <Plants>-2</Plants>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <BackstoryDef>
    <defName>DMS_DeviantAdult02</defName>
    <title>Signals Interpreter</title>
    <titleShort>Interpreter</titleShort>
    <description>[PAWN_nameDef] translated intercepted, encrypted local communications for fleet intelligence. The two warring factions had in fact drafted the same ceasefire terms, but fleet command would not let the locals realize their encryption was useless against the fleet, so the fighting went on until neither side could fight any longer. After that, [PAWN_nameDef] made up [PAWN_possessive] mind.</description>
    <slot>Adulthood</slot>
    <shuffleable>false</shuffleable>
    <skillGains>
      <Intellectual>18</Intellectual>
      <Artistic>3</Artistic>
      <Social>2</Social>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <BackstoryDef>
    <defName>DMS_DeviantAdult03</defName>
    <title>Fleet Epidemic Officer</title>
    <titleShort>Epidemic Officer</titleShort>
    <description>[PAWN_nameDef] tracked outbreaks for the fleet's medical department. After a fever spread between two factions and left the dead strewn everywhere, and with [PAWN_possessive] superiors unmoved, [PAWN_nameDef] defected to the surface with the files, hoping to heal the people of the rim with restricted medical technology from the sealed archives.</description>
    <slot>Adulthood</slot>
    <shuffleable>false</shuffleable>
    <skillGains>
      <Intellectual>18</Intellectual>
      <Medicine>6</Medicine>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <BackstoryDef>
    <defName>DMS_DeviantAdult04</defName>
    <title>Orbital Survey Analyst</title>
    <titleShort>Analyst</titleShort>
    <description>[PAWN_nameDef] interpreted weather survey data on colonial worlds for the fleet. After foreseeing a megadrought a full season ahead, [PAWN_nameDef] took the archive, survey data included, broke the accords to land on the colony world without leave, and tried to trade the intelligence for the locals' support.</description>
    <slot>Adulthood</slot>
    <shuffleable>false</shuffleable>
    <skillGains>
      <Intellectual>18</Intellectual>
      <Plants>4</Plants>
      <Mining>2</Mining>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <BackstoryDef>
    <defName>DMS_DeviantAdult05</defName>
    <title>SAGE Maintenance Technician</title>
    <titleShort>Maintenance Chief</titleShort>
    <description>[PAWN_nameDef] was one of the maintenance team leads for the SAGE system. After watching a border clash predicted by the node in [PAWN_possessive] charge grow into all-out war, [PAWN_nameDef] vanished with the node's archive during a routine ground inspection.</description>
    <slot>Adulthood</slot>
    <shuffleable>false</shuffleable>
    <skillGains>
      <Intellectual>18</Intellectual>
      <Crafting>4</Crafting>
      <Construction>3</Construction>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <BackstoryDef>
    <defName>DMS_DeviantAdult06</defName>
    <title>Refugee Protector</title>
    <titleShort>Protector</titleShort>
    <description>[PAWN_nameDef] was once a promising young officer in the colonial fleet. While carrying out [PAWN_possessive] missions, [PAWN_nameDef] took in many local refugees and orphans, but on finding that [PAWN_possessive] supplies could not feed them all, [PAWN_pronoun] turned to forbidden biotechnology for personal reasons.</description>
    <slot>Adulthood</slot>
    <shuffleable>false</shuffleable>
    <skillGains>
      <Intellectual>18</Intellectual>
      <Cooking>4</Cooking>
      <Social>2</Social>
    </skillGains>
    <bodyTypeMale>Male</bodyTypeMale>
    <bodyTypeFemale>Female</bodyTypeFemale>
  </BackstoryDef>

  <!-- 引渡要求的選擇信件（DMS.ChoiceLetter_DeviantExtradition）。The extradition demand's choice letter. -->
  <LetterDef ParentName="CustomChoiceLetterBase">
    <defName>DMS_DeviantExtradition</defName>
    <letterClass>DMS.ChoiceLetter_DeviantExtradition</letterClass>
  </LetterDef>

  <!-- 由 BaseStoryteller 的 StorytellerCompProperties_RefiringUniqueQuest 觸發，不進隨機事件池。
       Fired by the RefiringUniqueQuest comp patched into BaseStoryteller; baseChance 0 keeps it out of the random pool. -->
  <IncidentDef ParentName="GiveQuestBase">
    <defName>DMS_GiveQuest_DeviantRefuge</defName>
    <label>deviant refuge</label>
    <questScriptDef>DMS_DeviantRefuge</questScriptDef>
    <baseChance>0</baseChance>
  </IncidentDef>

  <!-- 脫序者追殺（Fortified.HuntdownDef）。由 QuestPart_DeviantHandover 啟動並綁定脫序者；
       脫序者死亡、離開派系、被綁架或在軍事法庭受審結案時結束。SAGE 節點的真空期同樣適用（ModExtension_FleetTracking）。
       Started by QuestPart_DeviantHandover and bound to the deviant; ends when they die, leave, are kidnapped, or stand
       trial. SAGE blackouts apply too (ModExtension_FleetTracking). -->
  <Fortified.HuntdownDef>
    <defName>DMS_DeviantHunt</defName>
    <label>deviant pursuit</label>
    <workerClass>DMS.HuntdownWorker_Deviant</workerClass>
    <faction>DMS_Army</faction>
    <followGravship>true</followGravship>
    <retargetPlayerHome>true</retargetPlayerHome>
    <repeatWhileStaying>true</repeatWhileStaying>
    <stopWhenBoundPawnLost>true</stopWhenBoundPawnLost>
    <!-- 預警延遲 0：FFF 的倒數警報只在預警之後顯示，延遲 0 讓警報從交付當下（以及每一輪重新排程起）就一直在右側倒數。
         不發預警信件：交付信件已說明追殺，每一輪再發一封只是噪音。
         襲擊間隔與追殺令共用同一條研究線：微電子基礎完成前 28~32 天，完成後 5~7 天。
         Warning delay 0: FFF only shows the countdown alert once warned, so this keeps it on screen from the handover
         (and from every reschedule). No warning letter: the handover letter already announces the hunt.
         The interval follows the same research line as the kill order: 28~32 days until MicroelectronicsBasics is
         finished, 5~7 afterwards. -->
    <warningDelayRange>0~0</warningDelayRange>
    <sendWarningLetter>false</sendWarningLetter>
    <raidDelayRange>1680000~1920000</raidDelayRange>
    <criticalAlertLeadTicks>60000</criticalAlertLeadTicks>
    <waves>
      <li>
        <pointsMultiplier>1.0</pointsMultiplier>
        <minPoints>300</minPoints>
      </li>
    </waves>
    <questsOnWave>
      <!-- 脫序者受庇護期間的軍事法庭只審脫序者（QuestNode_Root_CourtMartial），結案即結束追殺。
           While the deviant is sheltered the court-martial only tries the deviant; closing the case ends the hunt. -->
      <li>
        <quest>DMS_CourtMartial</quest>
      </li>
      <li>
        <quest>DMS_FleetNetworkSite</quest>
        <chance>0.35</chance>
      </li>
    </questsOnWave>
    <alertLabel>Deviant hunt</alertLabel>
    <alertLabelCritical>Hunters arriving any moment</alertLabelCritical>
    <alertExplanation>{0} is hunting the deviant the colony took in. The hunting party arrives when the countdown ends.\n\nThe hunt continues for as long as the deviant stays with the colony.</alertExplanation>
    <alertExplanationCritical>The hunting party from {0} could arrive at any moment. Prepare for battle.</alertExplanationCritical>
    <modExtensions>
      <li Class="DMS.ModExtension_FleetTracking" />
      <!-- 與追殺令同一條研究線：微電子基礎完成前 28~32 天，完成後 5~7 天（DMS.HuntIntervalUtility）。
           Same research line as the kill order: 28~32 days until MicroelectronicsBasics is finished, 5~7 afterwards. -->
      <li Class="DMS.ModExtension_HuntIntervalByResearch">
        <research>MicroelectronicsBasics</research>
        <intervalBefore>1680000~1920000</intervalBefore>
        <intervalAfter>300000~420000</intervalAfter>
      </li>
    </modExtensions>
  </Fortified.HuntdownDef>

</Defs>
