<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <BodyPartGroupDef>
    <defName>AMOFirstTentacle</defName>
    <label>tentacle</label>
    <listOrder>80</listOrder>
  </BodyPartGroupDef>

  <BodyPartGroupDef>
    <defName>AMOSecondTentacle</defName>
    <label>tentacle</label>
    <listOrder>80</listOrder>
  </BodyPartGroupDef>

  <BodyPartGroupDef>
    <defName>AMOThirdTentacle</defName>
    <label>tentacle</label>
    <listOrder>80</listOrder>
  </BodyPartGroupDef>

  <BodyPartGroupDef>
    <defName>AMOFourthTentacle</defName>
    <label>tentacle</label>
    <listOrder>80</listOrder>
  </BodyPartGroupDef>

  <BodyPartDef>
    <defName>DMS_Tentacle</defName>
    <label>tentacle</label>
    <hitPoints>30</hitPoints>
    <tags>
      <li>ManipulationLimbCore</li>
    </tags>
    <frostbiteVulnerability>1</frostbiteVulnerability>
    <pawnGeneratorCanAmputate>false</pawnGeneratorCanAmputate>
  </BodyPartDef>

  <BodyDef>
    <defName>DMS_AMOBeast</defName>
    <label>Beast</label>
    <corePart>
      <def>Torso</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Spine</def>
          <coverage>0.01</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Heart</def>
          <coverage>0.005</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>left lung</customLabel>
          <coverage>0.003</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>right lung</customLabel>
          <coverage>0.003</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Kidney</def>
          <customLabel>left kidney</customLabel>
          <coverage>0.002</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Kidney</def>
          <customLabel>right kidney</customLabel>
          <coverage>0.002</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Liver</def>
          <coverage>0.01</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>DMS_Bioreactor</def>
          <coverage>0.02</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>DMS_ArmourPlate</def>
          <coverage>0.3</coverage>
          <height>Top</height>
        </li>
        
        <li>
          <def>Head</def>
          <coverage>0.08</coverage>
          <groups>
            <li>UpperHead</li>
            <li>FullHead</li>
            <li>HeadAttackTool</li>
          </groups>
          <parts>
            <li>
              <def>Brain</def>
              <coverage>0.1</coverage>
              <groups>
                <li>UpperHead</li>
                <li>Eyes</li>
                <li>FullHead</li>
              </groups>
            </li>
            <li>
              <def>Eye</def>
              <customLabel>left eye</customLabel>
              <coverage>0.07</coverage>
              <groups>
                <li>FullHead</li>
                <li>Eyes</li>
              </groups>
            </li>
            <li>
              <def>Eye</def>
              <customLabel>first right eye</customLabel>
              <coverage>0.03</coverage>
              <groups>
                <li>FullHead</li>
                <li>Eyes</li>
              </groups>
            </li>
            <li>
              <def>Eye</def>
              <customLabel>second right eye</customLabel>
              <coverage>0.03</coverage>
              <groups>
                <li>FullHead</li>
                <li>Eyes</li>
              </groups>
            </li>
            <li>
              <def>Eye</def>
              <customLabel>third right eye</customLabel>
              <coverage>0.03</coverage>
              <groups>
                <li>FullHead</li>
                <li>Eyes</li>
              </groups>
            </li>
            <li>
              <def>Jaw</def>
              <coverage>0.15</coverage>
              <groups>
                <li>Teeth</li>
                <li>FullHead</li>
                <li>Mouth</li>
              </groups>
              <parts>
                <li>
                  <def>Tongue</def>
                  <coverage>0.001</coverage>
                  <depth>Inside</depth>
                  <groups>
                    <li>FullHead</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>

        <li>
          <def>DMS_Tentacle</def>
          <customLabel>right tentacle</customLabel>
          <coverage>0.04</coverage>
          <groups>
            <li>Shoulders</li>
            <li>Arms</li>
            <li>AMOFirstTentacle</li>
          </groups>
        </li>
        <li>
          <def>DMS_Tentacle</def>
          <customLabel>second right tentacle</customLabel>
          <coverage>0.04</coverage>
          <groups>
            <li>Shoulders</li>
            <li>Arms</li>
            <li>AMOSecondTentacle</li>
          </groups>
        </li>
        <li>
          <def>DMS_Tentacle</def>
          <customLabel>left tentacle</customLabel>
          <coverage>0.04</coverage>
          <groups>
            <li>Shoulders</li>
            <li>Arms</li>
            <li>AMOThirdTentacle</li>
          </groups>
        </li>
        <li>
          <def>DMS_Tentacle</def>
          <customLabel>second left tentacle</customLabel>
          <coverage>0.04</coverage>
          <groups>
            <li>Shoulders</li>
            <li>Arms</li>
            <li>AMOFourthTentacle</li>
          </groups>
        </li>


        <!-- ===== for mech possible apparel ===== -->
        <li>
          <def>Waist</def>
          <coverage>0</coverage>
          <height>Bottom</height>
          <groups>
            <li>Waist</li>
          </groups>
        </li>
        <li>
          <def>DMS_SynthicLeg</def>
          <customLabel>left leg</customLabel>
          <coverage>0.15</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
          <woundAnchorTag>LeftLeg</woundAnchorTag>
          <flipGraphic>true</flipGraphic>
          <parts>
            <li>
              <def>Femur</def>
              <customLabel>left femur</customLabel>
              <coverage>0.1</coverage>
              <depth>Inside</depth>
              <groups>
                <li>Legs</li>
              </groups>
            </li>
            <li>
              <def>Tibia</def>
              <customLabel>left tibia</customLabel>
              <coverage>0.1</coverage>
              <depth>Inside</depth>
              <groups>
                <li>Legs</li>
              </groups>
            </li>
            <li>
              <def>DMS_SynthicFoot</def>
              <customLabel>left foot</customLabel>
              <coverage>0.1</coverage>
              <flipGraphic>true</flipGraphic>
              <groups>
                <li>Feet</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>DMS_SynthicLeg</def>
          <customLabel>right leg</customLabel>
          <coverage>0.15</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
          <woundAnchorTag>RightLeg</woundAnchorTag>
          <parts>
            <li>
              <def>Femur</def>
              <customLabel>right femur</customLabel>
              <coverage>0.1</coverage>
              <depth>Inside</depth>
              <groups>
                <li>Legs</li>
              </groups>
            </li>
            <li>
              <def>Tibia</def>
              <customLabel>right tibia</customLabel>
              <coverage>0.1</coverage>
              <depth>Inside</depth>
              <groups>
                <li>Legs</li>
              </groups>
            </li>
            <li>
              <def>DMS_SynthicFoot</def>
              <customLabel>right foot</customLabel>
              <coverage>0.1</coverage>
              <groups>
                <li>Feet</li>
              </groups>
            </li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>

</Defs>
