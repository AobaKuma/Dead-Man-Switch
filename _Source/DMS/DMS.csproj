<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <OutputPath>$(MSBuildThisFileDirectory)/../../1.6/Assemblies</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>10.0</LangVersion>
    <BaseOutputPath></BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4565-beta" />
    <!-- ExcludeAssets=runtime：只取編譯期的 0Harmony 參考，不要把 0Harmony.dll 複製到
         1.6/Assemblies/。Harmony 由 brrainz.harmony 提供（About.xml 已列為硬相依），
         模組自己再夾帶一份會與它衝突。 -->
    <PackageReference Include="Lib.Harmony" Version="2.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <Publicize Include="Assembly-CSharp:RimWorld.CompTargetable.selectedTarget" />
    <Publicize Include="Assembly-CSharp:RimWorld.LordToil_Siege.SetAsDefender" />
    <Publicize Include="Assembly-CSharp:RimWorld.QuestPartActivable.Complete" />
    <Publicize Include="Assembly-CSharp:RimWorld.QuestPart_LendColonistsToFaction.Complete" />
    <!-- Patch_Recipe_ImplantEmbryo_ApplyOnPawn 需要沿用原版的手術失敗判定。 -->
    <Publicize Include="Assembly-CSharp:RimWorld.Recipe_Surgery.CheckSurgeryFail" />
    <!-- OccultechSanctionUtility.RenounceAll 需要把單一研究的進度歸零；
         原生只提供 ResetAllProgress()，沒有 per-project 的清除方法。 -->
    <Publicize Include="Assembly-CSharp:RimWorld.ResearchManager.progress" />
    <Publicize Include="Assembly-CSharp:RimWorld.ResearchManager.anomalyKnowledge" />
    <!-- CompServerHackable：多階段駭入要在階段之間重置原版 CompHackable 的私有狀態，並讀 lastHackTick 判定「新的一次駭入」。
         CompServerHackable resets vanilla CompHackable's private state between stages and reads lastHackTick
         to detect each new hacking session. -->
    <Publicize Include="Assembly-CSharp:RimWorld.CompHackable.progress" />
    <Publicize Include="Assembly-CSharp:RimWorld.CompHackable.hacked" />
    <Publicize Include="Assembly-CSharp:RimWorld.CompHackable.lastHackTick" />
    <Publicize Include="Assembly-CSharp:RimWorld.CompHackable.lastUser" />
    <Publicize Include="Assembly-CSharp:RimWorld.CompHackable.progressLastLockout" />
    <Publicize Include="Assembly-CSharp:RimWorld.CompHackable.sentLetter" />

  </ItemGroup>
  <ItemGroup>
    <!-- QuestNode_Root_DMS_RandomFactionTimedSite 繼承 FFF 的站點節點。
         About.xml 已將 AOBA.Framework 列為硬相依，所以這個組件參考不會新增額外的相依關係。
         Required by QuestNode_Root_DMS_RandomFactionTimedSite. AOBA.Framework is
         already a hard modDependency, so this adds no new requirement. -->
    <Reference Include="Fortified">
      <HintPath>..\..\..\_Fortified-Framework\1.6\Assemblies\Fortified.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\..\_Fortified-Framework\_Sources\Reference\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\..\_Fortified-Framework\_Sources\Reference\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\_Fortified-Framework\_Sources\Reference\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\..\_Fortified-Framework\_Sources\Reference\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\..\_Fortified-Framework\_Sources\Reference\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\..\_Fortified-Framework\_Sources\Reference\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Core">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Data">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Drawing">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.IO.Compression.FileSystem">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Numerics">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Runtime.Serialization">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Xml">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Update="System.Xml.Linq">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>